-- matrix - digital rain screensaver (any key to quit)
local w, h = term.size()
term.raw(true)
term.cursor(false)
term.clear()
local drops = {}
for x = 1, w do drops[x] = math.random(-h, 0) end
local chars = "abcdefghijklmnopqrstuvwxyz0123456789@#$%&*+=<>"
while term.getkey() == nil do
  for x = 1, w, 2 do
    local y = drops[x]
    if y >= 1 and y <= h then
      local c = math.random(#chars)
      term.put(x, y, chars:sub(c, c), 15)
    end
    if y - 1 >= 1 and y - 1 <= h then
      local c2 = math.random(#chars)
      term.put(x, y - 1, chars:sub(c2, c2), 10)
    end
    if y - 6 >= 1 and y - 6 <= h then term.put(x, y - 6, chars:sub(x % #chars + 1, x % #chars + 1), 2) end
    if y - 12 >= 1 then term.put(x, y - 12, " ", 0) end
    drops[x] = y + 1
    if y - 12 > h then drops[x] = math.random(-8, 0) end
  end
  sleep(0.05)
end
term.raw(false)
term.cursor(true)
term.color(7, 0)
term.clear()
