-- bench - measure Whisker VM speed
local t0 = os.millis()
local s = 0
for i = 1, 200000 do s = s + i % 7 end
local t1 = os.millis()
local function fib(n) if n < 2 then return n end return fib(n - 1) + fib(n - 2) end
local f = fib(18)
local t2 = os.millis()
local t = {}
for i = 1, 5000 do t[i] = i * 2 end
local sum = 0
for _, v in ipairs(t) do sum = sum + v end
local t3 = os.millis()
print(string.format("loop 200k iterations : %5d ms  (%.0f k iter/s)", t1 - t0, 200000 / math.max(1, t1 - t0)))
print(string.format("fib(18) = %d        : %5d ms", f, t2 - t1))
print(string.format("table 5k fill+sum    : %5d ms", t3 - t2))
