-- wc - count lines, words and characters.  usage: wc [-l] [-w] [-c] [file...]
local fl, fw, fc = false, false, false
local files = {}
for i = 1, #arg do
  local a = arg[i]
  if a == "-l" then fl = true elseif a == "-w" then fw = true elseif a == "-c" then fc = true
  else files[#files + 1] = a end
end
if not (fl or fw or fc) then fl, fw, fc = true, true, true end
local function counts(text)
  local lines = 0
  for i = 1, #text do if text:sub(i, i) == "\n" then lines = lines + 1 end end
  return lines, #string.split(text, " "), #text
end
local function show(l, w, c, name)
  local out = ""
  if fl then out = out .. string.format("%7d", l) end
  if fw then out = out .. string.format("%7d", w) end
  if fc then out = out .. string.format("%7d", c) end
  if name then out = out .. " " .. name end
  print(out)
end
if #files == 0 then
  local l, w, c = counts(io.readall())
  show(l, w, c, nil)
else
  local tl, tw, tc = 0, 0, 0
  for _, f in ipairs(files) do
    local data, err = fs.read(f)
    if data == nil then io.error("wc: " .. f .. ": " .. err .. "\n")
    else
      local l, w, c = counts(data)
      tl = tl + l tw = tw + w tc = tc + c
      show(l, w, c, f)
    end
  end
  if #files > 1 then show(tl, tw, tc, "total") end
end
