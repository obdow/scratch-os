-- about - information about ScratchOS
--@caps gui
local win = gui.window("About ScratchOS", 320, 176)
local function draw()
  gfx.clear(win, 7)
  gfx.fill(win, 0, 0, 320, 34, 1)
  gfx.text(win, 12, 9, "ScratchOS " .. sys.version():sub(11), 15)
  gfx.text(win, 220, 9, "♦ ♣ ♥ ♠", 14)
  local lines = {
    "An operating system built in Scratch.",
    "",
    "Every pixel is drawn with the pen; text is",
    "stamped from the IBM VGA 8x16 font (CP437).",
    "Programs are written in Whisker and run on",
    "a preemptive bytecode virtual machine.",
  }
  for i, l in ipairs(lines) do gfx.text(win, 8, 34 + i * 16, l, 0) end
  local m = sys.mem()
  gfx.text(win, 8, 146, string.format("uptime %ds  procs %d  files %d", math.floor(sys.uptime()), m.procs, m.files), 1)
end
draw()
while true do
  local e = gui.waitevent(win)
  if e.type == "close" or e.type == "key" or e.type == "mousedown" then break end
end
gui.close(win)
