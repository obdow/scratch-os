-- textedit - TextEdit, the text editor
--@caps gui files
-- usage: textedit [file]
-- Toolbar: New, Open, Save, Find, Wrap (word wrap on / off), A- / A+ (text
-- size).  Click to place the cursor, drag or Shift+arrows to select,
-- double-click selects a word, the wheel scrolls.
-- keys: Ctrl+N new, Ctrl+O open, Ctrl+S save, Ctrl+F find (Enter: next),
--       Ctrl+Z undo, Ctrl+Y redo, Ctrl+A select all, Ctrl+X / C / V
--       (the clipboard is shared with the Whisker IDE), Ctrl+Home / End
local W, H = 780, 520
local win = gui.window("TextEdit", W, H)
W, H = gui.size(win)
gui.track(win, true)

local HOME = os.getenv("HOME") or "/home/user"
local C = {}
local function colours()
  C = {
    page = gui.color("window"), bar = gui.color("sidebar"), text = gui.color("text"),
    dim = gui.color("dim"), accent = gui.color("accent"), ontext = gui.color("ontext"),
    sel = gui.color("selection"), border = gui.color("border"), button = gui.color("button"),
    hover = gui.color("hover"), red = gui.color("error"),
  }
end
colours()

local TOP, BOT, FINDH, SBW = 40, 24, 30, 10
local MARGIN = 28

-- the document
local lines = {""}
local path = nil              -- nil: not saved yet
local dirty = false
local cy, cx = 1, 0           -- cursor: line, characters before it
local ay, ax = nil, nil       -- selection anchor (nil: no selection)
local want = nil              -- column kept by up / down
local scroll = 1              -- first visible row (rows count wrapped lines)
local hx = 0                  -- horizontal scroll (no wrap)
local wrap = true
local sc = 1                  -- text size: 1 or 2
local seg = {}                -- seg[i]: start offsets of line i's rows
local status = ""
local undo, redo = {}, {}
local last_kind = ""          -- kind of the last edit, to group typing
local hover = nil
local bx = {}                 -- toolbar buttons: {x, w, label}
local mouse_sel = false
local lastclick, lastpos = 0, nil
-- find bar
local finding = false
local query = ""
-- overlays: the file panel and the save-changes question
local panel = nil             -- {mode = "open" / "save", dir, items, sel, top, name}
local ask = nil               -- {then = action}

local function CW() return 8 * sc end
local function LH() return 18 * sc end
local function text_x() return MARGIN end
local function text_bottom()
  local b = H - BOT
  if finding then b = b - FINDH end
  return b
end
local function cols() return math.max(8, (W - 2 * MARGIN - SBW) // CW()) end
local function nrows() return math.max(1, (text_bottom() - TOP - 10) // LH()) end

-- --- wrapping -------------------------------------------------------------------------

-- where line i's rows start (word wrap at spaces)
local function segs(i)
  local s = seg[i]
  if s then return s end
  local line = lines[i]
  s = {0}
  local n = cols()
  if wrap and #line > n then
    local start = 0
    while #line - start > n do
      local brk = 0
      for k = start + n, start + 1, -1 do
        if brk == 0 and line:sub(k, k) == " " then brk = k end
      end
      if brk == 0 then brk = start + n end
      s[#s + 1] = brk
      start = brk
    end
  end
  seg[i] = s
  return s
end

local function rewrap() seg = {} end

-- the row (1-based within the line) that column x of line i is on
local function row_in_line(i, x)
  local s = segs(i)
  local k = 1
  for j = 2, #s do
    if x >= s[j] then k = j end
  end
  return k
end

-- global row number of (line, row in line)
local function row_index(i, k)
  local r = 0
  for j = 1, i - 1 do r = r + #segs(j) end
  return r + k
end

local function total_rows() return row_index(#lines + 1, 0) end

-- (line, row in line) of global row r
local function locate(r)
  local acc = 0
  for i = 1, #lines do
    local n = #segs(i)
    if r <= acc + n then return i, r - acc end
    acc = acc + n
  end
  return #lines, #segs(#lines)
end

-- the text range [a, b) of row k of line i
local function row_range(i, k)
  local s = segs(i)
  local a = s[k]
  local b = s[k + 1] or #lines[i]
  return a, b
end

-- --- selection ------------------------------------------------------------------------

local function has_sel() return ay ~= nil and (ay ~= cy or ax ~= cx) end

local function sel_range()
  if ay < cy or (ay == cy and ax < cx) then return ay, ax, cy, cx end
  return cy, cx, ay, ax
end

local function sel_text()
  local y1, x1, y2, x2 = sel_range()
  if y1 == y2 then return lines[y1]:sub(x1 + 1, x2) end
  local out = {lines[y1]:sub(x1 + 1, #lines[y1])}
  for i = y1 + 1, y2 - 1 do out[#out + 1] = lines[i] end
  out[#out + 1] = lines[y2]:sub(1, x2)
  return table.concat(out, "\n")
end

-- --- editing ---------------------------------------------------------------------------

local function snapshot()
  local copy = {}
  for i, l in ipairs(lines) do copy[i] = l end
  return {lines = copy, cy = cy, cx = cx}
end

local function restore(s)
  lines = s.lines
  cy, cx = s.cy, s.cx
  ay = nil
  rewrap()
end

-- remember the document before an edit; typing in a row groups into one undo
local function before_edit(kind)
  if kind ~= last_kind or kind ~= "type" then
    undo[#undo + 1] = snapshot()
    if #undo > 60 then table.remove(undo, 1) end
    redo = {}
  end
  last_kind = kind
  dirty = true
end

local function changed(i)
  seg[i] = nil
end

local function delete_sel()
  local y1, x1, y2, x2 = sel_range()
  lines[y1] = lines[y1]:sub(1, x1) .. lines[y2]:sub(x2 + 1, #lines[y2])
  for i = y2, y1 + 1, -1 do table.remove(lines, i) end
  if y2 > y1 then rewrap() else changed(y1) end
  cy, cx = y1, x1
  ay = nil
end

local function insert(text)
  if has_sel() then delete_sel() end
  ay = nil
  local parts = string.split(text, "\n")
  local line = lines[cy]
  local head, tail = line:sub(1, cx), line:sub(cx + 1, #line)
  if #parts == 1 then
    lines[cy] = head .. text .. tail
    cx = cx + #text
    changed(cy)
  else
    lines[cy] = head .. parts[1]
    for k = 2, #parts do table.insert(lines, cy + k - 1, parts[k]) end
    cy = cy + #parts - 1
    cx = #lines[cy]
    lines[cy] = lines[cy] .. tail
    rewrap()
  end
end

local function backspace()
  if has_sel() then delete_sel() return end
  ay = nil
  if cx > 0 then
    local l = lines[cy]
    lines[cy] = l:sub(1, cx - 1) .. l:sub(cx + 1, #l)
    cx = cx - 1
    changed(cy)
  elseif cy > 1 then
    cx = #lines[cy - 1]
    lines[cy - 1] = lines[cy - 1] .. lines[cy]
    table.remove(lines, cy)
    cy = cy - 1
    rewrap()
  end
end

local function delete_fwd()
  if has_sel() then delete_sel() return end
  ay = nil
  local l = lines[cy]
  if cx < #l then
    lines[cy] = l:sub(1, cx) .. l:sub(cx + 2, #l)
    changed(cy)
  elseif cy < #lines then
    lines[cy] = l .. lines[cy + 1]
    table.remove(lines, cy + 1)
    rewrap()
  end
end

-- --- the cursor -------------------------------------------------------------------------

local function is_word(ch) return ch ~= "" and (ch:lower() ~= ch:upper() or (ch >= "0" and ch <= "9") or ch == "_") end

local function move(dy, dx, shift)
  if shift then
    if ay == nil then ay, ax = cy, cx end
  else
    if has_sel() and dy == 0 and dx ~= 0 then
      -- an arrow collapses the selection to its side
      local y1, x1, y2, x2 = sel_range()
      if dx < 0 then cy, cx = y1, x1 else cy, cx = y2, x2 end
      ay = nil
      return
    end
    ay = nil
  end
  if dx ~= 0 then
    want = nil
    cx = cx + dx
    if cx < 0 then
      if cy > 1 then cy = cy - 1 cx = #lines[cy] else cx = 0 end
    elseif cx > #lines[cy] then
      if cy < #lines then cy = cy + 1 cx = 0 else cx = #lines[cy] end
    end
  end
  if dy ~= 0 then
    -- by rows, keeping the column
    local k = row_in_line(cy, cx)
    local a = row_range(cy, k)
    if want == nil then want = cx - a end
    local r = row_index(cy, k) + dy
    if r < 1 then cy, cx = 1, 0 return end
    if r > total_rows() then cy = #lines cx = #lines[cy] return end
    local i, k2 = locate(r)
    local a2, b2 = row_range(i, k2)
    cy = i
    cx = math.min(a2 + want, b2)
    if k2 < #segs(i) and cx >= b2 then cx = b2 - 1 end
  end
end

local function ensure_visible()
  local r = row_index(cy, row_in_line(cy, cx))
  local n = nrows()
  if r < scroll then scroll = r end
  if r >= scroll + n then scroll = r - n + 1 end
  if scroll < 1 then scroll = 1 end
  if not wrap then
    if cx < hx then hx = cx end
    if cx > hx + cols() - 1 then hx = cx - cols() + 1 end
  end
end

-- document position of a point in the window
local function pos_at(x, y)
  local r = scroll + (y - TOP - 10) // LH()
  if r < 1 then return 1, 0 end
  if r > total_rows() then return #lines, #lines[#lines] end
  local i, k = locate(r)
  local a, b = row_range(i, k)
  local col = (x - text_x() + CW() // 2) // CW()
  if not wrap then col = col + hx end
  local p = math.max(a, math.min(a + col, b))
  if k < #segs(i) and p >= b then p = b - 1 end
  return i, p
end

local function select_word()
  local l = lines[cy]
  local a, b = cx, cx
  while a > 0 and is_word(l:sub(a, a)) do a = a - 1 end
  while b < #l and is_word(l:sub(b + 1, b + 1)) do b = b + 1 end
  ay, ax = cy, a
  cx = b
end

-- --- files -------------------------------------------------------------------------------

local function name_of() if path then return fs.name(path) end return "Untitled" end

local function load_text(p)
  local src, err = fs.read(p)
  if src == nil then status = "Cannot open " .. p .. ": " .. tostring(err) return false end
  src = src:replace("\r", ""):replace("\t", "    ")
  lines = string.split(src, "\n")
  if #lines == 0 then lines = {""} end
  path = fs.abs(p)
  dirty = false
  cy, cx, ay = 1, 0, nil
  scroll, hx = 1, 0
  undo, redo = {}, {}
  rewrap()
  status = ""
  return true
end

local function save_to(p)
  local ok, err = fs.write(p, table.concat(lines, "\n"))
  if not ok then status = "Cannot save: " .. tostring(err) return false end
  path = fs.abs(p)
  dirty = false
  status = "Saved " .. fs.name(path)
  return true
end

local function list_dir(dir)
  local items = {}
  if dir ~= "/" then items[1] = {name = "..", dir = true} end
  local dirs, files = {}, {}
  for _, n in ipairs(fs.list(dir) or {}) do
    local full = dir == "/" and "/" .. n or dir .. "/" .. n
    if fs.isdir(full) then dirs[#dirs + 1] = {name = n, dir = true} else files[#files + 1] = {name = n, dir = false} end
  end
  for _, d in ipairs(dirs) do items[#items + 1] = d end
  for _, f in ipairs(files) do items[#items + 1] = f end
  return items
end

local function open_panel(mode)
  local dir = HOME
  if path then dir = fs.dir(path) end
  panel = {mode = mode, dir = dir, items = list_dir(dir), sel = 1, top = 1, name = "", fresh = true}
  if mode == "save" then panel.name = path and fs.name(path) or "Untitled.txt" end
end

-- after the save-changes question: do `then`
local function run_after(action)
  if action == "new" then
    lines = {""}
    path = nil
    dirty = false
    cy, cx, ay, scroll, hx = 1, 0, nil, 1, 0
    undo, redo = {}, {}
    rewrap()
    status = ""
  elseif action == "open" then open_panel("open")
  elseif action == "quit" then return "quit" end
end

local function confirm(action)
  if dirty then ask = {after = action} return nil end
  return run_after(action)
end

local function save()
  if path then save_to(path) else open_panel("save") end
end

-- --- find --------------------------------------------------------------------------------

local function find_next()
  if query == "" then return end
  local q = query:lower()
  local y, x = cy, cx
  if has_sel() then local _, _, y2, x2 = sel_range() y, x = y2, x2 end
  for pass = 0, #lines do
    local i = (y - 1 + pass) % #lines + 1
    local from = 1
    if pass == 0 then from = x + 1 end
    local p = string.find(lines[i]:lower(), q, from)
    if p then
      ay, ax = i, p - 1
      cy, cx = i, p - 1 + #q
      status = ""
      return
    end
  end
  status = "Not found: " .. query
end

-- --- drawing -------------------------------------------------------------------------------

local function button(x, label, on)
  local w = #label * 8 + 16
  local bg = C.button
  if on then bg = C.accent elseif hover == "b" .. label then bg = C.hover end
  gfx.fill(win, x, 9, w, 22, bg)
  gfx.text(win, x + 8, 12, label, on and C.ontext or C.text)
  bx[#bx + 1] = {x = x, w = w, label = label}
  return x + w + 6
end

local function words()
  local n = 0
  local chars = 0
  for _, l in ipairs(lines) do
    chars = chars + #l
    local inw = false
    for k = 1, #l do
      local sp = l:sub(k, k) == " "
      if not sp and not inw then n = n + 1 end
      inw = not sp
    end
  end
  return n, chars + #lines - 1
end

local function draw_panel()
  local pw, ph = math.min(460, W - 40), math.min(340, H - 60)
  local px, py = (W - pw) // 2, (H - ph) // 2
  gfx.fill(win, px + 4, py + 4, pw, ph, C.border)
  gfx.fill(win, px, py, pw, ph, C.bar)
  gfx.rect(win, px, py, pw, ph, C.border)
  local title = panel.mode == "open" and "Open" or "Save As"
  gfx.text(win, px + 14, py + 10, title, C.text)
  local d = panel.dir
  if #d > (pw - 100) // 8 then d = "»" .. d:sub(#d - (pw - 100) // 8 + 2, #d) end
  gfx.text(win, px + 80, py + 10, d, C.dim)
  local ly = py + 34
  local rows = (ph - 34 - 70) // 18
  panel.rows = rows
  gfx.fill(win, px + 10, ly, pw - 20, rows * 18, C.page)
  for r = 1, rows do
    local i = panel.top + r - 1
    local it = panel.items[i]
    if it then
      local y = ly + (r - 1) * 18
      local fg = C.text
      if i == panel.sel then gfx.fill(win, px + 10, y, pw - 20, 18, C.accent) fg = C.ontext end
      gfx.text(win, px + 16, y + 1, it.dir and "■" or "≡", it.dir and gui.color("folder") or C.dim)
      gfx.text(win, px + 34, y + 1, it.name, fg)
    end
  end
  local by = py + ph - 32
  if panel.mode == "save" then
    gfx.text(win, px + 14, by - 30, "Name", C.dim)
    gfx.fill(win, px + 60, by - 33, pw - 74, 22, C.page)
    gfx.rect(win, px + 60, by - 33, pw - 74, 22, C.accent)
    if panel.fresh then gfx.fill(win, px + 66, by - 30, #panel.name * 8, 16, C.sel) end
    gfx.text(win, px + 66, by - 30, panel.name, C.text)
    if not panel.fresh then gfx.fill(win, px + 66 + #panel.name * 8, by - 30, 2, 16, C.accent) end
  end
  local ok = panel.mode == "open" and "Open" or "Save"
  gfx.fill(win, px + pw - 84, by, 72, 22, C.accent)
  gfx.text(win, px + pw - 84 + (72 - #ok * 8) // 2, by + 3, ok, C.ontext)
  gfx.fill(win, px + pw - 168, by, 76, 22, C.button)
  gfx.text(win, px + pw - 160, by + 3, "Cancel", C.text)
  panel.px, panel.py, panel.pw, panel.ph, panel.ly, panel.by = px, py, pw, ph, ly, by
end

local function draw_ask()
  local pw, ph = 420, 120
  local px, py = (W - pw) // 2, (H - ph) // 2
  gfx.fill(win, px + 4, py + 4, pw, ph, C.border)
  gfx.fill(win, px, py, pw, ph, C.bar)
  gfx.rect(win, px, py, pw, ph, C.border)
  gfx.text(win, px + 16, py + 16, "Save the changes to " .. name_of() .. "?", C.text)
  gfx.text(win, px + 16, py + 36, "If you don't, they are lost.", C.dim)
  local by = py + ph - 34
  gfx.fill(win, px + 16, by, 104, 22, C.button)
  gfx.text(win, px + 24, by + 3, "Don't Save", C.text)
  gfx.fill(win, px + pw - 176, by, 76, 22, C.button)
  gfx.text(win, px + pw - 168, by + 3, "Cancel", C.text)
  gfx.fill(win, px + pw - 92, by, 76, 22, C.accent)
  gfx.text(win, px + pw - 74, by + 3, "Save", C.ontext)
  ask.px, ask.py, ask.pw, ask.by = px, py, pw, by
end

local last_title = ""

local function draw()
  local t = name_of()
  if dirty then t = t .. " - Edited" end
  if t ~= last_title then gui.title(win, t) last_title = t end
  gfx.batch()
  gfx.clear(win, C.page)
  -- text
  local tb = text_bottom()
  local x0 = text_x()
  local cw, lh = CW(), LH()
  local y = TOP + 10
  local i, k = locate(scroll)
  local y1, x1, y2, x2 = 0, 0, 0, 0
  local sel = has_sel()
  if sel then y1, x1, y2, x2 = sel_range() end
  local n = cols()
  while y + lh <= tb and i <= #lines do
    local a, b = row_range(i, k)
    local s
    local off = 0
    if wrap then s = lines[i]:sub(a + 1, b) else off = hx s = lines[i]:sub(hx + 1, hx + n) end
    if sel and i >= y1 and i <= y2 then
      local sa = (i == y1) and x1 or 0
      local se = (i == y2) and x2 or (#lines[i] + 1)
      local lo = math.max(sa, a + off)
      local hi = math.min(se, wrap and (k == #segs(i) and #lines[i] + 1 or b) or (off + n))
      if hi > lo then gfx.fill(win, x0 + (lo - a - off) * cw, y, (hi - lo) * cw, lh, C.sel) end
    end
    gfx.text(win, x0, y + sc - 1, s, C.text, nil, sc)
    if i == cy and not sel then
      local last = k == #segs(i)
      if cx >= a and (cx < b or (last and cx <= b) or (not wrap)) then
        local cxp = x0 + (cx - a - off) * cw
        if cxp >= x0 - 1 then gfx.fill(win, cxp - 1, y, 2, lh, C.accent) end
      end
    end
    y = y + lh
    k = k + 1
    if k > #segs(i) then i = i + 1 k = 1 end
  end
  -- scroll bar
  local total = total_rows()
  local vis = nrows()
  if total > vis then
    local sh = tb - TOP
    local th = math.max(24, sh * vis // total)
    local ty = TOP + (sh - th) * (scroll - 1) // math.max(1, total - vis)
    gfx.fill(win, W - SBW + 2, ty, SBW - 4, th, C.dim)
  end
  -- toolbar
  bx = {}
  gfx.fill(win, 0, 0, W, TOP, C.bar)
  gfx.fill(win, 0, TOP - 1, W, 1, C.border)
  local x = 10
  x = button(x, "New") x = button(x, "Open") x = button(x, "Save")
  x = x + 10
  x = button(x, "Find", finding)
  x = button(x, "Wrap", wrap)
  x = x + 10
  x = button(x, "A-") x = button(x, "A+")
  -- find bar
  if finding then
    local fy = tb
    gfx.fill(win, 0, fy, W, FINDH, C.bar)
    gfx.fill(win, 0, fy, W, 1, C.border)
    gfx.text(win, 12, fy + 7, "Find", C.dim)
    local fw = math.min(320, W - 200)
    gfx.fill(win, 56, fy + 4, fw, 22, C.page)
    gfx.rect(win, 56, fy + 4, fw, 22, C.accent)
    gfx.text(win, 62, fy + 7, query, C.text)
    gfx.fill(win, 62 + #query * 8, fy + 7, 2, 16, C.accent)
    gfx.fill(win, 64 + fw, fy + 4, 56, 22, C.button)
    gfx.text(win, 72 + fw, fy + 7, "Next", C.text)
    gfx.fill(win, 126 + fw, fy + 4, 56, 22, C.button)
    gfx.text(win, 134 + fw, fy + 7, "Done", C.text)
  end
  -- status bar
  gfx.fill(win, 0, H - BOT, W, BOT, C.bar)
  gfx.fill(win, 0, H - BOT, W, 1, C.border)
  local nw, nc = words()
  local info = string.format("Ln %d, Col %d     %d words     %d characters", cy, cx + 1, nw, nc)
  if status ~= "" then info = status end
  local st = dirty and "Edited" or (path and "Saved" or "New")
  local room = (W - #st * 8 - 36) // 8
  if #info > room then info = info:sub(1, math.max(0, room - 1)) .. "»" end
  gfx.text(win, 12, H - BOT + 4, info, status:startswith("Cannot") and C.red or C.dim)
  gfx.text(win, W - #st * 8 - 12, H - BOT + 4, st, C.dim)
  if panel then draw_panel() end
  if ask then draw_ask() end
  gfx.flush()
end

-- --- input --------------------------------------------------------------------------------

local function panel_go(dir)
  panel.dir = dir
  panel.items = list_dir(dir)
  panel.sel, panel.top = 1, 1
end

local function panel_choose()
  local it = panel.items[panel.sel]
  local dir = panel.dir
  if it and it.dir then
    if it.name == ".." then panel_go(fs.dir(dir)) else panel_go(dir == "/" and "/" .. it.name or dir .. "/" .. it.name) end
    return
  end
  if panel.mode == "open" then
    if it then
      local p = dir == "/" and "/" .. it.name or dir .. "/" .. it.name
      panel = nil
      load_text(p)
    end
  else
    local name = panel.name:trim()
    if name == "" then return end
    local p = dir == "/" and "/" .. name or dir .. "/" .. name
    panel = nil
    save_to(p)
  end
end

local function panel_key(k)
  if k == "escape" then panel = nil
  elseif k == "enter" then
    if panel.mode == "save" then
      local it = panel.items[panel.sel]
      if it and it.dir and panel.picked then panel_choose() panel.picked = false else
        local name = panel.name:trim()
        if name ~= "" then
          local p = panel.dir == "/" and "/" .. name or panel.dir .. "/" .. name
          panel = nil
          save_to(p)
        end
      end
    else
      panel_choose()
    end
  elseif k == "up arrow" then panel.sel = math.max(1, panel.sel - 1) panel.picked = true
  elseif k == "down arrow" then panel.sel = math.min(#panel.items, panel.sel + 1) panel.picked = true
  elseif panel.mode == "save" then
    if k == "backspace" then
      if panel.fresh then panel.name = "" else panel.name = panel.name:sub(1, #panel.name - 1) end
      panel.fresh = false
    elseif #k == 1 and k ~= "/" then
      if panel.fresh then panel.name = "" end
      panel.fresh = false
      panel.name = panel.name .. k
    end
  end
  if panel then
    if panel.sel < panel.top then panel.top = panel.sel end
    if panel.rows and panel.sel >= panel.top + panel.rows then panel.top = panel.sel - panel.rows + 1 end
  end
end

local function panel_click(x, y)
  local p = panel
  if y >= p.by and y < p.by + 22 then
    if x >= p.px + p.pw - 84 and x < p.px + p.pw - 12 then
      if p.mode == "open" then panel_choose() else panel_key("enter") end
    elseif x >= p.px + p.pw - 168 and x < p.px + p.pw - 92 then panel = nil end
    return
  end
  if y >= p.ly and y < p.ly + p.rows * 18 and x >= p.px and x < p.px + p.pw then
    local i = p.top + (y - p.ly) // 18
    if p.items[i] then
      local now = os.millis()
      if i == p.sel and now - lastclick < 450 then panel_choose()
      else
        p.sel = i
        p.picked = true
        if p.mode == "save" and not p.items[i].dir then p.name = p.items[i].name p.fresh = true end
      end
      lastclick = now
    end
  end
end

local function ask_click(x, y)
  if y < ask.by or y >= ask.by + 22 then return nil end
  local after = ask.after
  if x >= ask.px + 16 and x < ask.px + 120 then
    ask = nil
    dirty = false
    return run_after(after)
  elseif x >= ask.px + ask.pw - 176 and x < ask.px + ask.pw - 100 then
    ask = nil
  elseif x >= ask.px + ask.pw - 92 and x < ask.px + ask.pw - 16 then
    ask = nil
    save()
    if not dirty then return run_after(after) end
  end
  return nil
end

local function toolbar(label)
  if label == "New" then return confirm("new")
  elseif label == "Open" then return confirm("open")
  elseif label == "Save" then save()
  elseif label == "Find" then finding = not finding
  elseif label == "Wrap" then wrap = not wrap hx = 0 rewrap()
  elseif label == "A-" then sc = 1 rewrap()
  elseif label == "A+" then sc = 2 rewrap() end
  return nil
end

local function key(k, mod)
  local shift = mod == "shift"
  if k == "^s" then save() return end
  if k == "^o" then return confirm("open") end
  if k == "^n" then return confirm("new") end
  if k == "^f" then finding = true return end
  if k == "^z" then
    if #undo > 0 then redo[#redo + 1] = snapshot() restore(table.remove(undo)) dirty = true end
    last_kind = ""
    return
  end
  if k == "^y" then
    if #redo > 0 then undo[#undo + 1] = snapshot() restore(table.remove(redo)) dirty = true end
    last_kind = ""
    return
  end
  if k == "^a" then ay, ax = 1, 0 cy = #lines cx = #lines[cy] return end
  if k == "^c" or k == "^x" then
    if has_sel() then
      gui.clipboard(sel_text())
      if k == "^x" then before_edit("cut") delete_sel() end
    end
    return
  end
  if k == "^v" then
    local t = gui.clipboard()
    if t ~= "" then before_edit("paste") insert(t:replace("\r", ""):replace("\t", "    ")) end
    return
  end
  if finding and (#k == 1 or k == "backspace" or k == "enter" or k == "escape") then
    if k == "enter" then find_next()
    elseif k == "escape" then finding = false
    elseif k == "backspace" then query = query:sub(1, #query - 1)
    else query = query .. k end
    return
  end
  if k == "left arrow" then move(0, -1, shift)
  elseif k == "right arrow" then move(0, 1, shift)
  elseif k == "up arrow" then move(-1, 0, shift)
  elseif k == "down arrow" then move(1, 0, shift)
  elseif k == "page up" then move(-nrows(), 0, shift)
  elseif k == "page down" then move(nrows(), 0, shift)
  elseif k == "home" then
    if not shift then ay = nil elseif ay == nil then ay, ax = cy, cx end
    if mod == "ctrl" then cy, cx = 1, 0 else cx = row_range(cy, row_in_line(cy, cx)) end
    want = nil
  elseif k == "end" then
    if not shift then ay = nil elseif ay == nil then ay, ax = cy, cx end
    if mod == "ctrl" then cy = #lines cx = #lines[cy]
    else
      local kk = row_in_line(cy, cx)
      local _, b = row_range(cy, kk)
      if kk < #segs(cy) then cx = b - 1 else cx = b end
    end
    want = nil
  elseif k == "enter" then before_edit("enter") insert("\n") want = nil
  elseif k == "backspace" then before_edit("delete") backspace() want = nil
  elseif k == "delete" then before_edit("delete") delete_fwd() want = nil
  elseif k == "escape" then ay = nil
  elseif #k == 1 then
    -- a word and the space after it undo together
    before_edit("type")
    insert(k)
    if k == " " then last_kind = "" end
    want = nil
  end
end

-- --- main --------------------------------------------------------------------------------

if arg[1] then
  if fs.exists(arg[1]) then load_text(arg[1]) else path = fs.abs(arg[1]) end
end
draw()

local running = true
while running do
  local e = gui.waitevent(win)
  local redraw = true
  local t = e.type
  local result = nil
  if t == "close" then
    if dirty and ask == nil then ask = {after = "quit"} else running = false end
  elseif t == "key" then
    if ask then
      if e.key == "escape" then ask = nil end
    elseif panel then panel_key(e.key)
    else
      result = key(e.key, e.mod)
      if result ~= "quit" then ensure_visible() end
    end
  elseif t == "mousedown" then
    if ask then result = ask_click(e.x, e.y)
    elseif panel then panel_click(e.x, e.y)
    elseif e.y < TOP then
      for _, b in ipairs(bx) do
        if e.x >= b.x and e.x < b.x + b.w then result = toolbar(b.label) end
      end
    elseif finding and e.y >= text_bottom() and e.y < text_bottom() + FINDH then
      local fw = math.min(320, W - 200)
      if e.x >= 64 + fw and e.x < 120 + fw then find_next() ensure_visible()
      elseif e.x >= 126 + fw and e.x < 182 + fw then finding = false end
    elseif e.y < text_bottom() then
      if e.x >= W - SBW then
        local total = total_rows()
        scroll = math.max(1, math.min(total - nrows() + 1, math.floor((e.y - TOP) / (text_bottom() - TOP) * total)))
      else
        local i, p = pos_at(e.x, e.y)
        local now = os.millis()
        if lastpos == i * 100000 + p and now - lastclick < 450 then
          cy, cx = i, p
          select_word()
          mouse_sel = false
        else
          cy, cx = i, p
          ay, ax = i, p
          mouse_sel = true
        end
        lastclick, lastpos = now, i * 100000 + p
        want = nil
      end
    end
  elseif t == "drag" then
    if mouse_sel then
      cy, cx = pos_at(e.x, e.y)
      ensure_visible()
    else
      redraw = false
    end
  elseif t == "mouseup" then
    mouse_sel = false
    if not has_sel() then ay = nil end
  elseif t == "move" then
    local h = nil
    if e.y < TOP then
      for _, b in ipairs(bx) do
        if e.x >= b.x and e.x < b.x + b.w then h = "b" .. b.label end
      end
    end
    if h ~= hover then hover = h else redraw = false end
  elseif t == "wheel" then
    scroll = math.max(1, math.min(scroll + e.y * 3, math.max(1, total_rows() - nrows() + 1)))
  elseif t == "resize" then
    W, H = e.x, e.y
    rewrap()
    ensure_visible()
  else
    redraw = false
  end
  if result == "quit" then running = false end
  if redraw and running then draw() end
end
gui.close(win)
