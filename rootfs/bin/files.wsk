-- files - Finder, the graphical file manager
--@caps gui files
-- Sidebar: favourite places.  Click selects, double-click opens: folders are
-- entered, pictures open in Preview, pages in the Browser, programs in the
-- Whisker IDE and other files in TextEdit.  Click a selected item's name
-- again to rename it.
-- Toolbar: back / forward, then New File, New Folder, Rename, Delete, Open in
-- IDE and Run as far as they fit; the menu button (≡) has every action.
-- keys: arrows, Enter (open), Backspace (back), Delete, n (new folder),
--       f (new file), e (rename), r (run), q (quit)
local W, H = 760, 432
local win = gui.window("Finder", W, H)
W, H = gui.size(win)
gui.track(win, true)

-- system colours (they follow the light / dark appearance)
local C = {
  bg = gui.color("window"), side = gui.color("sidebar"), text = gui.color("text"),
  dim = gui.color("dim"), accent = gui.color("accent"), ontext = gui.color("ontext"),
  sel = gui.color("selection"), border = gui.color("border"), button = gui.color("button"),
  folder = gui.color("folder"), stripe = gui.color("hover"), field = gui.color("window"),
}

local home = fs.abs(os.getenv("HOME") or "/")
local PLACES = {
  {"Home", home}, {"Projects", home .. "/projects"}, {"Pictures", home .. "/Pictures"},
  {"Sites", home .. "/Sites"}, {"Examples", home .. "/examples"},
  {"Applications", "/bin"}, {"Documents", "/usr/share/doc/whisker"}, {"System", "/etc"},
  {"Temporary", "/tmp"}, {"ScratchOS HD", "/"},
}
local TOP = 36           -- toolbar height
local HEAD = 20          -- column header height
local ROW = 16
local MENU_W = 24        -- the ≡ button

-- actions: label, key; the toolbar shows the first ones that fit
local ACTIONS = {
  {"New Folder", "newfolder"}, {"New File", "newfile"}, {"Rename", "rename"},
  {"Delete", "delete"}, {"Open in IDE", "ide"}, {"Run", "run"},
}
local MENU = {
  {"Open", "open"}, {"Open in IDE", "ide"}, {"Run", "run"}, {"-", ""},
  {"New File", "newfile"}, {"New Folder", "newfolder"}, {"Rename", "rename"},
  {"Delete", "delete"}, {"-", ""}, {"Refresh", "refresh"},
}

local cwd = home
local back, fwd = {}, {}
local items = {}
local sel, top = 1, 1
local lastclick, lastsel = 0, 0
local status = ""
local tb = {}            -- toolbar buttons shown: {x, w, action}
local menu_open = false
local menu_sel = 0
local edit = nil         -- renaming: {i = item, text = new name, fresh = typing replaces}

-- layout for the current size
local L = {}
local function layout()
  L.side = 152
  if W < 480 then L.side = 0 end          -- narrow: no sidebar
  L.list_x = L.side
  L.list_w = W - L.side
  -- columns drop off as the window narrows
  L.kind_x, L.size_x = nil, nil
  local right = W - 8
  if L.list_w >= 440 then
    L.kind_x = right - 136
    right = L.kind_x - 8
  end
  if L.list_w >= 300 then
    L.size_x = right - 88
    right = L.size_x - 8
  end
  L.name_x = L.list_x + 12
  L.name_w = right - L.name_x - 18
end

local function rows() return math.max(1, (H - TOP - HEAD - ROW) // ROW) end

local function fit(s, w)
  local n = w // 8
  if n < 1 then return "" end
  if #s > n then return s:sub(1, n - 1) .. "»" end
  return s
end

local function kind(it)
  if it.dir then return "Folder" end
  if it.name:endswith(".wsk") then return "Whisker program" end
  if it.name:endswith(".txt") then return "Text document" end
  if it.name:endswith(".simg") then return "Picture" end
  if it.name:endswith(".yarn") then return "Web page" end
  if it.name:endswith(".sh") then return "Shell script" end
  return "Document"
end

local function join(dir, name)
  if dir == "/" then return "/" .. name end
  return dir .. "/" .. name
end

local function load()
  local names = fs.list(cwd) or {}
  local dirs, files = {}, {}
  for _, n in ipairs(names) do
    local full = join(cwd, n)
    local st = fs.stat(full)
    if st and st.type == "dir" then dirs[#dirs + 1] = {name = n, path = full, dir = true, size = 0}
    elseif st then files[#files + 1] = {name = n, path = full, dir = false, size = st.size} end
  end
  items = {}
  for _, d in ipairs(dirs) do items[#items + 1] = d end
  for _, f in ipairs(files) do items[#items + 1] = f end
  if sel > #items then sel = #items end
  if sel < 1 then sel = 1 end
end

local function select_name(name)
  for i, it in ipairs(items) do
    if it.name == name then sel = i end
  end
end

local function size_text(n)
  if n < 1024 then return n .. " bytes" end
  return string.format("%.1f KB", n / 1024)
end

local function icon_of(it)
  if it.dir then return "■", C.folder end
  if it.name:endswith(".wsk") then return "♦", C.accent end
  if it.name:endswith(".simg") then return "▲", C.folder end
  if it.name:endswith(".yarn") then return "@", C.accent end
  return "≡", C.dim
end

local function draw()
  layout()
  gfx.batch()
  gfx.clear(win, C.bg)
  -- sidebar
  if L.side > 0 then
    gfx.fill(win, 0, 0, L.side, H, C.side)
    gfx.fill(win, L.side - 1, 0, 1, H, C.border)
    gfx.text(win, 12, TOP + 4, "Favorites", C.dim)
    for i, pl in ipairs(PLACES) do
      local y = TOP + 8 + i * 20
      if y + 16 > H then break end
      if pl[2] == cwd then gfx.fill(win, 6, y - 2, L.side - 13, 20, C.sel) end
      gfx.text(win, 14, y, "■", C.accent)
      gfx.text(win, 32, y, fit(pl[1], L.side - 40), C.text)
    end
  end
  -- toolbar: back / forward, folder name, the buttons that fit, the menu
  local x0 = L.list_x
  gfx.fill(win, x0, 0, W - x0, TOP, C.side)
  gfx.fill(win, x0, TOP - 1, W - x0, 1, C.border)
  local bc, fc = C.dim, C.dim
  if #back > 0 or cwd ~= "/" then bc = C.text end
  if #fwd > 0 then fc = C.text end
  gfx.fill(win, x0 + 8, 9, 20, 18, C.button)
  gfx.fill(win, x0 + 30, 9, 20, 18, C.button)
  gfx.text(win, x0 + 14, 10, "◄", bc)
  gfx.text(win, x0 + 36, 10, "►", fc)
  local mx = W - 8 - MENU_W
  gfx.fill(win, mx, 9, MENU_W, 18, menu_open and C.accent or C.button)
  gfx.text(win, mx + 8, 10, "≡", menu_open and C.ontext or C.text)
  -- buttons, from the left of the menu button, while they leave room for the title
  local title = fs.name(cwd)
  if cwd == "/" then title = "ScratchOS HD" end
  local tw = math.min(#title, 16) * 8 + 16
  tb = {}
  local x = mx - 8
  local shown = {}
  for _, a in ipairs(ACTIONS) do
    local w = #a[1] * 8 + 16
    if x - w < x0 + 58 + tw then break end
    x = x - w - 6
    shown[#shown + 1] = {x = x, w = w, label = a[1], action = a[2]}
  end
  for _, b in ipairs(shown) do
    local fg = C.text
    if b.action == "run" and not (items[sel] and items[sel].name:endswith(".wsk")) then fg = C.dim end
    gfx.fill(win, b.x, 9, b.w, 18, C.button)
    gfx.text(win, b.x + 8, 10, b.label, fg)
    tb[#tb + 1] = b
  end
  local right = mx - 8
  if #shown > 0 then right = shown[#shown].x - 8 end
  gfx.text(win, x0 + 60, 10, fit(title, right - x0 - 60), C.text)
  -- column headers
  gfx.text(win, L.name_x, TOP + 2, "Name", C.dim)
  if L.size_x then gfx.text(win, L.size_x, TOP + 2, "Size", C.dim) end
  if L.kind_x then gfx.text(win, L.kind_x, TOP + 2, "Kind", C.dim) end
  gfx.fill(win, x0, TOP + HEAD - 1, W - x0, 1, C.border)
  -- rows
  local R = rows()
  for row = 1, R do
    local i = top + row - 1
    local it = items[i]
    local y = TOP + HEAD + (row - 1) * ROW
    local fg, dimc = C.text, C.dim
    if it and i == sel then
      gfx.fill(win, x0 + 4, y, W - x0 - 8, ROW, C.accent)
      fg, dimc = C.ontext, C.ontext
    elseif row % 2 == 0 then
      gfx.fill(win, x0 + 4, y, W - x0 - 8, ROW, C.stripe)
    end
    if it then
      local icon, ic = icon_of(it)
      if i == sel then ic = C.ontext end
      gfx.text(win, L.name_x, y, icon, ic)
      if edit and edit.i == i then
        -- the name being edited, in a field
        local fw = math.max(L.name_w, 80)
        gfx.fill(win, L.name_x + 15, y, fw + 6, ROW, C.field)
        gfx.rect(win, L.name_x + 15, y, fw + 6, ROW, C.accent)
        local s = edit.text
        local maxc = fw // 8
        if #s >= maxc then s = s:sub(#s - maxc + 2, #s) end
        if edit.fresh then
          gfx.fill(win, L.name_x + 18, y + 1, (#s - #edit.ext) * 8, ROW - 2, C.sel)
        end
        gfx.text(win, L.name_x + 18, y, s, C.text)
        if not edit.fresh then
          local p = edit.pos or #edit.text
          p = p - (#edit.text - #s)
          if p >= 0 then gfx.fill(win, L.name_x + 18 + p * 8, y + 1, 2, ROW - 2, C.accent) end
        end
      else
        gfx.text(win, L.name_x + 18, y, fit(it.name, L.name_w), fg)
      end
      if L.size_x then
        if it.dir then gfx.text(win, L.size_x, y, "--", dimc) else gfx.text(win, L.size_x, y, size_text(it.size), dimc) end
      end
      if L.kind_x then gfx.text(win, L.kind_x, y, kind(it), dimc) end
    end
  end
  -- status bar
  gfx.fill(win, x0, H - ROW, W - x0, ROW, C.side)
  local info = #items .. " items"
  if status ~= "" then info = status end
  gfx.text(win, x0 + 12, H - ROW, fit(info, W - x0 - 24), C.dim)
  -- the actions menu
  if menu_open then
    local w = 140
    local mx0 = math.max(0, W - 8 - w)
    local h = #MENU * 18 + 8
    gfx.fill(win, mx0, TOP - 4, w, h, C.side)
    gfx.rect(win, mx0, TOP - 4, w, h, C.border)
    for k, m in ipairs(MENU) do
      local y = TOP + (k - 1) * 18
      if m[1] == "-" then
        gfx.fill(win, mx0 + 8, y + 8, w - 16, 1, C.border)
      else
        if k == menu_sel then gfx.fill(win, mx0 + 4, y, w - 8, 18, C.accent) end
        gfx.text(win, mx0 + 12, y + 1, m[1], k == menu_sel and C.ontext or C.text)
      end
    end
  end
  gfx.flush()
end

local function ensure_visible()
  local R = rows()
  if sel < top then top = sel end
  if sel > top + R - 1 then top = sel - R + 1 end
  if top < 1 then top = 1 end
end

local function go(path, remember)
  if path == cwd then return end
  edit = nil
  if remember then back[#back + 1] = cwd fwd = {} end
  cwd = path
  sel, top = 1, 1
  status = ""
  load()
end

local function go_back()
  if #back > 0 then
    fwd[#fwd + 1] = cwd
    local p = table.remove(back)
    go(p, false)
  elseif cwd ~= "/" then
    go(fs.dir(cwd), false)
  end
end

local function go_forward()
  if #fwd > 0 then
    back[#back + 1] = cwd
    go(table.remove(fwd), false)
  end
end

local function run(it)
  if it == nil or it.dir then return end
  if not it.name:endswith(".wsk") then status = it.name .. " is not a program" return end
  gui.terminal("run " .. it.path)
  status = "Started " .. it.name
end

-- double-click / Enter: open with the app for its kind
local function open(it)
  if it == nil then return end
  if it.dir then go(it.path, true)
  elseif it.name:endswith(".simg") then
    gui.launch("preview " .. it.path)
    status = "Opened " .. it.name .. " in Preview"
  elseif it.name:endswith(".yarn") then
    gui.launch("browser " .. it.path)
    status = "Opened " .. it.name .. " in the Browser"
  elseif it.name:endswith(".wsk") then
    gui.ide(it.path)
    status = "Opened " .. it.name .. " in the Whisker IDE"
  else
    gui.launch("textedit " .. it.path)
    status = "Opened " .. it.name .. " in TextEdit"
  end
end

local function delete(it)
  if it == nil then return end
  local ok, err = fs.remove(it.path, true)
  if ok then status = "Deleted " .. it.name else status = "Error: " .. tostring(err) end
  load()
end

-- a free name: "untitled folder", "untitled folder 2", ...
local function free_name(base, ext)
  local name = base .. ext
  local n = 2
  while fs.exists(join(cwd, name)) do
    name = base .. " " .. n .. ext
    n = n + 1
  end
  return name
end

local function start_rename(i)
  if items[i] == nil then return end
  sel = i
  ensure_visible()
  -- typing replaces the name but keeps a file's extension
  local name = items[i].name
  local ext = ""
  if not items[i].dir then
    local dot = 0
    for k = #name, 2, -1 do
      if dot == 0 and name:sub(k, k) == "." then dot = k end
    end
    if dot > 0 then ext = name:sub(dot, #name) end
  end
  edit = {i = i, text = name, fresh = true, ext = ext}
  status = "Type a name, Enter to keep it, Esc to cancel"
end

local function create(folder)
  local name
  local ok, err
  if folder then
    name = free_name("untitled folder", "")
    ok, err = fs.mkdir(join(cwd, name))
  else
    name = free_name("untitled", ".txt")
    ok, err = fs.write(join(cwd, name), "")
  end
  if not ok then status = "Error: " .. tostring(err) return end
  load()
  select_name(name)
  start_rename(sel)
end

local function finish_rename()
  local it = items[edit.i]
  local name = edit.text:trim()
  edit = nil
  if it == nil or name == "" or name == it.name then status = "" return end
  if string.find(name, "/") then status = "A name cannot contain /" return end
  local dest = join(cwd, name)
  local ok, err
  if name:lower() == it.name:lower() then
    -- only the case changes (names ignore case): go through a temporary name
    local tmp = join(cwd, ".rename-" .. os.millis())
    ok, err = fs.rename(it.path, tmp)
    if ok then ok, err = fs.rename(tmp, dest) end
  elseif fs.exists(dest) then
    ok, err = false, name .. " already exists"
  else
    ok, err = fs.rename(it.path, dest)
  end
  if ok then status = "Renamed to " .. name else status = "Error: " .. tostring(err) end
  load()
  select_name(name)
  ensure_visible()
end

local function action(a)
  local it = items[sel]
  if a == "newfolder" then create(true)
  elseif a == "newfile" then create(false)
  elseif a == "rename" then start_rename(sel)
  elseif a == "delete" then delete(it)
  elseif a == "ide" then if it and not it.dir then gui.ide(it.path) end
  elseif a == "run" then run(it)
  elseif a == "open" then open(it)
  elseif a == "refresh" then load() status = "" end
end

local function edit_key(k)
  if k == "enter" then finish_rename()
  elseif k == "escape" then edit = nil status = ""
  elseif k == "backspace" then
    if edit.fresh then edit.text = edit.ext edit.pos = 0 end
    edit.fresh = false
    local p = edit.pos or #edit.text
    if p > 0 then
      edit.text = edit.text:sub(1, p - 1) .. edit.text:sub(p + 1, #edit.text)
      edit.pos = p - 1
    end
  elseif #k == 1 or k == "space" then
    if k == "space" then k = " " end
    if edit.fresh then edit.text = edit.ext edit.pos = 0 end
    edit.fresh = false
    if k ~= "/" then
      local p = edit.pos or #edit.text
      edit.text = edit.text:sub(1, p) .. k .. edit.text:sub(p + 1, #edit.text)
      edit.pos = p + 1
    end
  elseif k == "left arrow" then
    edit.fresh = false
    edit.pos = math.max(0, (edit.pos or #edit.text) - 1)
  elseif k == "right arrow" then
    edit.fresh = false
    edit.pos = math.min(#edit.text, (edit.pos or #edit.text) + 1)
  elseif k == "end" then
    edit.fresh = false
    edit.pos = #edit.text
  elseif k == "home" then
    edit.fresh = false
    edit.pos = 0
  end
end

local function menu_hit(x, y)
  local w = 140
  local mx0 = math.max(0, W - 8 - w)
  if x < mx0 or x >= mx0 + w or y < TOP then return 0 end
  local k = (y - TOP) // 18 + 1
  if MENU[k] and MENU[k][1] ~= "-" then return k end
  return 0
end

local function mousedown(x, y)
  if menu_open then
    local k = menu_hit(x, y)
    menu_open = false
    if k > 0 then action(MENU[k][2]) end
    return
  end
  if edit then
    -- a click anywhere else keeps the typed name
    finish_rename()
  end
  if x < L.side then
    local k = (y - TOP - 6) // 20
    if PLACES[k] and fs.isdir(PLACES[k][2]) then go(PLACES[k][2], true) end
  elseif y < TOP then
    local x0 = L.list_x
    if x >= x0 + 8 and x < x0 + 28 then go_back()
    elseif x >= x0 + 30 and x < x0 + 50 then go_forward()
    elseif x >= W - 8 - MENU_W and x < W - 8 then
      menu_open = true
      menu_sel = 0
    else
      for _, b in ipairs(tb) do
        if x >= b.x and x < b.x + b.w then action(b.action) end
      end
    end
  elseif y >= TOP + HEAD and y < H - ROW then
    local i = top + (y - TOP - HEAD) // ROW
    if items[i] then
      local now = os.millis()
      if i == lastsel and now - lastclick < 450 then
        open(items[i])
        lastsel = 0
      elseif i == sel and i == lastsel and x >= L.name_x + 18 and x < L.name_x + 18 + #items[i].name * 8 then
        -- a slow second click on the name renames
        start_rename(i)
        lastsel = 0
      else
        sel = i
        lastsel = i
        lastclick = now
      end
    end
  end
end

layout()
load()
draw()
local running = true
while running do
  local e = gui.waitevent(win)
  local redraw = true
  if e.type == "close" then running = false
  elseif e.type == "mousedown" then mousedown(e.x, e.y)
  elseif e.type == "move" then
    if menu_open then
      local k = menu_hit(e.x, e.y)
      if k ~= menu_sel then menu_sel = k else redraw = false end
    else
      redraw = false
    end
  elseif e.type == "wheel" then
    top = math.max(1, math.min(top + e.y * 3, math.max(1, #items - rows() + 1)))
  elseif e.type == "key" then
    local k = e.key
    if edit then edit_key(k)
    elseif menu_open then
      if k == "escape" then menu_open = false else redraw = false end
    elseif k == "up arrow" and sel > 1 then sel = sel - 1
    elseif k == "down arrow" and sel < #items then sel = sel + 1
    elseif k == "page up" then sel = math.max(1, sel - rows())
    elseif k == "page down" then sel = math.min(#items, sel + rows())
    elseif k == "enter" then open(items[sel])
    elseif k == "r" then run(items[sel])
    elseif k == "backspace" then go_back()
    elseif k == "delete" then delete(items[sel])
    elseif k == "n" then create(true)
    elseif k == "f" then create(false)
    elseif k == "e" then start_rename(sel)
    elseif k == "q" or k == "escape" then running = false
    else redraw = false end
    ensure_visible()
  elseif e.type == "resize" then
    W, H = e.x, e.y
    ensure_visible()
  else
    redraw = false
  end
  if redraw and running then draw() end
end
gui.close(win)
