-- head - first lines of input.  usage: head [-n N] [file]
local n, file = 10, nil
local i = 1
while i <= #arg do
  if arg[i] == "-n" then n = tonumber(arg[i + 1]) i = i + 2
  else file = arg[i] i = i + 1 end
end
local lines
if file then
  local data, err = fs.read(file)
  if data == nil then io.error("head: " .. file .. ": " .. err .. "\n") exit(1) end
  lines = string.lines(data)
else
  lines = {}
  while #lines < n do
    local l = io.read()
    if l == nil then break end
    lines[#lines + 1] = l
  end
end
for k = 1, math.min(n, #lines) do print(lines[k]) end
