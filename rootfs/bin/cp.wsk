-- cp - copy files and directories.  usage: cp [-r] source... dest
local rec = false
local args = {}
for i = 1, #arg do
  if arg[i] == "-r" or arg[i] == "-R" then rec = true else args[#args + 1] = arg[i] end
end
if #args < 2 then io.error("usage: cp [-r] source... dest\n") exit(1) end
local dest = args[#args]
local status = 0
for i = 1, #args - 1 do
  local src = args[i]
  if fs.isdir(src) and not rec then
    io.error("cp: " .. src .. " is a directory (use -r)\n") status = 1
  else
    local ok, err = fs.copy(src, dest)
    if not ok then io.error("\e[91mcp: " .. src .. ": " .. err .. "\e[0m\n") status = 1 end
  end
end
exit(status)
