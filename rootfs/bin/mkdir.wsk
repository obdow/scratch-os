-- mkdir - make directories.  usage: mkdir [-p] dir...
local parents = false
local status = 0
for i = 1, #arg do
  local d = arg[i]
  if d == "-p" then
    parents = true
  elseif parents then
    local path = ""
    if d:startswith("/") then path = "" end
    for _, part in ipairs(string.split(d, "/")) do
      if part ~= "" then
        if path == "" and not d:startswith("/") then path = part else path = path .. "/" .. part end
        if not fs.isdir(path) then
          local ok, err = fs.mkdir(path)
          if not ok then io.error("mkdir: " .. path .. ": " .. err .. "\n") status = 1 break end
        end
      end
    end
  else
    local ok, err = fs.mkdir(d)
    if not ok then io.error("\e[91mmkdir: " .. d .. ": " .. err .. "\e[0m\n") status = 1 end
  end
end
exit(status)
