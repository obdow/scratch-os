-- taskmgr - Activity Monitor, the graphical task manager
--@caps gui proc
local W, H = 640, 360
local win = gui.window("Activity Monitor", W, H)
W, H = gui.size(win)
local C = {
  bg = gui.color("window"), side = gui.color("sidebar"), text = gui.color("text"),
  dim = gui.color("dim"), accent = gui.color("accent"), ontext = gui.color("ontext"),
  stripe = gui.color("hover"), border = gui.color("border"), green = gui.color("green"),
  red = gui.color("red"), track = gui.color("button"),
}
local sel = 0
local procs = {}
local last = {}
local rates = {}
local lastt = os.millis()

local function sample()
  procs = proc.list()
  local now = os.millis()
  local dt = math.max(1, now - lastt) / 1000
  lastt = now
  local cur = {}
  for _, p in ipairs(procs) do
    rates[p.pid] = math.floor((p.cpu - (last[p.pid] or p.cpu)) / dt)
    cur[p.pid] = p.cpu
  end
  last = cur
end

local function bar(x, y, w, frac, colour)
  gfx.fill(win, x, y + 5, w, 6, C.track)
  gfx.fill(win, x, y + 5, math.max(1, math.floor(w * math.min(1, frac))), 6, colour)
end

local function draw()
  local m = sys.mem()
  gfx.batch()
  gfx.clear(win, C.bg)
  -- summary panel
  gfx.fill(win, 0, 0, W, 48, C.side)
  gfx.fill(win, 0, 47, W, 1, C.border)
  gfx.text(win, 12, 8, "Heap", C.dim)
  bar(60, 8, 160, m.heap / m.heap_max, C.green)
  gfx.text(win, 232, 8, string.format("%d cells", m.heap), C.text)
  gfx.text(win, 12, 26, "Code", C.dim)
  bar(60, 26, 160, m.code / m.code_max, C.accent)
  gfx.text(win, 232, 26, string.format("%d cells", m.code), C.text)
  gfx.text(win, W - 160, 8, "Processes  " .. m.procs, C.text)
  gfx.text(win, W - 160, 26, "Uptime     " .. math.floor(sys.uptime()) .. "s", C.text)
  -- process table
  gfx.text(win, 0, 56, "    PID  STATE    INSTR/S    MEM  COMMAND", C.dim)
  gfx.fill(win, 0, 73, W, 1, C.border)
  for i, p in ipairs(procs) do
    local y = 58 + i * 16
    if y > H - 48 then break end
    local fg = C.text
    if p.pid == sel then
      gfx.fill(win, 4, y, W - 8, 16, C.accent)
      fg = C.ontext
    elseif i % 2 == 0 then
      gfx.fill(win, 4, y, W - 8, 16, C.stripe)
    end
    local name = p.name
    if #name > 40 then name = name:sub(1, 40) end
    gfx.text(win, 0, y, string.format("  %5d  %-6s %9d %6d  %s", p.pid, p.state, rates[p.pid] or 0, p.mem, name), fg)
  end
  -- toolbar at the bottom
  gfx.fill(win, 0, H - 36, W, 36, C.side)
  gfx.fill(win, 0, H - 36, W, 1, C.border)
  gfx.fill(win, 12, H - 27, 96, 18, C.red)
  gfx.text(win, 24, H - 26, "End Task", C.ontext)
  gfx.text(win, 124, H - 26, "select a process, then End Task", C.dim)
  gfx.flush()
end

sample()
draw()
local running = true
local tick = os.millis()
while running do
  local e = gui.event(win)
  while e do
    if e.type == "close" then running = false
    elseif e.type == "mousedown" then
      if e.y >= H - 30 and e.x < 110 then
        if sel > 0 then
          local ok, err = proc.kill(sel)
          sel = 0
        end
      elseif e.y >= 74 then
        local i = (e.y - 58) // 16
        if procs[i] then sel = procs[i].pid end
      end
      draw()
    elseif e.type == "key" and (e.key == "q" or e.key == "escape") then running = false
    end
    e = gui.event(win)
  end
  if os.millis() - tick > 1000 then
    tick = os.millis()
    sample()
    draw()
  end
  sleep(0.1)
end
gui.close(win)
