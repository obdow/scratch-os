-- browser - the ScratchOS web browser, for Yarn pages (.yarn)
--@caps gui
-- usage: browser [page.yarn | folder | about:home]
--        browser --check page.yarn ...     report problems, open nothing
-- Toolbar: back, forward, reload, home, the address bar, Source (open the
-- page in the Whisker IDE).  Keys: arrows / space / page up / page down
-- scroll, Ctrl+L address bar, Ctrl+R reload, Esc leaves a field.
--
-- Pages come from `fetch`, which picks a handler from `schemes` by the
-- address's scheme: "about:" pages, local files, and - one day - the
-- ScratchOS network.  A new source of pages is one more handler that
-- returns the page's Yarn text (or nil and an error).
local yarn = require("yarn")

local HOME = os.getenv("HOME") or "/home/user"
local SYS = "/usr/share/yarn"            -- about: pages
local TOP, BOT, SBW = 40, 22, 10

local win = nil
local W, H = 880, 560
local CW = W - SBW                         -- page width
local C = {}

local url = nil                            -- the current address
local base = HOME                          -- folder that relative links start from
local trusted = true                       -- the page's scripts may run
local srcpath = nil                        -- file shown by Source
local doc, view = nil, nil
local scroll = 0
local hover, hover_hit = nil, nil
local focus = nil                          -- an input node, or "addr"
local addr = ""
local addr_fresh = false                  -- the address is selected: typing replaces it
local back, fwd = {}, {}
local banner, banner_bad, banner_until = nil, false, 0
local problems = {}
local dirty = false                        -- the page changed: lay it out again
local pending = nil                        -- page.go() target, followed after the script
local sb_drag = false

-- --- helpers ------------------------------------------------------------------------

local function q(s)
  return '"' .. tostring(s):replace("\\", "\\\\"):replace('"', '\\"') .. '"'
end

-- "/a/b/../c/./d" -> "/a/c/d"
local function normpath(p)
  local out = {}
  for _, part in ipairs(string.split(p, "/")) do
    if part == ".." then
      if #out > 0 then table.remove(out) end
    elseif part ~= "." and part ~= "" then
      out[#out + 1] = part
    end
  end
  return "/" .. table.concat(out, "/")
end

local function resolve(u)
  u = u:trim()
  if u == "" or u:sub(1, 1) == "#" then return u end
  if u:startswith("about:") or string.find(u, "://") then return u end
  if base:startswith("net://") and not u:startswith("/") and not u:startswith("~") then
    -- relative to a page on the network
    local p = normpath(base:sub(7, #base) .. "/" .. u):sub(2)
    if u:endswith("/") and p ~= "" then p = p .. "/" end
    return "net://" .. p
  end
  if u:startswith("file:") then u = u:sub(6, #u) end
  if u == "~" or u:startswith("~/") then u = HOME .. u:sub(2, #u) end
  if u:sub(1, 1) ~= "/" then u = base .. "/" .. u end
  return normpath(u)
end

-- --- where pages come from ----------------------------------------------------------

local schemes = {}

local function error_page(title, msg)
  return "page " .. q(title) .. "\n  title " .. q(title) .. "\n  text " .. q(msg) ..
         "\n  space\n  link \"Go to the start page\" -> about:home\n"
end

-- built-in pages, kept as Yarn files in /usr/share/yarn
schemes.about = function(name)
  if name == "" or name == "blank" then return "page \"\"\n", SYS, nil end
  local p = SYS .. "/" .. name .. ".yarn"
  local src = fs.read(p)
  if src == nil then return nil, "There is no page called about:" .. name end
  return src, SYS, p
end

-- a local file or folder
schemes.file = function(path)
  if not fs.exists(path) then return nil, "There is no file or folder called " .. path end
  if fs.isdir(path) then
    if fs.exists(path .. "/index.yarn") then
      return fs.read(path .. "/index.yarn"), path, path .. "/index.yarn"
    end
    -- a folder without index.yarn: list it
    local out = {"page " .. q("Index of " .. path), "  title " .. q(fs.name(path) .. "/"),
                 "  text " .. q(path) .. " dim", "  list"}
    if path ~= "/" then out[#out + 1] = "    item \"[..](..)\"" end
    for _, n in ipairs(fs.list(path) or {}) do
      local shown = n
      if fs.isdir(path .. "/" .. n) then shown = n .. "/" end
      local esc = shown:replace("]", "\\]")
      out[#out + 1] = "    item " .. q("[" .. esc .. "](" .. n .. ")")
    end
    return table.concat(out, "\n") .. "\n", path, nil
  end
  local dir = fs.dir(path)
  local name = fs.name(path)
  if name:endswith(".yarn") then return fs.read(path), dir, path end
  if name:endswith(".simg") then
    return "page " .. q(name) .. "\n  title " .. q(name) .. "\n  image " .. q(name) .. "\n", dir, nil
  end
  -- any other file is shown as text
  local src = fs.read(path) or ""
  local out = {"page " .. q(name), "  subheading " .. q(path), "  code"}
  for _, l in ipairs(string.split(src, "\n")) do out[#out + 1] = "    " .. l end
  return table.concat(out, "\n") .. "\n", dir, path
end

-- pages on the ScratchOS server (through cloud variables, see man net):
-- net:// is its front page, net://NAME a file, net://FOLDER/ a listing
schemes.net = function(rest)
  if rest == "" then rest = "pages/index.yarn" end
  if rest:endswith("/") then
    local names, err = net.list(rest)
    if names == nil then return nil, "The ScratchOS network: " .. tostring(err) end
    local out = {"page " .. q("net://" .. rest), "  title " .. q(rest), "  text \"On the ScratchOS server\" dim", "  list"}
    for _, n in ipairs(names) do
      out[#out + 1] = "    item " .. q("[" .. n:sub(#rest + 1, #n):replace("]", "\\]") .. "](net://" .. n .. ")")
    end
    if #names == 0 then out[#out + 1] = "    item \"(empty)\"" end
    return table.concat(out, "\n") .. "\n", "net://" .. rest:sub(1, #rest - 1), nil
  end
  local text, err = net.get(rest)
  if text == nil then return nil, "The ScratchOS network: " .. tostring(err) end
  local dir = "net://"
  local slash = 0
  for i = #rest, 1, -1 do if slash == 0 and rest:sub(i, i) == "/" then slash = i end end
  if slash > 0 then dir = "net://" .. rest:sub(1, slash - 1) end
  if rest:endswith(".yarn") then return text, dir, nil end
  local out = {"page " .. q(rest), "  subheading " .. q("net://" .. rest), "  code"}
  for _, l in ipairs(string.split(text, "\n")) do out[#out + 1] = "    " .. l end
  return table.concat(out, "\n") .. "\n", dir, nil
end

-- returns the page's Yarn text, the folder its links start from, and the
-- file Source opens; or nil and an error
local function fetch(u)
  local scheme, rest = "file", u
  local p = string.find(u, "://")
  if p then
    scheme = u:sub(1, p - 1):lower()
    rest = u:sub(p + 3, #u)
  elseif u:startswith("about:") then
    scheme = "about"
    rest = u:sub(7, #u)
  end
  local h = schemes[scheme]
  if h == nil then
    return nil, "There is no " .. scheme .. ":// on ScratchOS. Pages come from this computer, or from " ..
                "the ScratchOS network at net:// addresses."
  end
  -- (a call's extra results are kept only through local variables)
  local src, d, file = h(rest)
  return src, d, file
end

-- --- the page -----------------------------------------------------------------------

local function problem(line, msg)
  problems[#problems + 1] = {line = line, msg = msg}
end

local function relayout()
  view = yarn.layout(doc, CW)
  dirty = false
  local ch = H - TOP - BOT
  if scroll > view.height - ch then scroll = view.height - ch end
  if scroll < 0 then scroll = 0 end
end

-- a script error "line 3: ..." -> the page's line number
local function script_line(sc, err)
  local e = tostring(err)
  if e:startswith("line ") then
    local c = string.find(e, ":")
    if c then
      local n = tonumber(e:sub(6, c - 1))
      if n then return sc.line + n - 1, e:sub(c + 1, #e):trim() end
    end
  end
  return sc.line, e
end

function say(msg)
  banner = tostring(msg)
  banner_bad = false
  banner_until = os.millis() + 3500 + #banner * 40
end

local function say_error(msg)
  say(msg)
  banner_bad = true
end

local go

-- run page code (a button's action, onload ...)
local function run_code(code)
  if not trusted then say_error("Scripts are off on shared network pages") return end
  local f, err = load(yarn.fixcall(code))
  if f == nil then
    say_error("Error in " .. q(code) .. ": " .. tostring(err))
  else
    local ok, e = pcall(f)
    if not ok then say_error("Error: " .. tostring(e)) end
  end
end

local function after_script()
  if pending then
    local u = pending
    pending = nil
    go(u, true)
  elseif dirty then
    relayout()
  end
end

local function load_page(src, dir, file)
  problems = {}
  -- scripts run on this computer's pages and the server's own (net://pages/),
  -- not on pages anyone can upload: they would run with the browser's rights
  trusted = not url:startswith("net://") or url == "net://" or url:startswith("net://pages/")
  base = dir or HOME
  srcpath = file
  doc = yarn.parse(src)
  doc.base = base
  for _, e in ipairs(doc.errors) do problem(e.line, e.msg) end
  focus, hover, hover_hit = nil, nil, nil
  scroll = 0
  banner = nil
  -- page scripts share the browser's globals; forget the last page's hooks
  onload = nil
  if not trusted and #doc.scripts > 0 then
    problem(doc.scripts[1].line, "scripts are off on shared network pages")
    doc.scripts = {}
  end
  for _, sc in ipairs(doc.scripts) do
    local f, err = load(sc.src)
    if f == nil then
      local l, m = script_line(sc, err)
      problem(l, m)
    else
      local ok, e = pcall(f)
      if not ok then
        local l, m = script_line(sc, e)
        problem(l, m)
      end
    end
  end
  relayout()
  local t = doc.title
  if t == "" then t = fs.name(url) end
  if url:startswith("about:") and doc.title == "" then t = url end
  gui.title(win, t)
  if onload then
    local ok, e = pcall(onload)
    if not ok then say_error("Error in onload: " .. tostring(e)) end
    if dirty then relayout() end
  end
end

-- open address u; push = remember the current page for Back
go = function(u, push)
  local target = resolve(u)
  if target == "" then return end
  if target:sub(1, 1) == "#" then
    local n = doc.ids[target:sub(2, #target)]
    if n and n.y then scroll = math.max(0, math.min(n.y - 10, view.height - (H - TOP - BOT))) end
    return
  end
  if push and url then
    back[#back + 1] = url
    fwd = {}
  end
  url = target
  addr = url
  local src, d, file = fetch(target)
  if src == nil then
    load_page(error_page("Can't open this page", d), HOME, nil)
  else
    load_page(src, d, file)
  end
end

-- --- the page API, for scripts in pages ---------------------------------------------

page = {}

local function node(id)
  local n = doc.ids[tostring(id)]
  if n == nil then error("no element with id #" .. tostring(id)) end
  return n
end

function page.get(id)
  local n = node(id)
  if n.kind == "input" then return n.value end
  if n.kind == "check" then return n.checked end
  return yarn.text_of(n)
end

function page.set(id, v)
  local n = node(id)
  local s = tostring(v)
  if n.kind == "input" then n.value = s
  elseif n.kind == "check" then n.checked = (v == true or v == 1 or v == "true")
  elseif n.kind == "link" or n.kind == "button" or n.kind == "check" then n.label = s
  elseif n.kind == "code" then n.raw = string.split(s, "\n")
  elseif n.kind == "image" then n.src = s n.img = nil n.imgerr = nil
  else n.args = {s} end
  dirty = true
end

function page.show(id) node(id).hide = false dirty = true end
function page.hide(id) node(id).hide = true dirty = true end
function page.toggle(id)
  local n = node(id)
  n.hide = not yarn.hidden(doc, n)
  dirty = true
end
function page.visible(id) return not yarn.hidden(doc, node(id)) end

-- set an attribute: page.attr("box1", "bg", "red")
function page.attr(id, key, v)
  local n = node(id)
  n.attrs[tostring(key):lower()] = v and tostring(v) or nil
  n.eff = nil
  dirty = true
end

-- use a named style instead of the element's own
function page.style(id, name)
  local n = node(id)
  n.styles = {name}
  n.attrs.style = nil
  n.eff = nil
  dirty = true
end

-- add Yarn elements inside a container: page.add("list", 'item "new"')
function page.add(id, src)
  local n = node(id)
  local before = #doc.errors
  yarn.parse(src, doc, n)
  if #doc.errors > before then
    local e = doc.errors[#doc.errors]
    error("page.add: line " .. e.line .. ": " .. e.msg)
  end
  dirty = true
end

function page.clear(id)
  node(id).kids = {}
  dirty = true
end

function page.go(u) pending = u end
function page.back() if #back > 0 then pending = "<back>" end end
function page.reload() pending = url end
function page.url() return url end
function page.title(t)
  if t then doc.title = tostring(t) gui.title(win, doc.title) end
  return doc.title
end

-- --- drawing ------------------------------------------------------------------------

local function button(x, w, label, on)
  local fg = C.text
  if not on then fg = C.dim end
  gfx.fill(win, x, 8, w, 24, C.button)
  if label then gfx.text(win, x + (w - #label * 8) // 2, 12, label, fg) end
  return fg
end

local function toolbar()
  gfx.fill(win, 0, 0, W, TOP, C.bar)
  gfx.fill(win, 0, TOP - 1, W, 1, C.border)
  button(8, 26, "◄", #back > 0)
  button(38, 26, "►", #fwd > 0)
  -- reload: a ring with an arrow head
  local fg = button(68, 26, nil, true)
  gfx.circle(win, 81, 20, 6, fg)
  gfx.fill(win, 82, 12, 5, 4, C.button)
  gfx.poly(win, {83, 11, 89, 14, 83, 18}, fg)
  -- home: a little house
  fg = button(98, 26, nil, true)
  gfx.poly(win, {111, 12, 119, 19, 103, 19}, fg)
  gfx.fill(win, 105, 19, 12, 7, fg)
  gfx.fill(win, 109, 22, 4, 4, C.button)
  -- address bar
  local ax, aw = 132, W - 132 - 92
  gfx.fill(win, ax, 8, aw, 24, C.field)
  local bc = C.border
  if focus == "addr" then bc = C.accent end
  gfx.rect(win, ax, 8, aw, 24, bc)
  local maxc = (aw - 16) // 8
  local s = addr
  if focus == "addr" then
    if #s >= maxc then s = s:sub(#s - maxc + 2, #s) end
    if addr_fresh then
      -- selected
      gfx.fill(win, ax + 6, 11, #s * 8 + 4, 18, C.accent)
      gfx.text(win, ax + 8, 12, s, C.ontext)
    else
      gfx.text(win, ax + 8, 12, s, C.text)
      gfx.fill(win, ax + 8 + #s * 8, 12, 2, 16, C.accent)
    end
  else
    if #s > maxc then s = s:sub(1, maxc - 1) .. ">" end
    gfx.text(win, ax + 8, 12, s, C.text)
  end
  button(W - 84, 76, "Source", srcpath ~= nil)
end

local function statusbar()
  gfx.fill(win, 0, H - BOT, W, BOT, C.bar)
  gfx.fill(win, 0, H - BOT, W, 1, C.border)
  local s, c = "Done", C.dim
  if hover_hit and hover_hit.kind == "link" then
    s = hover_hit.target
    if s:sub(1, 1) ~= "#" then s = resolve(s) end
  elseif #problems > 0 then
    local p = problems[1]
    s = #problems .. " problem" .. (#problems > 1 and "s" or "") .. " - line " .. p.line .. ": " .. p.msg
    c = C.red
  end
  local maxc = (W - 24) // 8
  if #s > maxc then s = s:sub(1, maxc - 1) .. ">" end
  gfx.text(win, 12, H - BOT + 3, s, c)
end

local function draw()
  gfx.batch()
  gfx.clear(win, view.th.bg)
  local ch = H - TOP - BOT
  yarn.draw(win, view, 0, TOP, CW, ch, scroll, hover, focus)
  if banner then
    local bg = C.accent
    if banner_bad then bg = C.red end
    local maxc = (CW - 56) // 8
    local s = banner
    if #s > maxc then s = s:sub(1, maxc - 1) .. ">" end
    gfx.fill(win, 12, TOP + 10, CW - 24, 28, bg)
    gfx.text(win, 24, TOP + 16, s, C.ontext)
    gfx.text(win, CW - 32, TOP + 16, "x", C.ontext)
  end
  -- scroll bar
  gfx.fill(win, CW, TOP, SBW, ch, C.bar)
  if view.height > ch then
    local th = math.max(24, ch * ch // view.height)
    local ty = TOP + (ch - th) * scroll // (view.height - ch)
    gfx.fill(win, CW + 2, ty, SBW - 4, th, C.dim)
  end
  -- the bars go last: they cover anything that reached past the page area
  toolbar()
  statusbar()
  gfx.flush()
end

-- --- input --------------------------------------------------------------------------

local function scroll_by(d)
  local ch = H - TOP - BOT
  scroll = math.max(0, math.min(scroll + d, view.height - ch))
end

local function go_back()
  if #back == 0 then return end
  fwd[#fwd + 1] = url
  local u = table.remove(back)
  go(u, false)
end

local function go_fwd()
  if #fwd == 0 then return end
  back[#back + 1] = url
  local u = table.remove(fwd)
  go(u, false)
end

local function follow()
  if pending == "<back>" then
    pending = nil
    go_back()
  else
    after_script()
  end
end

local function click_page(x, y)
  local h = yarn.hit(view, x, y + scroll)
  if focus ~= nil and (h == nil or h.n ~= focus) then focus = nil end
  if h == nil then return end
  if h.kind == "link" then
    go(h.target, true)
  elseif h.kind == "button" then
    run_code(h.n.action)
    follow()
  elseif h.kind == "input" then
    focus = h.n
  elseif h.kind == "check" then
    h.n.checked = not h.n.checked
    if h.n.action then
      run_code(h.n.action)
      follow()
    end
  end
end

local function scrollbar_to(y)
  local ch = H - TOP - BOT
  if view.height <= ch then return end
  scroll = math.floor((y - TOP) / ch * view.height - ch / 2)
  scroll_by(0)
end

local function mousedown(x, y)
  if y < TOP then
    if focus == "addr" and not (x >= 132 and x < W - 92) then focus = nil addr = url end
    if x >= 8 and x < 34 then go_back()
    elseif x >= 38 and x < 64 then go_fwd()
    elseif x >= 68 and x < 94 then go(url, false)
    elseif x >= 98 and x < 124 then go("about:home", true)
    elseif x >= 132 and x < W - 92 then
      if focus ~= "addr" then addr_fresh = true end
      focus = "addr"
    elseif x >= W - 84 and srcpath then gui.ide(srcpath) end
  elseif y >= H - BOT then
    return
  elseif x >= CW then
    sb_drag = true
    scrollbar_to(y)
  elseif banner and y >= TOP + 10 and y < TOP + 38 then
    banner = nil
  else
    if focus == "addr" then addr = url end
    click_page(x, y - TOP)
  end
end

local function edit(s, k)
  if k == "backspace" then return s:sub(1, #s - 1) end
  if #k == 1 then return s .. k end
  if k == "space" then return s .. " " end
  return s
end

local function key(k)
  local ch = H - TOP - BOT
  if k == "^l" then focus = "addr" addr_fresh = true return end
  if k == "^r" then go(url, false) return end
  if focus == "addr" then
    if k == "enter" then
      focus = nil
      go(addr, true)
    elseif k == "escape" then
      focus = nil
      addr = url
    else
      if addr_fresh and (#k == 1 or k == "backspace" or k == "space") then addr = "" end
      addr_fresh = false
      addr = edit(addr, k)
    end
  elseif focus then
    local n = focus
    if k == "enter" then
      if n.action then
        run_code(n.action)
        follow()
      end
    elseif k == "escape" then
      focus = nil
    else
      n.value = edit(n.value, k)
    end
  else
    if k == "down arrow" then scroll_by(40)
    elseif k == "up arrow" then scroll_by(-40)
    elseif k == "page down" or k == " " or k == "space" then scroll_by(ch - 40)
    elseif k == "page up" then scroll_by(40 - ch)
    elseif k == "home" then scroll = 0
    elseif k == "end" then scroll_by(view.height)
    elseif k == "left arrow" then go_back()
    elseif k == "right arrow" then go_fwd() end
  end
end

-- --- check mode ---------------------------------------------------------------------

local function check(path)
  local p = resolve(path)
  local src = fs.read(p)
  if src == nil then print(p .. ": cannot read") return 1 end
  local d = yarn.parse(src)
  local errs = {}
  for _, e in ipairs(d.errors) do errs[#errs + 1] = e end
  for _, sc in ipairs(d.scripts) do
    local f, err = load(sc.src)
    if f == nil then
      local l, m = script_line(sc, err)
      errs[#errs + 1] = {line = l, msg = m}
    end
  end
  -- links and pictures that point at missing files
  local dir = fs.dir(p)
  local stack = {d.root}
  while #stack > 0 do
    local n = table.remove(stack)
    for _, k in ipairs(n.kids) do stack[#stack + 1] = k end
    local t = nil
    if n.kind == "link" then t = n.target end
    if n.kind == "image" then t = n.src end
    if t and t:sub(1, 1) ~= "#" and not t:startswith("about:") and not string.find(t, "://") then
      local f = t
      if f == "~" or f:startswith("~/") then f = HOME .. f:sub(2, #f) end
      if f:sub(1, 1) ~= "/" then f = normpath(dir .. "/" .. f) end
      if not fs.exists(f) then errs[#errs + 1] = {line = n.line, msg = "missing file " .. t} end
    end
  end
  table.sort(errs, function(a, b) return a.line < b.line end)
  for _, e in ipairs(errs) do print(p .. ":" .. e.line .. ": " .. e.msg) end
  if #errs == 0 then print(p .. ": no problems") return 0 end
  return 1
end

if arg[1] == "--check" then
  local bad = 0
  for i = 2, #arg do bad = bad + check(arg[i]) end
  exit(bad > 0 and 1 or 0)
end

-- --- main ---------------------------------------------------------------------------

win = gui.window("Browser", W, H)
W, H = gui.size(win)
CW = W - SBW
gui.track(win, true)
C = {
  bar = gui.color("sidebar"), text = gui.color("text"), dim = gui.color("dim"),
  border = gui.color("border"), button = gui.color("button"), accent = gui.color("accent"),
  ontext = gui.color("ontext"), red = gui.color("error"), field = gui.color("window"),
}
go(arg[1] or "about:home", false)
draw()

local running = true
while running do
  local e = nil
  if banner then
    e = gui.event(win)
    if e == nil then
      sleep(0.1)
      if os.millis() > banner_until then
        banner = nil
        draw()
      end
    end
  else
    e = gui.waitevent(win)
  end
  if e then
    local redraw = true
    local t = e.type
    if t == "close" then running = false
    elseif t == "mousedown" then mousedown(e.x, e.y)
    elseif t == "drag" then
      if sb_drag then scrollbar_to(e.y) else redraw = false end
    elseif t == "mouseup" then
      sb_drag = false
      redraw = false
    elseif t == "move" then
      local h = nil
      if e.y >= TOP and e.y < H - BOT and e.x < CW then h = yarn.hit(view, e.x, e.y - TOP + scroll) end
      local k = h and h.key or nil
      if k ~= hover then
        hover = k
        hover_hit = h
      else
        redraw = false
      end
    elseif t == "wheel" then scroll_by(e.y * 54)
    elseif t == "key" then key(e.key)
    elseif t == "resize" then
      W, H = e.x, e.y
      CW = W - SBW
      relayout()
    else
      redraw = false
    end
    if dirty then relayout() end
    if redraw and running then draw() end
  end
end
gui.close(win)
