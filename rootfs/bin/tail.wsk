-- tail - last lines of input.  usage: tail [-n N] [file]
local n, file = 10, nil
local i = 1
while i <= #arg do
  if arg[i] == "-n" then n = tonumber(arg[i + 1]) i = i + 2
  else file = arg[i] i = i + 1 end
end
local lines
if file then
  local data, err = fs.read(file)
  if data == nil then io.error("tail: " .. file .. ": " .. err .. "\n") exit(1) end
  lines = string.lines(data)
  if lines[#lines] == "" then table.remove(lines) end
else
  lines = io.lines()
end
for k = math.max(1, #lines - n + 1), #lines do print(lines[k]) end
