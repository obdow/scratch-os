// Smoke test: draws all glyphs in all colours.
sprite Kernel {
    costumes "glyphs";
    include "gfx.sbs";
    var t0 = 0;
    var frame_ms = 0;
    proc fib(n) recursive {
        if (n < 2) { return n; }
        return fib(n - 1) + fib(n - 2);
    }
    proc draw_all() {
        gfx_init();
        gfx_fill(0, 0, 480, 360, 1);
        for i = 0 to 255 {
            gfx_cell(i % 32, floor(i / 32), i, i % 16, 0);
        }
        for c = 0 to 15 {
            gfx_fill(c * 30, 140, 30, 20, c);
            gfx_glyph(c * 30 + 10, 170, 65, c);
        }
        gfx_line(10, 200, 470, 350, 14, 1);
        local s = "Hello, ScratchOS!";
        for i = 1 to len(s) {
            costume(s[i]);
            gfx_glyph(i * 8, 220, costume_num() - 1, 15);
        }
        t0 = fib(15);
    }
    on flag { draw_all(); }
}
