// ===========================================================================
// ScratchOS - kernel entry point
//
// Sprites:
//   Keyboard  clone-per-key input listeners + frame pacer (kbd.sbs)
//   Kernel    everything else: graphics, terminals, file system, processes,
//             shell, Whisker compiler/VM, the desktop and the Whisker IDE.
//             It is hidden and draws only by stamping into the pen layer.
//
// The stage is 1280x720 (160 x 45 text cells).  ScratchOS boots to the
// desktop; pressing Esc while it boots starts the text console instead
// ('startx' starts the desktop from there).
// ===========================================================================

include "kbd.sbs";

global list ide_export;      // the IDE's File > Export / Import list monitor

sprite Kernel {
    costumes "os_glyphs";
    include "gfx.sbs";
    include "ui.sbs";
    include "str.sbs";
    include "tty.sbs";
    include "fs.sbs";
    include "proc.sbs";
    include "shell.sbs";
    include "boot.sbs";
    include "heap.sbs";
    include "wcomp.sbs";
    include "vm.sbs";
    include "natives.sbs";
    include "natives_sys.sbs";
    include "caps.sbs";
    include "image.sbs";
    include "wm.sbs";
    include "ide/ide.sbs";          // the Whisker IDE, as a desktop app
    include "ide/textview.sbs";
    include "ide/yarnhl.sbs";          // Yarn pages in the IDE

    var con = 0;            // console tty
    var frames = 0;
    var gui = 0;            // 1 while the desktop is running

    proc kernel_init() {
        gfx_init();
        ui_theme(0);
        tty_init();
        con = tty_alloc(SCR_COLS, SCR_ROWS, 0, 0, 0);
        tty_vis[con] = 0;
        cur_t = con;
        gui = 0;
        halted = 0;
        power_req = -1;
        ide_ready = 0;
        ide_win = 0;
    }

    // route one key event
    proc input_event(event) {
        // the IDE gets keys as they are, with "^" / "+" modifier prefixes
        if (gui == 1 && ide_win > 0 && dlg_kind == 0 && menu_open == 0 && wm_top() == ide_win) {
            ide_key(event);
            return;
        }
        local ev = event;
        // everything else ignores modifiers on special keys ("^enter", "+up arrow")
        // (canvas windows get the modifier as the event's "mod")
        if (len(ev) > 2 && (ev[1] == "^" || ev[1] == "+")) {
            if (ev[1] == "^") { ev_next_mod = "ctrl"; } else { ev_next_mod = "shift"; }
            ev = substr(ev, 2, len(ev));
        }
        if (ev == "caps lock") { kb_caps = 1 - kb_caps; return; }
        local t = con;
        if (gui == 1) {
            t = wm_focus_tty();
            if (t == 0) { wm_key(ev); ev_next_mod = ""; return; }
        }
        if (prompt_pid != 0 && prompt_gui == 0 && prompt_tty == t) {
            caps_key(ev);
            return;
        }
        local fs = proc_slot(tty_fgpid[t]);
        if (ev == "^c") {
            if (tty_interrupt(t) == 0) {
                // interrupt the line being typed at a shell prompt
                tty_write(t, "^C\n");
                if (fs > 0 && p_kind[fs] == PK_SHELL) {
                    sh_state[fs] = SH_PROMPT;
                    sh_rest[fs] = "";
                    p_state[fs] = PS_READY;
                } else {
                    tty_line_begin(t);
                }
            }
            return;
        }
        if (tty_mode[t] == 1) {
            if (fs > 0) { add(kq_pid, p_pid[fs]); add(kq_ev, ev); }
            return;
        }
        tty_key(t, ev);
    }

    proc input_poll() {
        local n = 0;
        while (len(kb_queue) > 0 && n < 64) {
            local ev = kb_queue[1];
            del(kb_queue, 1);
            last_key_time = days2000() * 86400;
            input_event(ev);
            n += 1;
        }
    }

    proc tick() {
        frames += 1;
        input_poll();
        if (gui == 1) {
            wm_tick();
            sched_run(8);
            if (wm_need == 1) { wm_update(); }
            tty_render();
            tty_cursor_update();
        } else {
            wheel = 0;
            sched_run(10);
            tty_render();
            tty_cursor_update();
        }
    }

    proc kernel_boot() nowarp {
        kernel_init();
        boot_seq();
    }

    // Scratch turns the mouse wheel into "up/down arrow key pressed" hat
    // events without setting the key state, which tells it apart from a
    // real arrow key.
    on key "up arrow" {
        if (!(key("up arrow"))) { wheel -= 1; }
    }
    on key "down arrow" {
        if (!(key("down arrow"))) { wheel += 1; }
    }

    on flag {
        kernel_boot();
        forever {
            if (halted == 0) {
                tick();
                if (power_req != -1) { power_off(); }
            }
        }
    }
}
