// ===========================================================================
// wm.sbs - the ScratchOS desktop (included inside sprite Kernel)
//
// A macOS-style desktop on the 8x16 character grid (160 x 45 cells at 720p):
//   row 0            menu bar: logo menu, the focused app's menus, the clock
//   rows 1..         wallpaper and windows
//   the dock         a floating panel of app tiles at the bottom
//
// Windows have a title row with the traffic lights (close / minimise /
// zoom) and rounded top corners; their content runs edge to edge below it.
//
// The screen is described by:
//   own[i]          who owns cell i: 0 desktop, -1 menu bar, -2 drop-down
//                   menu, -3 dialog, -4 dock, a window id, or OUT_WIN for
//                   the IDE's Output panel
//   ui_ch / ui_at   glyph + attribute (ui.sbs) for every cell that is not
//                   window content; ui_ch = -1 marks content drawn by a tty
//                   or a canvas, -3 a dock icon tile
// wm_compose() rebuilds these, compares them with the previous frame and
// redraws only the cells that changed.
//
// Window kinds:
//   WK_TERM    terminal: content is a tty (shell or text program)
//   WK_CANVAS  graphics: content is drawn by a Whisker program with gfx.*;
//              primitives are kept in a display list so the window can be
//              repainted when it is uncovered or moved
//   WK_IDE     the Whisker IDE (ide/ide.sbs), which composes its own cells
// ===========================================================================

const WM_COLS = SCR_COLS;
const WM_ROWS = SCR_ROWS;
const DOCK_TOP = SCR_ROWS - 4;   // the dock's four rows
const MAX_WIN = 16;
const WK_TERM = 1;
const WK_CANVAS = 2;
const WK_IDE = 3;
const DL_MAX = 90000;
const OUT_WIN = 99;              // own[] value for the IDE's Output panel cells

const OWN_DESK = 0;
const OWN_BAR = -1;
const OWN_MENU = -2;
const OWN_DLG = -3;
const OWN_DOCK = -4;

list win_used;
list win_x;
list win_y;
list win_w;
list win_h;
list win_title;
list win_kind;
list win_tty;
list win_pid;
list win_dl;          // display list table (canvas)
list win_min;
list win_max;
list win_sx;
list win_sy;
list win_sw;
list win_sh;
list win_auto;        // terminal: close the window when its programs exit
list win_bg;          // canvas background colour
list win_trk;         // 1: the canvas gets "move" events (gui.track)
list win_app;         // dock item the window belongs to (0 none)

list wz;              // z order, bottom -> top (window ids)

list own;
list ui_ch;
list ui_at;
list old_own;
list old_ch;
list old_at;
list wm_dirty;        // cells to redraw
list wall_at;         // wallpaper attribute per row

list ev_win;          // window event queue
list ev_type;
list ev_x;
list ev_y;
list ev_key;

list vrc_win;         // cached visible rectangles of canvas windows (px)
list vrc_x;
list vrc_y;
list vrc_w;
list vrc_h;
list vr_x;            // scratch rect lists for subtraction
list vr_y;
list vr_w;
list vr_h;
list nr_x;
list nr_y;
list nr_w;
list nr_h;

var wm_need = 0;      // layout changed: recompose
var wm_full = 0;      // force a full redraw
var wm_next_x = 20;   // cascade position for new windows
var wm_next_y = 3;
var dlg_kind = 0;     // 0 none, 1 permission request, 2 message, 3 settings
var dlg_title = "";
var dlg_l1 = "";
var dlg_l2 = "";
var dlg_l3 = "";
var dlg_x = 0;
var dlg_y = 0;
var dlg_w = 0;
var dlg_h = 0;
var m_x = 0;
var m_y = 0;
var m_down = 0;
var m_was = 0;
var m_moved = 0;
var drag_mode = 0;    // 1 move, 2 resize, 3 canvas drag, 4 IDE
var drag_win = 0;
var drag_dx = 0;
var drag_dy = 0;
var clock_last = "";
var ide_win = 0;      // the IDE's window (0 = not open)
var ide_gw = 122;     // the IDE window's last geometry
var ide_gh = 36;
var ide_gx = 19;
var ide_gy = 2;
var t_click = 0;      // double-click on a title bar
var t_click_w = 0;

// --- menu bar ---------------------------------------------------------------------
// menus: 1 logo, 2 app, 3 File, 4 Window, 5 Help; items of the open one in mi_*
var menu_open = 0;
var menu_sel = 0;
var menu_x0 = 0;      // drop-down box columns
var menu_x1 = 0;
list mb_title;
list mb_x;
list mb_w;
list wmi_lbl;
list wmi_key;
list wmi_cmd;

// --- dock ------------------------------------------------------------------------
//   icon: one or two characters drawn at double size on a coloured tile
list dk_name = ["Finder", "Terminal", "Whisker IDE", "TextEdit", "Paint", "Preview", "Browser", "Clock", "3D Cube",
                "Snake", "Matrix", "Activity Monitor", "System Settings"];
list dk_cmd = ["files", "@term", "@ide", "@term edit", "paint", "preview", "browser", "clock", "cube",
               "@term snake", "@term matrix", "taskmgr", "@settings"];
list dk_icon = ["☺", ">_", "{}", "Aa", "♥", "☼▲", "@", "12", "♦", "~☼", "01", "▄█", "≡"];
list dk_bgn = ["blue", "dark", "purple", "white", "orange", "blue", "white", "white", "dark", "green", "dark", "dark", "grey"];
list dk_fgn = ["white", "white", "white", "dark", "white", "white", "blue", "dark", "blue", "white", "green", "green", "white"];
var dk_x0 = 0;        // dock panel columns
var dk_x1 = 0;
var dk_hover = 0;     // icon under the pointer (tooltip)

proc wm_init() {
    clear(win_used); clear(win_x); clear(win_y); clear(win_w); clear(win_h); clear(win_title);
    clear(win_kind); clear(win_tty); clear(win_pid); clear(win_dl); clear(win_min); clear(win_max);
    clear(win_sx); clear(win_sy); clear(win_sw); clear(win_sh); clear(win_auto); clear(win_bg); clear(win_trk); clear(win_app);
    for i = 1 to MAX_WIN {
        add(win_used, 0); add(win_x, 0); add(win_y, 0); add(win_w, 0); add(win_h, 0); add(win_title, "");
        add(win_kind, 0); add(win_tty, 0); add(win_pid, 0); add(win_dl, 0); add(win_min, 0); add(win_max, 0);
        add(win_sx, 0); add(win_sy, 0); add(win_sw, 0); add(win_sh, 0); add(win_auto, 0); add(win_bg, 0); add(win_trk, 0);
        add(win_app, 0);
    }
    clear(wz);
    clear(own); clear(ui_ch); clear(ui_at); clear(old_own); clear(old_ch); clear(old_at);
    repeat (WM_COLS * WM_ROWS) {
        add(own, 0); add(ui_ch, 32); add(ui_at, 0);
        add(old_own, -9); add(old_ch, -9); add(old_at, -9);
    }
    clear(ev_win); clear(ev_type); clear(ev_x); clear(ev_y); clear(ev_key);
    clear(vrc_win); clear(vrc_x); clear(vrc_y); clear(vrc_w); clear(vrc_h);
    // wallpaper: two stripes per cell row
    clear(wall_at);
    for r = 0 to WM_ROWS - 1 {
        local a = WALL_BASE + floor(r * 2 * WALL_N / (WM_ROWS * 2));
        local b = WALL_BASE + floor((r * 2 + 1) * WALL_N / (WM_ROWS * 2));
        add(wall_at, AB * a + AD * (D_HALF + b));
    }
    menu_open = 0;
    dlg_kind = 0;
    drag_mode = 0;
    ide_win = 0;
    dk_hover = 0;
}

proc wm_owner_at(cx, cy) {
    if (cx < 0 || cy < 0 || cx >= WM_COLS || cy >= WM_ROWS) { return -9; }
    return own[cy * WM_COLS + cx + 1];
}

// switch between the dark and light appearance
proc wm_set_theme(n) {
    ui_theme(n);
    if (ide_ready == 1) { ide_theme(n); }
    for t = 1 to MAX_TTY { if (tty_used[t] == 1) { tty_full[t] = 1; } }
    wm_full = 1;
    wm_need = 1;
}

// --- starting / stopping the desktop ---------------------------------------------

proc wm_start(s) {
    if (gui == 1) { sh_errmsg(s, "startx: the desktop is already running"); return 1; }
    gui = 1;
    tty_vis[con] = 0;
    cur_t = 0;
    cur_drawn = 0;
    wm_init();
    wm_need = 1;
    wm_full = 1;
    clock_last = "";
    return 0;
}

proc wm_stop_all() {
    if (gui == 0) { return; }
    for w = 1 to MAX_WIN {
        if (win_used[w] == 1) {
            if (win_kind[w] != WK_IDE) { wm_kill_window_procs(w); }
            wm_close(w);
        }
    }
    gui = 0;
    menu_open = 0;
    dlg_kind = 0;
    tty_vis[con] = 1;
    tty_full[con] = 1;
    cur_t = con;
    gfx_fill(0, 0, SCR_W, SCR_H, 0);
}

// --- windows --------------------------------------------------------------------------

proc wm_alloc_win() {
    for w = 1 to MAX_WIN {
        if (win_used[w] == 0) { return w; }
    }
    return 0;
}

// place a window: cw x ch cells including the title row; x/y < 0 = cascade
proc wm_new_window(title, kind, x, y, cw, ch, pid) {
    local w = wm_alloc_win();
    if (w == 0) { return 0; }
    local ww = cw;
    local hh = ch;
    if (ww < 16) { ww = 16; }
    if (hh < 3) { hh = 3; }
    if (ww > WM_COLS) { ww = WM_COLS; }
    if (hh > DOCK_TOP - 1) { hh = DOCK_TOP - 1; }
    local px = x;
    local py = y;
    if (px < 0) {
        px = wm_next_x;
        py = wm_next_y;
        wm_next_x += 4;
        wm_next_y += 2;
        if (wm_next_x > 60) { wm_next_x = 20; }
        if (wm_next_y > 12) { wm_next_y = 3; }
    }
    if (px + ww > WM_COLS) { px = WM_COLS - ww; }
    if (py + hh > DOCK_TOP) { py = DOCK_TOP - hh; }
    if (px < 0) { px = 0; }
    if (py < 1) { py = 1; }
    win_used[w] = 1;
    win_x[w] = px;
    win_y[w] = py;
    win_w[w] = ww;
    win_h[w] = hh;
    win_title[w] = title;
    win_kind[w] = kind;
    win_tty[w] = 0;
    win_pid[w] = pid;
    win_dl[w] = 0;
    win_min[w] = 0;
    win_max[w] = 0;
    win_auto[w] = 0;
    win_bg[w] = 0;
    win_trk[w] = 0;
    win_app[w] = wm_app_for(title);
    add(wz, w);
    wm_need = 1;
    return w;
}

// the dock item a window belongs to, from its title
proc wm_app_for(title) {
    local k = index(dk_name, title);
    if (k > 0) { return k; }
    if (title == "Files") { return 1; }
    if (title == "Text Editor" || title == "edit") { return 4; }
    if (title == "Task Manager") { return 12; }
    if (title == "snake") { return 10; }
    if (title == "matrix") { return 11; }
    return 0;
}

// terminal window running cmd ("" = interactive shell); returns window id
proc wm_open_term(cmd, title, x, y, cw, ch) {
    local w = wm_new_window(title, WK_TERM, x, y, cw, ch, 0);
    if (w == 0) { return 0; }
    local t = tty_alloc(win_w[w], win_h[w] - 1, win_x[w] * 8, (win_y[w] + 1) * 16, w);
    if (t == 0) { wm_close(w); return 0; }
    win_tty[w] = t;
    win_auto[w] = 1;
    tty_vis[t] = 1;
    // start the program with the terminal as its stdin/stdout/stderr
    local s = 0;
    if (len(cmd) == 0) {
        s = shell_spawn(0, "", "-sh");
    } else {
        s = shell_spawn(0, cmd .. "\n", cmd);
        sh_inter[s] = 0;
    }
    if (s == 0) { return w; }
    p_cwd[s] = fs_lookup("/home/user", 1);
    if (p_cwd[s] == 0) { p_cwd[s] = 1; }
    p_tty[s] = t;
    p_in_k[s] = FD_TTY; p_in_i[s] = t;
    p_out_k[s] = FD_TTY; p_out_i[s] = t;
    p_err_k[s] = FD_TTY; p_err_i[s] = t;
    p_pgid[s] = p_pid[s];
    tty_fgpid[t] = p_pid[s];
    win_pid[w] = p_pid[s];
    return w;
}

// open (or bring forward) the Whisker IDE, optionally with a file
proc wm_open_ide(path) {
    if (ide_win > 0) {
        wm_raise(ide_win);
    } else {
        local w = wm_new_window("Whisker IDE", WK_IDE, ide_gx, ide_gy, ide_gw, ide_gh, 0);
        if (w == 0) { return 0; }
        ide_win = w;
        if (ide_ready == 0) {
            IC = win_w[w];
            IR = win_h[w] - 1;
            ROW_STATUS = IR - 1;
            ide_ox = win_x[w];
            ide_oy = win_y[w] + 1;
            ide_init();
            ide_theme(theme);
        }
        ide_move(win_x[w], win_y[w] + 1);
        ide_resize(win_w[w], win_h[w] - 1);
        tty_full[ide_con] = 1;
    }
    if (len(path) > 0) { open_file(path); }
    ide_full = 1;
    ide_dirty = 1;
    wm_need = 1;
    return ide_win;
}

// release the images a display list refers to (gfx.image pins them)
proc dl_unpin_images(h) {
    local b = tb_ab[h];
    local p = 1;
    while (p <= tb_an[h]) {
        if (HV[b + p] == 10) {
            local img = HV[b + p + 5];
            if (img > 0 && img <= len(tb_pin)) { tb_pin[img] = 0; }
        }
        p += 7;          // PRIM (declared further down)
    }
}

proc wm_close(w) {
    if (win_used[w] == 0) { return; }
    win_used[w] = 0;
    if (win_tty[w] > 0) { tty_free(win_tty[w]); }
    if (win_dl[w] > 0) {
        dl_unpin_images(win_dl[w]);
        tb_pin[win_dl[w]] = 0;
        tb_used[win_dl[w]] = 0;
    }
    if (w == ide_win) {
        // the IDE keeps its state; remember where its window was
        ide_gx = win_x[w]; ide_gy = win_y[w]; ide_gw = win_w[w]; ide_gh = win_h[w];
        ide_win = 0;
        ide_grab = 0;
    }
    win_dl[w] = 0;
    local i = index(wz, w);
    if (i > 0) { del(wz, i); }
    // drop pending events
    local k = 1;
    while (k <= len(ev_win)) {
        if (ev_win[k] == w) { del(ev_win, k); del(ev_type, k); del(ev_x, k); del(ev_y, k); del(ev_key, k); }
        else { k += 1; }
    }
    if (drag_win == w) { drag_mode = 0; }
    wm_need = 1;
}

proc wm_kill_window_procs(w) {
    local t = win_tty[w];
    for s = 1 to MAX_PROC {
        if (p_state[s] != PS_FREE && p_kind[s] != PK_INIT) {
            if ((t > 0 && p_tty[s] == t) || (win_kind[w] == WK_CANVAS && p_pid[s] == win_pid[w])) {
                proc_exit(s, 143);
            }
        }
    }
}

// a process exited: close its canvas windows
proc wm_proc_exit(pid) {
    if (gui == 0) { return; }
    for w = 1 to MAX_WIN {
        if (win_used[w] == 1 && win_kind[w] == WK_CANVAS && win_pid[w] == pid) { wm_close(w); }
    }
}

proc wm_raise(w) {
    local i = index(wz, w);
    if (i > 0) { del(wz, i); }
    add(wz, w);
    win_min[w] = 0;
    wm_need = 1;
}

// top-most visible window
proc wm_top() {
    local i = len(wz);
    while (i > 0) {
        if (win_min[wz[i]] == 0) { return wz[i]; }
        i -= 1;
    }
    return 0;
}

proc wm_focus_tty() {
    if (dlg_kind != 0 || menu_open > 0) { return 0; }
    local w = wm_top();
    if (w > 0 && win_kind[w] == WK_TERM) { return win_tty[w]; }
    return 0;
}

proc wm_toggle_max(w) {
    if (win_max[w] == 0) {
        win_sx[w] = win_x[w]; win_sy[w] = win_y[w]; win_sw[w] = win_w[w]; win_sh[w] = win_h[w];
        win_max[w] = 1;
        wm_set_geom(w, 0, 1, WM_COLS, DOCK_TOP - 1);
    } else {
        win_max[w] = 0;
        wm_set_geom(w, win_sx[w], win_sy[w], win_sw[w], win_sh[w]);
    }
}

proc wm_set_geom(w, x, y, cw, ch) {
    local resized = 0;
    if (cw != win_w[w] || ch != win_h[w]) { resized = 1; }
    win_x[w] = x;
    win_y[w] = y;
    win_w[w] = cw;
    win_h[w] = ch;
    local t = win_tty[w];
    if (t > 0) {
        tty_ox[t] = x * 8;
        tty_oy[t] = (y + 1) * 16;
        if (resized == 1) { tty_resize(t, cw, ch - 1); }
    }
    if (resized == 1 && win_kind[w] == WK_CANVAS) {
        wm_event(w, "resize", cw * 8, (ch - 1) * 16, "");
    }
    if (win_kind[w] == WK_IDE) {
        ide_move(x, y + 1);
        ide_resize(cw, ch - 1);
        tty_full[ide_con] = 1;
        ide_dirty = 1;
    }
    wm_need = 1;
}

proc wm_event(w, type, x, y, key) {
    // keep the queue bounded
    if (len(ev_win) > 200) { del(ev_win, 1); del(ev_type, 1); del(ev_x, 1); del(ev_y, 1); del(ev_key, 1); }
    add(ev_win, w);
    add(ev_type, type);
    add(ev_x, x);
    add(ev_y, y);
    add(ev_key, key);
}

// --- composition --------------------------------------------------------------------

proc ui_set(col, row, ch, at, who) {
    if (col < 0 || row < 0 || col >= WM_COLS || row >= WM_ROWS) { return; }
    local i = row * WM_COLS + col + 1;
    own[i] = who;
    ui_ch[i] = ch;
    ui_at[i] = at;
}

proc ui_text(col, row, s, at, who) {
    for k = 1 to len(s) {
        ui_set(col + k - 1, row, ord(s[k]), at, who);
    }
}

// set a cell's decoration, keeping its glyph and colours
proc ui_deco_at(col, row, d) {
    if (col < 0 || row < 0 || col >= WM_COLS || row >= WM_ROWS) { return; }
    local i = row * WM_COLS + col + 1;
    if (ui_ch[i] >= 0) { ui_at[i] = ui_at[i] % AD + AD * d; }
}

// background colour currently composed at a cell (for rounded corners)
proc ui_bg_at(col, row) {
    if (col < 0 || row < 0 || col >= WM_COLS || row >= WM_ROWS) { return C_SHADOW; }
    local i = row * WM_COLS + col + 1;
    if (ui_ch[i] < 0) { return C_SHADOW; }
    local a = ui_at[i];
    // the wallpaper's lower stripe shows at the bottom corners
    local d = floor(a / AD);
    if (d >= D_HALF) { return d - D_HALF; }
    return ui_bg(a);
}

// a popup panel: filled, with a 1px border
proc ui_box(x0, y0, x1, y1, at, who) {
    for r = y0 to y1 {
        for c = x0 to x1 { ui_set(c, r, 32, at, who); }
    }
    for c = x0 to x1 {
        local d = D_POP + D_TOP;
        if (y0 == y1) { d += D_BOTTOM; }
        if (c == x0) { d += D_LEFTB; }
        if (c == x1) { d += D_RIGHT; }
        ui_deco_at(c, y0, d);
        if (y1 > y0) {
            local d2 = D_POP + D_BOTTOM;
            if (c == x0) { d2 += D_LEFTB; }
            if (c == x1) { d2 += D_RIGHT; }
            ui_deco_at(c, y1, d2);
        }
    }
    for r = y0 + 1 to y1 - 1 {
        ui_deco_at(x0, r, D_POP + D_LEFTB);
        ui_deco_at(x1, r, D_POP + D_RIGHT);
    }
}

proc wm_compose() {
    // wallpaper
    local i = 1;
    for r = 0 to WM_ROWS - 1 {
        local wa = wall_at[r + 1];
        repeat (WM_COLS) {
            own[i] = OWN_DESK;
            ui_ch[i] = 32;
            ui_at[i] = wa;
            i += 1;
        }
    }
    // windows bottom to top
    local top = wm_top();
    for k = 1 to len(wz) {
        local w = wz[k];
        if (win_min[w] == 0) { wm_compose_window(w, w == top); }
    }
    wm_compose_dock();
    wm_compose_bar();
    if (menu_open > 0) { wm_compose_menu(); }
    if (dk_hover > 0 && menu_open == 0 && dlg_kind == 0) { wm_compose_tip(); }
    if (dlg_kind != 0) { wm_compose_dialog(); }
    wm_cache_vis();
}

proc wm_compose_window(w, focused) {
    local x = win_x[w];
    local y = win_y[w];
    local ww = win_w[w];
    local hh = win_h[w];
    local tbg = C_TITLEIN;
    local tfg = C_TITLEDIM;
    if (focused == 1) { tbg = C_TITLE; tfg = C_TITLETXT; }
    // corners: what is behind them shows through
    local bl = ui_bg_at(x, y);
    local br = ui_bg_at(x + ww - 1, y);
    // title row
    for c = x to x + ww - 1 { ui_set(c, y, 32, tfg + AB * tbg + AD * (D_WIN + D_TOP + D_BOTTOM), w); }
    local title = win_title[w];
    if (len(title) > ww - 12) { title = substr(title, 1, ww - 12); }
    ui_text(x + floor((ww - len(title)) / 2), y, title, tfg + AB * tbg + AD * (D_WIN + D_TOP + D_BOTTOM), w);
    // traffic lights
    local r1 = C_TLOFF;
    local r2 = C_TLOFF;
    local r3 = C_TLOFF;
    if (focused == 1) { r1 = C_TLRED; r2 = C_TLYEL; r3 = C_TLGRN; }
    ui_set(x + 1, y, G_BIGDOT, r1 + AB * tbg + AD * (D_WIN + D_TOP + D_BOTTOM), w);
    ui_set(x + 3, y, G_BIGDOT, r2 + AB * tbg + AD * (D_WIN + D_TOP + D_BOTTOM), w);
    ui_set(x + 5, y, G_BIGDOT, r3 + AB * tbg + AD * (D_WIN + D_TOP + D_BOTTOM), w);
    ui_set(x, y, 32, tfg + AB * tbg + AD * (D_RC + 0 * 256 + bl), w);
    ui_set(x + ww - 1, y, 32, tfg + AB * tbg + AD * (D_RC + 1 * 256 + br), w);
    // content: the attribute encodes the window-relative position, so a
    // moved window's content is seen as changed by wm_diff and gets redrawn
    if (win_kind[w] == WK_IDE) {
        wm_compose_ide(w);
        return;
    }
    for r = y + 1 to y + hh - 1 {
        if (r < WM_ROWS) {
            local j = r * WM_COLS + x + 1;
            for c = x to x + ww - 1 {
                if (c >= 0 && c < WM_COLS) {
                    own[j] = w;
                    ui_ch[j] = -1;
                    ui_at[j] = (r - y) * 256 + (c - x);
                }
                j += 1;
            }
        }
    }
}

// copy the IDE's composed cells into its window
proc wm_compose_ide(w) {
    local x = win_x[w];
    local y = win_y[w] + 1;
    for r = 0 to IR - 1 {
        local sr = y + r;
        if (sr < WM_ROWS) {
            local j = sr * WM_COLS + x + 1;
            local k = r * IC + 1;
            for c = 0 to IC - 1 {
                if (x + c >= 0 && x + c < WM_COLS) {
                    local ch = sc_ch[k];
                    if (ch == -1) {
                        own[j] = OUT_WIN;
                        ui_ch[j] = -1;
                        ui_at[j] = (r + 1) * 256 + c;
                    } else {
                        own[j] = w;
                        ui_ch[j] = ch;
                        ui_at[j] = sc_at[k];
                    }
                }
                j += 1;
                k += 1;
            }
        }
    }
}

// --- menu bar -----------------------------------------------------------------------

proc wm_app_name() {
    local w = wm_top();
    if (w == 0) { return "Finder"; }
    if (win_app[w] > 0) { return dk_name[win_app[w]]; }
    return win_title[w];
}

proc wm_compose_bar() {
    local at = C_MENUTXT + AB * C_MENUBAR;
    for c = 0 to WM_COLS - 1 { ui_set(c, 0, 32, at, OWN_BAR); }
    clear(mb_title); clear(mb_x); clear(mb_w);
    add(mb_title, "☺");
    add(mb_title, wm_app_name());
    add(mb_title, "File");
    add(mb_title, "Window");
    add(mb_title, "Help");
    local x = 1;
    for k = 1 to len(mb_title) {
        local t = mb_title[k];
        local a = at;
        if (menu_open == k) { a = C_ONACC + AB * C_ACCENT; }
        ui_text(x, 0, " " .. t .. " ", a, OWN_BAR);
        add(mb_x, x);
        add(mb_w, len(t) + 2);
        x += len(t) + 2;
    }
    // the app name is shown in the bright text colour (bold in macOS)
    if (menu_open != 2) {
        for c = mb_x[2] + 1 to mb_x[2] + mb_w[2] - 2 { ui_at[c + 1] = C_HEADER + AB * C_MENUBAR; }
    }
    // the clock
    clock_last = pad_left_char(now("hour"), 2, "0") .. ":" .. pad_left_char(now("minute"), 2, "0");
    local clk = wm_day_name(now("dayofweek")) .. " " .. now("date") .. " " .. wm_month_name(now("month")) .. "  " .. clock_last;
    ui_text(WM_COLS - len(clk) - 2, 0, clk, at, OWN_BAR);
}

list day_names = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
list month_names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

proc wm_day_name(d) { return day_names[d]; }
proc wm_month_name(m) { return month_names[m]; }

// items of menu k into wmi_*
proc wmi(label, key, cmd) {
    add(wmi_lbl, label);
    add(wmi_key, key);
    add(wmi_cmd, cmd);
}

proc wm_menu_items(k) {
    clear(wmi_lbl); clear(wmi_key); clear(wmi_cmd);
    if (k == 1) {
        wmi("About ScratchOS", "", "about");
        wmi("-", "", "");
        wmi("System Settings...", "", "@settings");
        if (theme == 0) { wmi("Light Appearance", "", "@light"); } else { wmi("Dark Appearance", "", "@dark"); }
        wmi("-", "", "");
        wmi("Activity Monitor", "", "taskmgr");
        wmi("Text Console", "", "@exit");
        wmi("-", "", "");
        wmi("Restart...", "", "@reboot");
        wmi("Shut Down...", "", "@halt");
    } else if (k == 2) {
        local app = wm_app_name();
        wmi("About " .. app, "", "about");
        wmi("-", "", "");
        wmi("Hide " .. app, "", "@min");
        wmi("Quit " .. app, "", "@close");
    } else if (k == 3) {
        wmi("New Terminal Window", "", "@term");
        wmi("New Finder Window", "", "files");
        wmi("Whisker IDE", "", "@ide");
        wmi("-", "", "");
        wmi("Close Window", "", "@close");
    } else if (k == 4) {
        wmi("Minimize", "", "@min");
        wmi("Zoom", "", "@zoom");
        wmi("-", "", "");
        for w = 1 to MAX_WIN {
            if (win_used[w] == 1) {
                local mark = "  ";
                if (w == wm_top()) { mark = "• "; }
                wmi(mark .. win_title[w], "", "@win" .. w);
            }
        }
        if (len(wmi_lbl) == 3) { wmi("No windows", "", "-"); }
    } else {
        wmi("ScratchOS Help", "", "@term man scratchos");
        wmi("Whisker Reference", "", "@ref");
        wmi("Whisker Quick Start", "", "@quick");
    }
}

proc wm_compose_menu() {
    wm_menu_items(menu_open);
    local w = 18;
    for k = 1 to len(wmi_lbl) {
        local lw = len(wmi_lbl[k]) + len(wmi_key[k]) + 5;
        if (lw > w) { w = lw; }
    }
    local x0 = mb_x[menu_open];
    if (x0 + w + 1 > WM_COLS) { x0 = WM_COLS - w - 1; }
    menu_x0 = x0;
    menu_x1 = x0 + w + 1;
    local n = len(wmi_lbl);
    ui_box(x0, 1, x0 + w + 1, n + 2, C_TEXT + AB * C_POPUP, OWN_MENU);
    for k = 1 to n {
        local r = k + 1;
        if (wmi_lbl[k] == "-") {
            for c = x0 + 2 to x0 + w - 1 { ui_set(c, r, 196, C_POPBD + AB * C_POPUP, OWN_MENU); }
        } else {
            local bg = C_POPUP;
            local fg = C_TEXT;
            if (k == menu_sel) { bg = C_ACCENT; fg = C_ONACC; }
            if (wmi_cmd[k] == "-") { fg = C_DIM; }
            for c = x0 + 1 to x0 + w { ui_set(c, r, 32, fg + AB * bg, OWN_MENU); }
            ui_text(x0 + 2, r, wmi_lbl[k], fg + AB * bg, OWN_MENU);
            ui_text(x0 + w - len(wmi_key[k]), r, wmi_key[k], C_DIM + AB * bg, OWN_MENU);
        }
    }
}

// menu bar title under column cx (0 none)
proc wm_bar_hit(cx) {
    for k = 1 to len(mb_x) {
        if (cx >= mb_x[k] && cx < mb_x[k] + mb_w[k]) { return k; }
    }
    return 0;
}

// --- dock ---------------------------------------------------------------------------

proc wm_named_col(n) {
    if (n == "blue") { return C_ICBLUE; }
    if (n == "dark") { return C_ICDARK; }
    if (n == "purple") { return C_ICPURP; }
    if (n == "white") { return C_ICWHITE; }
    if (n == "orange") { return C_ICORANGE; }
    if (n == "green") { return C_ICGREEN; }
    if (n == "grey") { return C_ICGREY; }
    if (n == "red") { return C_ICRED; }
    return C_ICDARK;
}

// 1 when dock item k has a window open
proc wm_app_running(k) {
    for w = 1 to MAX_WIN {
        if (win_used[w] == 1 && win_app[w] == k) { return 1; }
    }
    return 0;
}

proc wm_compose_dock() {
    local n = len(dk_name);
    local dw = n * 5 + 1;
    dk_x0 = floor((WM_COLS - dw) / 2);
    dk_x1 = dk_x0 + dw - 1;
    local y0 = DOCK_TOP;
    local y1 = DOCK_TOP + 3;
    // rounded corners show what is behind them
    local c_tl = ui_bg_at(dk_x0, y0);
    local c_tr = ui_bg_at(dk_x1, y0);
    local c_bl = ui_bg_at(dk_x0, y1);
    local c_br = ui_bg_at(dk_x1, y1);
    for r = y0 to y1 {
        for c = dk_x0 to dk_x1 { ui_set(c, r, 32, C_DOCKTXT + AB * C_DOCK, OWN_DOCK); }
    }
    ui_deco_at(dk_x0, y0, D_RC + 0 * 256 + c_tl);
    ui_deco_at(dk_x1, y0, D_RC + 1 * 256 + c_tr);
    ui_deco_at(dk_x0, y1, D_RC + 2 * 256 + c_bl);
    ui_deco_at(dk_x1, y1, D_RC + 3 * 256 + c_br);
    for k = 1 to n {
        local tx = dk_x0 + 1 + (k - 1) * 5;
        // icon tiles: cell position p = 0..7 (4 wide, 2 high)
        for p = 0 to 7 {
            ui_set(tx + p % 4, y0 + 1 + floor(p / 4), -3, k * 8 + p, OWN_DOCK);
        }
        if (wm_app_running(k) == 1) { ui_deco_at(tx + 1, y1, D_DOT); }
    }
}

// draw cell p (0..7) of dock icon k at screen cell (col, row)
proc wm_dock_cell(col, row, k, p) {
    local bg = wm_named_col(dk_bgn[k]);
    local x = col * 8;
    local y = row * 16;
    gfx_fill(x, y, 8, 16, bg);
    // rounded tile corners
    if (p == 0) { ui_corner(x, y, 0, C_DOCK); }
    if (p == 3) { ui_corner(x, y, 1, C_DOCK); }
    if (p == 4) { ui_corner(x, y, 2, C_DOCK); }
    if (p == 7) { ui_corner(x, y, 3, C_DOCK); }
    // the double-size glyphs cover 2 x 2 cells; restamp the one over this
    // cell when all four of its cells are visible
    local icon = dk_icon[k];
    local fg = wm_named_col(dk_fgn[k]);
    local tx = col - p % 4;
    local ty = row - floor(p / 4);
    local gx = 0;
    local gi = 1;
    if (len(icon) == 1) { gx = 1; }
    else if (p % 4 >= 2) { gx = 2; gi = 2; }
    if (len(icon) == 1 && (p % 4 == 0 || p % 4 == 3)) { return; }
    if (wm_owner_at(tx + gx, ty) == OWN_DOCK && wm_owner_at(tx + gx + 1, ty) == OWN_DOCK
        && wm_owner_at(tx + gx, ty + 1) == OWN_DOCK && wm_owner_at(tx + gx + 1, ty + 1) == OWN_DOCK) {
        gfx_glyph2((tx + gx) * 8, ty * 16, ord(letter(icon, gi)), fg);
    }
}

// dock item under screen cell (cx, cy), 0 none
proc wm_dock_hit(cx, cy) {
    if (cy < DOCK_TOP + 1 || cy > DOCK_TOP + 2 || cx <= dk_x0 || cx >= dk_x1) { return 0; }
    local k = floor((cx - dk_x0 - 1) / 5) + 1;
    if ((cx - dk_x0 - 1) % 5 == 4 || k > len(dk_name)) { return 0; }
    return k;
}

proc wm_compose_tip() {
    local name = dk_name[dk_hover];
    local tx = dk_x0 + 1 + (dk_hover - 1) * 5;
    local x0 = tx + 2 - floor((len(name) + 2) / 2);
    ui_box(x0, DOCK_TOP - 1, x0 + len(name) + 1, DOCK_TOP - 1, C_TEXT + AB * C_POPUP, OWN_MENU);
    ui_text(x0 + 1, DOCK_TOP - 1, name, C_TEXT + AB * C_POPUP, OWN_MENU);
    // keep the box borders on the text cells
    for c = x0 to x0 + len(name) + 1 {
        local d = D_POP + D_TOP + D_BOTTOM;
        if (c == x0) { d += D_LEFTB; }
        if (c == x0 + len(name) + 1) { d += D_RIGHT; }
        ui_deco_at(c, DOCK_TOP - 1, d);
    }
}

// --- dialogs ------------------------------------------------------------------------

proc wm_button(x, y, label, primary) {
    local at = C_TEXT + AB * C_BUTTON;
    if (primary == 1) { at = C_ONACC + AB * C_ACCENT; }
    ui_text(x, y, " " .. label .. " ", at, OWN_DLG);
}

proc wm_compose_dialog() {
    dlg_w = 56;
    dlg_h = 9;
    dlg_x = floor((WM_COLS - dlg_w) / 2);
    dlg_y = 12;
    ui_box(dlg_x, dlg_y, dlg_x + dlg_w - 1, dlg_y + dlg_h - 1, C_TEXT + AB * C_POPUP, OWN_DLG);
    // an app-icon badge, the title, the message
    ui_set(dlg_x + 3, dlg_y + 2, G_LOGO, C_ONACC + AB * C_ACCENT, OWN_DLG);
    ui_set(dlg_x + 2, dlg_y + 2, 32, C_ONACC + AB * C_ACCENT, OWN_DLG);
    ui_set(dlg_x + 4, dlg_y + 2, 32, C_ONACC + AB * C_ACCENT, OWN_DLG);
    ui_text(dlg_x + 7, dlg_y + 2, substr(dlg_title, 1, dlg_w - 10), C_HEADER + AB * C_POPUP, OWN_DLG);
    ui_text(dlg_x + 7, dlg_y + 3, substr(dlg_l1, 1, dlg_w - 10), C_TEXT + AB * C_POPUP, OWN_DLG);
    ui_text(dlg_x + 7, dlg_y + 4, substr(dlg_l2, 1, dlg_w - 10), C_DIM + AB * C_POPUP, OWN_DLG);
    ui_text(dlg_x + 7, dlg_y + 5, substr(dlg_l3, 1, dlg_w - 10), C_DIM + AB * C_POPUP, OWN_DLG);
    local by = dlg_y + dlg_h - 2;
    local rx = dlg_x + dlg_w - 2;
    if (dlg_kind == 1) {
        // [Don't Allow] [Always Allow] [Allow Once]
        wm_button(rx - 12, by, "Allow Once", 1);
        wm_button(rx - 27, by, "Always Allow", 0);
        wm_button(rx - 41, by, "Don't Allow", 0);
    } else if (dlg_kind == 3) {
        wm_button(rx - 6, by, "Done", 1);
        local la = 0;
        local da = 0;
        if (theme == 1) { la = 1; } else { da = 1; }
        wm_button(dlg_x + 7, dlg_y + 5, "Light", la);
        wm_button(dlg_x + 15, dlg_y + 5, "Dark", da);
    } else {
        wm_button(rx - 4, by, "OK", 1);
    }
}

// --- drawing ------------------------------------------------------------------------

// compare with the previous frame and queue changed cells
proc wm_diff() {
    local n = WM_COLS * WM_ROWS;
    clear(wm_dirty);
    for i = 1 to n {
        if (own[i] != old_own[i] || ui_ch[i] != old_ch[i] || ui_at[i] != old_at[i] || wm_full == 1) {
            add(wm_dirty, i);
            old_own[i] = own[i];
            old_ch[i] = ui_ch[i];
            old_at[i] = ui_at[i];
        }
    }
    wm_full = 0;
}

// draw every queued cell
proc wm_redraw_dirty() {
    // canvas windows with many dirty cells are repainted in one pass
    clear(nr_x);   // reused: window ids needing a full canvas repaint
    clear(nr_y);   // dirty cell counts per window
    for k = 1 to len(wm_dirty) {
        local i = wm_dirty[k];
        local o = own[i];
        if (o > 0 && o != OUT_WIN && ui_ch[i] == -1 && win_kind[o] == WK_CANVAS) {
            local j = index(nr_x, o);
            if (j == 0) { add(nr_x, o); add(nr_y, 1); } else { nr_y[j] = nr_y[j] + 1; }
        }
    }
    for k = 1 to len(wm_dirty) {
        local i2 = wm_dirty[k];
        local o2 = own[i2];
        if (o2 > 0 && o2 != OUT_WIN && ui_ch[i2] == -1 && win_kind[o2] == WK_CANVAS) {
            local j2 = index(nr_x, o2);
            if (nr_y[j2] <= 6) { wm_draw_cell(i2); }
        } else {
            wm_draw_cell(i2);
        }
    }
    for k = 1 to len(nr_x) {
        if (nr_y[k] > 6) { canvas_repaint(nr_x[k]); }
    }
    clear(nr_x);
    clear(nr_y);
}

// draw one screen cell from the composed layers
proc wm_draw_cell(i) {
    local col = (i - 1) % WM_COLS;
    local row = floor((i - 1) / WM_COLS);
    local o = own[i];
    local c = ui_ch[i];
    if (c == -1) {
        if (o == OUT_WIN) {
            tty_render_cell(ide_con, row - ide_oy - out_top - 1, col - ide_ox);
        } else if (o > 0) {
            if (win_kind[o] == WK_TERM) {
                local t = win_tty[o];
                if (t > 0) { tty_render_cell(t, row - win_y[o] - 1, col - win_x[o]); }
            } else {
                canvas_repaint_rect(o, col * 8, row * 16, 8, 16);
            }
        }
        return;
    }
    if (c == -3) {
        local a = ui_at[i];
        wm_dock_cell(col, row, floor(a / 8), a % 8);
        return;
    }
    ui_cell(col * 8, row * 16, c, ui_at[i]);
}

// --- visible rectangles of canvas windows -----------------------------------------------

proc wm_cache_vis() {
    clear(vrc_win); clear(vrc_x); clear(vrc_y); clear(vrc_w); clear(vrc_h);
    for k = 1 to len(wz) {
        local w = wz[k];
        if (win_kind[w] == WK_CANVAS && win_min[w] == 0) {
            clear(vr_x); clear(vr_y); clear(vr_w); clear(vr_h);
            add(vr_x, win_x[w] * 8);
            add(vr_y, (win_y[w] + 1) * 16);
            add(vr_w, win_w[w] * 8);
            add(vr_h, (win_h[w] - 1) * 16);
            // never draw over the menu bar or the dock, or off screen
            rects_subtract(-4000, -4000, 12000, 4016);
            rects_subtract(dk_x0 * 8, DOCK_TOP * 16, (dk_x1 - dk_x0 + 1) * 8, 64);
            rects_subtract(-4000, WM_ROWS * 16, 12000, 4000);
            rects_subtract(-4000, -4000, 4000, 12000);
            rects_subtract(WM_COLS * 8, -4000, 4000, 12000);
            // subtract windows above
            for j = k + 1 to len(wz) {
                local o = wz[j];
                if (win_min[o] == 0) { rects_subtract(win_x[o] * 8, win_y[o] * 16, win_w[o] * 8, win_h[o] * 16); }
            }
            if (menu_open > 0) { rects_subtract(menu_x0 * 8, 16, (menu_x1 - menu_x0 + 1) * 8, (len(wmi_lbl) + 2) * 16); }
            if (dk_hover > 0) { rects_subtract(0, (DOCK_TOP - 1) * 16, WM_COLS * 8, 16); }
            if (dlg_kind != 0) { rects_subtract(dlg_x * 8, dlg_y * 16, dlg_w * 8, dlg_h * 16); }
            for q = 1 to len(vr_x) {
                add(vrc_win, w); add(vrc_x, vr_x[q]); add(vrc_y, vr_y[q]); add(vrc_w, vr_w[q]); add(vrc_h, vr_h[q]);
            }
        }
    }
}

// subtract rectangle B from every rectangle in vr_*
proc rects_subtract(bx, by, bw, bh) {
    clear(nr_x); clear(nr_y); clear(nr_w); clear(nr_h);
    for k = 1 to len(vr_x) {
        local ax = vr_x[k];
        local ay = vr_y[k];
        local aw = vr_w[k];
        local ah = vr_h[k];
        if (bx >= ax + aw || bx + bw <= ax || by >= ay + ah || by + bh <= ay) {
            add(nr_x, ax); add(nr_y, ay); add(nr_w, aw); add(nr_h, ah);
        } else {
            // top
            if (by > ay) { add(nr_x, ax); add(nr_y, ay); add(nr_w, aw); add(nr_h, by - ay); }
            // bottom
            if (by + bh < ay + ah) { add(nr_x, ax); add(nr_y, by + bh); add(nr_w, aw); add(nr_h, ay + ah - by - bh); }
            local my0 = ay;
            if (by > my0) { my0 = by; }
            local my1 = ay + ah;
            if (by + bh < my1) { my1 = by + bh; }
            // left
            if (bx > ax) { add(nr_x, ax); add(nr_y, my0); add(nr_w, bx - ax); add(nr_h, my1 - my0); }
            // right
            if (bx + bw < ax + aw) { add(nr_x, bx + bw); add(nr_y, my0); add(nr_w, ax + aw - bx - bw); add(nr_h, my1 - my0); }
        }
    }
    clear(vr_x); clear(vr_y); clear(vr_w); clear(vr_h);
    for k = 1 to len(nr_x) { add(vr_x, nr_x[k]); add(vr_y, nr_y[k]); add(vr_w, nr_w[k]); add(vr_h, nr_h[k]); }
    clear(nr_x); clear(nr_y); clear(nr_w); clear(nr_h);
}

// --- canvas drawing ---------------------------------------------------------------------

var cl_x0 = 0;
var cl_y0 = 0;
var cl_x1 = 0;
var cl_y1 = 0;

// draw a filled rect clipped to the current clip rect (screen px)
// True-colour fill of the already-clipped rect (x0, y0)-(x1, y1).  A pen
// stroke leaves a faint (2-3%) tail on the pixels just outside it.  Inside
// the clip rect they are painted over again, but outside it - another
// window, the title bar - repeated redraws would pile the tails up into a
// visible line.  So a side lying on the clip rect's edge gets its last
// pixel row / column from stamps, in the nearest palette colour, which
// leave no tail.
proc rgb_clipped(x0, y0, x1, y1, rgb) {
    local ix0 = x0;
    local iy0 = y0;
    local ix1 = x1;
    local iy1 = y1;
    local pc = -1;
    if (y0 <= cl_y0 || y1 >= cl_y1 || x0 <= cl_x0 || x1 >= cl_x1) { pc = gfx_nearest(rgb); }
    if (y0 <= cl_y0) { gfx_fill(x0, y0, x1 - x0, 1, pc); iy0 = y0 + 1; }
    if (y1 >= cl_y1 && y1 - 1 >= iy0) { gfx_fill(x0, y1 - 1, x1 - x0, 1, pc); iy1 = y1 - 1; }
    if (iy1 > iy0) {
        if (x0 <= cl_x0) { gfx_fill(x0, iy0, 1, iy1 - iy0, pc); ix0 = x0 + 1; }
        if (x1 >= cl_x1 && x1 - 1 >= ix0) { gfx_fill(x1 - 1, iy0, 1, iy1 - iy0, pc); ix1 = x1 - 1; }
    }
    if (ix1 > ix0 && iy1 > iy0) { gfx_rgb_fill(ix0, iy0, ix1 - ix0, iy1 - iy0, rgb); }
}

proc clip_fill(x, y, w, h, c) {
    local x0 = x;
    local y0 = y;
    local x1 = x + w;
    local y1 = y + h;
    if (x0 < cl_x0) { x0 = cl_x0; }
    if (y0 < cl_y0) { y0 = cl_y0; }
    if (x1 > cl_x1) { x1 = cl_x1; }
    if (y1 > cl_y1) { y1 = cl_y1; }
    if (x1 > x0 && y1 > y0) {
        if (c >= 256) { rgb_clipped(x0, y0, x1, y1, c - 256); }
        else { gfx_fill(x0, y0, x1 - x0, y1 - y0, c); }
    }
}

// Liang-Barsky line clipping, then a pen line
proc clip_line(xa, ya, xb, yb, c, sz) {
    local inset = floor(sz / 2);
    local x0 = cl_x0 + inset;
    local y0 = cl_y0 + inset;
    local x1 = cl_x1 - 1 - inset;
    local y1 = cl_y1 - 1 - inset;
    if (x1 < x0 || y1 < y0) { return; }
    local dx = xb - xa;
    local dy = yb - ya;
    local t0 = 0;
    local t1 = 1;
    // p/q pairs for the four edges
    local ok = 1;
    for e = 1 to 4 {
        local p = 0;
        local q = 0;
        if (e == 1) { p = 0 - dx; q = xa - x0; }
        else if (e == 2) { p = dx; q = x1 - xa; }
        else if (e == 3) { p = 0 - dy; q = ya - y0; }
        else { p = dy; q = y1 - ya; }
        if (p == 0) {
            if (q < 0) { ok = 0; }
        } else {
            local r = q / p;
            if (p < 0) {
                if (r > t1) { ok = 0; } else if (r > t0) { t0 = r; }
            } else {
                if (r < t0) { ok = 0; } else if (r < t1) { t1 = r; }
            }
        }
    }
    if (ok == 0) { return; }
    gfx_line(xa + t0 * dx, ya + t0 * dy, xa + t1 * dx, ya + t1 * dy, c, sz);
}

// visible rectangle of the window being drawn (glyphs must lie inside it)
var cv_vwin = 0;
var cv_x0 = 0;
var cv_y0 = 0;
var cv_x1 = 0;
var cv_y1 = 0;

// Stamps cannot be partially clipped: a glyph touching the clip rect is
// stamped whole, provided it lies inside the window's visible rectangle.
// Its pixels outside the clip rect are identical to what is already there.
// A glyph straddling a cell row can lie across two visible rectangles (the
// visible area is cut into bands wherever another window's edge lies), so
// the test is against all of the window's rectangles, not just the current
// one. Their edges are on cell boundaries, so each cell the glyph touches is
// wholly visible or wholly hidden, and its centre decides.
proc clip_glyph(x, y, code, fg, bg, sc) {
    local gw = 8 * sc;
    local gh = 16 * sc;
    if (bg >= 0) { clip_fill(x, y, gw, gh, bg); }
    if (code != 32 && x < cl_x1 && x + gw > cl_x0 && y < cl_y1 && y + gh > cl_y0) {
        local ok = 1;
        if (x < cv_x0 || y < cv_y0 || x + gw > cv_x1 || y + gh > cv_y1) {
            // every cell the glyph touches must be visible
            local c0 = floor(x / 8);
            local c1 = floor((x + gw - 1) / 8);
            local r0 = floor(y / 16);
            local r1 = floor((y + gh - 1) / 16);
            for r = r0 to r1 {
                for c = c0 to c1 {
                    if (ok == 1 && vis_pt(cv_vwin, c * 8 + 4, r * 16 + 8) == 0) { ok = 0; }
                }
            }
        }
        if (ok == 1) {
            local gc = fg;
            if (fg >= 256) { gc = gfx_nearest(fg - 256); }
            if (sc == 2) { gfx_glyph2(x, y, code, gc); } else { gfx_glyph(x, y, code, gc); }
        }
    }
}

// is screen point (px, py) inside a visible rectangle of canvas window w?
proc vis_pt(w, px, py) {
    for k = 1 to len(vrc_win) {
        if (vrc_win[k] == w && px >= vrc_x[k] && py >= vrc_y[k]
            && px < vrc_x[k] + vrc_w[k] && py < vrc_y[k] + vrc_h[k]) { return 1; }
    }
    return 0;
}

proc set_vis(k) {
    cv_vwin = vrc_win[k];
    cv_x0 = vrc_x[k];
    cv_y0 = vrc_y[k];
    cv_x1 = vrc_x[k] + vrc_w[k];
    cv_y1 = vrc_y[k] + vrc_h[k];
}

// Program colours: 0..15 are the terminal colours; 16 .. 16 + UI_SLOTS - 1
// are the system's UI colours (gui.color), stored as dark-theme indices and
// resolved for the current theme when drawn; 256 + RGB are true colours
// (gfx.rgb / gfx.hex), drawn with pen strokes
proc wm_col(c) {
    if (c >= 256) { return c; }
    if (c >= 16) { return c + theme * UI_SLOTS; }
    return c;
}

proc wm_colarg(v) {
    local c = floor(v);
    if (c >= 16 && c < 16 + UI_SLOTS) { return c; }
    if (c >= 256 && c < 256 + 16777216) { return c; }
    return c % 16;
}

// draw primitive at display-list position p of window w, clipped to cl_*
proc canvas_prim(w, h, p) {
    local ox = win_x[w] * 8;
    local oy = (win_y[w] + 1) * 16;
    local b = tb_ab[h] + p;
    local op = HV[b];
    local a1 = HV[b + 1];
    local a2 = HV[b + 2];
    local a3 = HV[b + 3];
    local a4 = HV[b + 4];
    local a5 = HV[b + 5];
    local a6 = HV[b + 6];
    if (op == 1) {
        clip_fill(ox, oy, win_w[w] * 8, (win_h[w] - 1) * 16, wm_col(a1));
    } else if (op == 2) {
        clip_fill(ox + a1, oy + a2, 1, 1, wm_col(a3));
    } else if (op == 3) {
        clip_line(ox + a1, oy + a2, ox + a3, oy + a4, wm_col(a5), a6);
    } else if (op == 4) {
        local c4 = wm_col(a5);
        clip_fill(ox + a1, oy + a2, a3, 1, c4);
        clip_fill(ox + a1, oy + a2 + a4 - 1, a3, 1, c4);
        clip_fill(ox + a1, oy + a2, 1, a4, c4);
        clip_fill(ox + a1 + a3 - 1, oy + a2, 1, a4, c4);
    } else if (op == 5) {
        clip_fill(ox + a1, oy + a2, a3, a4, wm_col(a5));
    } else if (op == 6) {
        // circle outline as a polygon
        local segs = round(a3 / 2);
        if (segs < 12) { segs = 12; }
        if (segs > 48) { segs = 48; }
        local px = ox + a1 + a3;
        local py = oy + a2;
        for k = 1 to segs {
            local ang = k * 360 / segs;
            local nx = ox + a1 + a3 * cos(ang);
            local ny = oy + a2 + a3 * sin(ang);
            clip_line(px, py, nx, ny, wm_col(a4), 1);
            px = nx;
            py = ny;
        }
    } else if (op == 7) {
        // filled disc as horizontal spans
        for dy = 0 - a3 to a3 {
            local hw = floor(sqrt(a3 * a3 - dy * dy) + 0.5);
            clip_fill(ox + a1 - hw, oy + a2 + dy, hw * 2 + 1, 1, wm_col(a4));
        }
    } else if (op == 8) {
        local str = a3;
        local tfg = wm_col(a4);
        local tbg = a5;
        if (tbg >= 0) { tbg = wm_col(tbg); }
        local tsc = 1;
        if (a6 == 2) { tsc = 2; }
        for k = 1 to len(str) {
            clip_glyph(ox + a1 + (k - 1) * 8 * tsc, oy + a2, ord(str[k]), tfg, tbg, tsc);
        }
    } else if (op == 9) {
        clip_poly(ox, oy, a3, wm_col(a4));
    } else if (op == 10) {
        img_draw(a5, ox + a1, oy + a2, a4);
    }
}

// filled convex polygon; pts = "x1,y1;x2,y2;..." relative to (ox, oy).
// Scanline fill: one 1-pixel-high clipped span per row.
list pg_x;
list pg_y;
proc clip_poly(ox, oy, pts, c) {
    clear(pg_x);
    clear(pg_y);
    local num = "";
    for i = 1 to len(pts) {
        local ch = pts[i];
        if (ch == ",") { add(pg_x, ox + num); num = ""; }
        else if (ch == ";") { add(pg_y, oy + num); num = ""; }
        else { num = num .. ch; }
    }
    local n = len(pg_y);
    if (n < 3) { return; }
    local y0 = pg_y[1];
    local y1 = pg_y[1];
    for i = 2 to n {
        if (pg_y[i] < y0) { y0 = pg_y[i]; }
        if (pg_y[i] > y1) { y1 = pg_y[i]; }
    }
    y0 = floor(y0);
    y1 = ceil(y1);
    if (y0 < cl_y0) { y0 = cl_y0; }
    if (y1 > cl_y1 - 1) { y1 = cl_y1 - 1; }
    local y = y0;
    while (y <= y1) {
        local sy = y + 0.5;
        local xmin = 99999;
        local xmax = -99999;
        for i = 1 to n {
            local j = i % n + 1;
            local ya = pg_y[i];
            local yb = pg_y[j];
            if ((ya <= sy && yb > sy) || (yb <= sy && ya > sy)) {
                local x = pg_x[i] + (sy - ya) * (pg_x[j] - pg_x[i]) / (yb - ya);
                if (x < xmin) { xmin = x; }
                if (x > xmax) { xmax = x; }
            }
        }
        if (xmax >= xmin) {
            local xa = round(xmin);
            clip_fill(xa, y, round(xmax) - xa + 1, 1, c);
        }
        y += 1;
    }
}

const PRIM = 7;

// draw a primitive that was just appended, into all visible rects of w
proc canvas_draw_new(w, p) {
    if (win_min[w] == 1) { return; }
    local h = win_dl[w];
    for k = 1 to len(vrc_win) {
        if (vrc_win[k] == w) {
            cl_x0 = vrc_x[k];
            cl_y0 = vrc_y[k];
            cl_x1 = vrc_x[k] + vrc_w[k];
            cl_y1 = vrc_y[k] + vrc_h[k];
            set_vis(k);
            canvas_prim(w, h, p);
        }
    }
}

// repaint the whole visible part of a canvas window
proc canvas_repaint(w) {
    for k = 1 to len(vrc_win) {
        if (vrc_win[k] == w) {
            set_vis(k);
            canvas_repaint_clip(w, vrc_x[k], vrc_y[k], vrc_w[k], vrc_h[k]);
        }
    }
}

// repaint the part of canvas w inside rect (screen px), honouring visibility
proc canvas_repaint_rect(w, x, y, rw, rh) {
    for k = 1 to len(vrc_win) {
        if (vrc_win[k] == w) {
            local x0 = vrc_x[k];
            local y0 = vrc_y[k];
            local x1 = x0 + vrc_w[k];
            local y1 = y0 + vrc_h[k];
            if (x > x0) { x0 = x; }
            if (y > y0) { y0 = y; }
            if (x + rw < x1) { x1 = x + rw; }
            if (y + rh < y1) { y1 = y + rh; }
            set_vis(k);
            if (x1 > x0 && y1 > y0) { canvas_repaint_clip(w, x0, y0, x1 - x0, y1 - y0); }
        }
    }
}

proc canvas_repaint_clip(w, x, y, rw, rh) {
    cl_x0 = x;
    cl_y0 = y;
    cl_x1 = x + rw;
    cl_y1 = y + rh;
    local bgc = wm_col(win_bg[w]);
    if (bgc >= 256) { rgb_clipped(x, y, x + rw, y + rh, bgc - 256); } else { gfx_fill(x, y, rw, rh, bgc); }
    local h = win_dl[w];
    if (h == 0) { return; }
    local n = tb_an[h];
    local p = 1;
    while (p <= n) {
        canvas_prim(w, h, p);
        p += PRIM;
    }
}

// --- frame update -------------------------------------------------------------------------

proc wm_tick() {
    if (gui == 0) { return; }
    wm_mouse();
    // terminal windows close when their programs have exited
    for w = 1 to MAX_WIN {
        if (win_used[w] == 1 && win_kind[w] == WK_TERM && win_auto[w] == 1) {
            if (wm_tty_alive(win_tty[w]) == 0) { wm_close(w); }
        }
    }
    local clk = pad_left_char(now("hour"), 2, "0") .. ":" .. pad_left_char(now("minute"), 2, "0");
    if (clk != clock_last) { wm_need = 1; }
    // the text cursor follows the focused terminal
    cur_t = wm_focus_tty();
    if (ide_win > 0) { ide_tick_hosted(); }
    // the mouse wheel goes to the canvas window under the pointer
    if (wheel != 0) {
        local o = wm_owner_at(floor(m_x / 8), floor(m_y / 16));
        if (o > 0 && o != OUT_WIN && win_kind[o] == WK_CANVAS) { wm_event(o, "wheel", 0, wheel, ""); }
        wheel = 0;
    }
    if (wm_need == 1) { wm_update(); }
}

proc wm_update() {
    wm_need = 0;
    wm_compose();
    wm_diff();
    wm_redraw_dirty();
    // the text cursor and the IDE's caret may have been painted over
    cur_drawn = 0;
    caret_on = 0;
}

proc wm_tty_alive(t) {
    if (t == 0) { return 0; }
    for s = 1 to MAX_PROC {
        if (p_state[s] != PS_FREE && p_tty[s] == t) { return 1; }
    }
    return 0;
}

// --- mouse --------------------------------------------------------------------------------

proc wm_mouse() {
    local mx = round(mouse_x() + SCR_W / 2);
    local my = round(SCR_H / 2 - mouse_y());
    if (mx < 0) { mx = 0; }
    if (my < 0) { my = 0; }
    if (mx > SCR_W - 1) { mx = SCR_W - 1; }
    if (my > SCR_H - 1) { my = SCR_H - 1; }
    m_moved = 0;
    if (mx != m_x || my != m_y) { m_moved = 1; }
    m_x = mx;
    m_y = my;
    m_was = m_down;
    if (mouse_down()) { m_down = 1; } else { m_down = 0; }
    local cx = floor(mx / 8);
    local cy = floor(my / 16);
    if (m_down == 1 && m_was == 0) { wm_press(cx, cy); }
    else if (m_down == 1 && m_moved == 1) { wm_drag(cx, cy); }
    else if (m_down == 0 && m_was == 1) { wm_release(cx, cy); }
    if (m_moved == 1) { wm_hover(cx, cy); }
    // pointer moves over the top window, for canvases that track them
    if (m_moved == 1 && m_down == 0) {
        local tw = wm_top();
        if (tw > 0 && win_trk[tw] == 1 && wm_owner_at(cx, cy) == tw && cy > win_y[tw]) {
            wm_event(tw, "move", mx - win_x[tw] * 8, my - (win_y[tw] + 1) * 16, "");
        }
    }
}

// menus follow the pointer; the dock shows the name of the icon under it
proc wm_hover(cx, cy) {
    if (menu_open > 0) {
        local sel = 0;
        if (cx > menu_x0 && cx < menu_x1 && cy >= 2 && cy < len(wmi_lbl) + 2) {
            sel = cy - 1;
            if (wmi_lbl[sel] == "-" || wmi_cmd[sel] == "-") { sel = 0; }
        }
        if (sel != menu_sel) { menu_sel = sel; wm_need = 1; }
        // sliding along the menu bar switches menus
        if (cy == 0) {
            local k = wm_bar_hit(cx);
            if (k > 0 && k != menu_open) { menu_open = k; menu_sel = 0; wm_need = 1; }
        }
        return;
    }
    local h = 0;
    if (drag_mode == 0) { h = wm_dock_hit(cx, cy); }
    if (h != dk_hover) { dk_hover = h; wm_need = 1; }
}

proc wm_press(cx, cy) {
    local o = wm_owner_at(cx, cy);
    if (o == OUT_WIN) { o = ide_win; }
    // dialogs are modal
    if (dlg_kind != 0) {
        if (o == OWN_DLG) { wm_dialog_click(cx, cy); }
        return;
    }
    if (menu_open > 0) {
        if (o == OWN_MENU && cy >= 2) {
            local k = cy - 1;
            if (k >= 1 && k <= len(wmi_lbl)) { wm_menu_pick(k); }
            return;
        }
        local was = menu_open;
        menu_open = 0;
        wm_need = 1;
        if (cy == 0 && wm_bar_hit(cx) == was) { return; }
    }
    if (o == OWN_BAR) {
        local k2 = wm_bar_hit(cx);
        if (k2 > 0) { menu_open = k2; menu_sel = 0; dk_hover = 0; wm_need = 1; }
        return;
    }
    if (o == OWN_DOCK) {
        local d = wm_dock_hit(cx, cy);
        if (d > 0) { wm_dock_click(d); }
        return;
    }
    if (o > 0) {
        local w2 = o;
        if (w2 != wm_top()) { wm_raise(w2); }
        local x = win_x[w2];
        local y = win_y[w2];
        if (cy == y) {
            if (cx == x + 1) { wm_user_close(w2); return; }
            if (cx == x + 3) { win_min[w2] = 1; wm_need = 1; return; }
            if (cx == x + 5) { wm_toggle_max(w2); return; }
            // double-click the title bar to zoom
            local t = now_secs();
            if (t - t_click < 0.4 && t_click_w == w2) { t_click = 0; wm_toggle_max(w2); return; }
            t_click = t;
            t_click_w = w2;
            drag_mode = 1;
            drag_win = w2;
            drag_dx = cx - x;
            drag_dy = cy - y;
            return;
        }
        // bottom-right corner: resize
        if (cx == x + win_w[w2] - 1 && cy == y + win_h[w2] - 1) {
            drag_mode = 2;
            drag_win = w2;
            return;
        }
        if (win_kind[w2] == WK_CANVAS) {
            drag_mode = 3;
            drag_win = w2;
            wm_event(w2, "mousedown", m_x - x * 8, m_y - (y + 1) * 16, "");
        } else if (win_kind[w2] == WK_IDE) {
            drag_mode = 4;
            drag_win = w2;
            ide_grab = 1;
        }
    }
}

proc wm_drag(cx, cy) {
    local w = drag_win;
    if (drag_mode == 0 || win_used[w] == 0) { return; }
    if (drag_mode == 1) {
        local nx = cx - drag_dx;
        local ny = cy - drag_dy;
        if (ny < 1) { ny = 1; }
        if (ny > WM_ROWS - 2) { ny = WM_ROWS - 2; }
        if (nx < 8 - win_w[w]) { nx = 8 - win_w[w]; }
        if (nx > WM_COLS - 8) { nx = WM_COLS - 8; }
        if (nx != win_x[w] || ny != win_y[w]) {
            win_max[w] = 0;
            wm_set_geom(w, nx, ny, win_w[w], win_h[w]);
        }
    } else if (drag_mode == 2) {
        local nw = cx - win_x[w] + 1;
        local nh = cy - win_y[w] + 1;
        local minw = 20;
        local minh = 4;
        if (win_kind[w] == WK_IDE) { minw = 72; minh = 18; }
        if (nw < minw) { nw = minw; }
        if (nh < minh) { nh = minh; }
        if (win_x[w] + nw > WM_COLS) { nw = WM_COLS - win_x[w]; }
        if (win_y[w] + nh > WM_ROWS) { nh = WM_ROWS - win_y[w]; }
        if (nw != win_w[w] || nh != win_h[w]) {
            win_max[w] = 0;
            wm_set_geom(w, win_x[w], win_y[w], nw, nh);
        }
    } else if (drag_mode == 3) {
        wm_event(w, "drag", m_x - win_x[w] * 8, m_y - (win_y[w] + 1) * 16, "");
    }
}

proc wm_release(cx, cy) {
    if (drag_mode == 3 && win_used[drag_win] == 1) {
        local w = drag_win;
        wm_event(w, "mouseup", m_x - win_x[w] * 8, m_y - (win_y[w] + 1) * 16, "");
    }
    drag_mode = 0;
    ide_grab = 0;
}

// the user clicked the red traffic light
proc wm_user_close(w) {
    if (win_kind[w] == WK_TERM) {
        wm_kill_window_procs(w);
        wm_close(w);
        return;
    }
    if (win_kind[w] == WK_IDE) { wm_close(w); return; }
    // ask the program; if it has no owner any more just close
    if (proc_slot(win_pid[w]) == 0) { wm_close(w); return; }
    wm_event(w, "close", 0, 0, "");
}

proc wm_menu_pick(k) {
    local cmd = wmi_cmd[k];
    if (cmd == "-" || wmi_lbl[k] == "-") { return; }
    menu_open = 0;
    wm_need = 1;
    wm_launch(cmd, wmi_lbl[k]);
}

// a dock icon was clicked: bring the app forward, or start it
proc wm_dock_click(k) {
    local best = 0;
    for i = 1 to len(wz) {
        if (win_app[wz[i]] == k) { best = wz[i]; }
    }
    if (best > 0) { wm_raise(best); return; }
    wm_launch(dk_cmd[k], dk_name[k]);
}

// launch a desktop command: "@term [cmd]", "@ide", "@settings", window
// actions, power actions, or a GUI program
proc wm_launch(cmd, label) {
    local top = wm_top();
    if (cmd == "@exit") { wm_stop_all(); return; }
    if (cmd == "@reboot") { sys_power(1); return; }
    if (cmd == "@halt") { sys_power(0); return; }
    if (cmd == "@ide") { wm_open_ide(""); return; }
    if (cmd == "@ref") { wm_open_ide("/usr/share/doc/whisker/reference.txt"); return; }
    if (cmd == "@quick") { wm_open_ide("/usr/share/doc/whisker/quickstart.txt"); return; }
    if (cmd == "@settings") { dlg_kind = 3; dlg_title = "System Settings"; dlg_l1 = "Appearance"; dlg_l2 = ""; dlg_l3 = ""; wm_need = 1; return; }
    if (cmd == "@light") { wm_set_theme(1); return; }
    if (cmd == "@dark") { wm_set_theme(0); return; }
    if (cmd == "@close") { if (top > 0) { wm_user_close(top); } return; }
    if (cmd == "@min") { if (top > 0) { win_min[top] = 1; wm_need = 1; } return; }
    if (cmd == "@zoom") { if (top > 0) { wm_toggle_max(top); } return; }
    if (substr(cmd, 1, 4) == "@win") {
        local w = substr(cmd, 5, len(cmd)) * 1;
        if (w > 0 && win_used[w] == 1) { wm_raise(w); }
        return;
    }
    if (substr(cmd, 1, 5) == "@term") {
        local c = str_trim(substr(cmd, 6, len(cmd)));
        local title = label;
        if (len(c) == 0) { title = "Terminal"; }
        local tw = wm_open_term(c, title, -1, -1, 100, 30);
        if (tw > 0 && len(c) == 0) { win_app[tw] = 2; }
        return;
    }
    // GUI program: started by init with no terminal; errors appear in a message box
    local s = proc_slot(1);
    local ek = p_err_k[s];
    p_err_k[s] = FD_MSG;
    local pid = proc_start_cmd(s, cmd, FD_MSG, 0);
    p_err_k[s] = ek;
    if (pid == 0) {
        if (dlg_kind == 0) { wm_message("Cannot start", cmd, "command not found", ""); }
        return;
    }
    local cs = proc_slot(pid);
    p_tty[cs] = 0;
    p_err_k[cs] = FD_MSG;
    p_in_k[cs] = FD_NULL;
    p_pgid[cs] = pid;
}

// --- dialogs ---------------------------------------------------------------------------

proc wm_caps_dialog(path, cap, desc) {
    dlg_kind = 1;
    dlg_title = "Allow \"" .. fs_name_of_path(path) .. "\" to " .. desc .. "?";
    dlg_l1 = path;
    dlg_l2 = "Capability: " .. cap;
    dlg_l3 = "";
    wm_need = 1;
}

proc fs_name_of_path(p) {
    local k = len(p);
    while (k > 1 && p[k] != "/") { k -= 1; }
    if (p[k] == "/") { return substr(p, k + 1, len(p)); }
    return p;
}

proc wm_caps_dialog_close() {
    dlg_kind = 0;
    wm_need = 1;
}

proc wm_message(title, l1, l2, l3) {
    dlg_kind = 2;
    dlg_title = title;
    dlg_l1 = l1;
    dlg_l2 = l2;
    dlg_l3 = l3;
    wm_need = 1;
}

proc wm_dialog_click(cx, cy) {
    local by = dlg_y + dlg_h - 2;
    local rx = dlg_x + dlg_w - 2;
    if (dlg_kind == 3 && cy == dlg_y + 5) {
        if (cx >= dlg_x + 7 && cx < dlg_x + 14) { wm_set_theme(1); }
        else if (cx >= dlg_x + 15 && cx < dlg_x + 21) { wm_set_theme(0); }
        return;
    }
    if (cy != by) { return; }
    if (dlg_kind == 1) {
        if (cx >= rx - 12 && cx < rx) { wm_dialog_answer("y"); }
        else if (cx >= rx - 27 && cx < rx - 13) { wm_dialog_answer("a"); }
        else if (cx >= rx - 41 && cx < rx - 28) { wm_dialog_answer("n"); }
    } else if (dlg_kind == 3) {
        if (cx >= rx - 6 && cx < rx) { dlg_kind = 0; wm_need = 1; }
    } else if (cx >= rx - 4 && cx < rx) {
        dlg_kind = 0;
        wm_need = 1;
    }
}

proc wm_dialog_answer(a) {
    dlg_kind = 0;
    wm_need = 1;
    caps_answer(a);
}

// keyboard input when no terminal has focus
proc wm_key(ev) {
    if (dlg_kind == 1) {
        if (ev == "y" || ev == "enter") { wm_dialog_answer("y"); }
        else if (ev == "n" || ev == "escape") { wm_dialog_answer("n"); }
        else if (ev == "a") { wm_dialog_answer("a"); }
        return;
    }
    if (dlg_kind >= 2) {
        if (ev == "enter" || ev == "escape" || ev == " ") { dlg_kind = 0; wm_need = 1; }
        return;
    }
    if (menu_open > 0) {
        local n = len(wmi_lbl);
        if (ev == "escape") { menu_open = 0; wm_need = 1; }
        else if (ev == "left arrow" || ev == "right arrow") {
            if (ev == "left arrow") { menu_open -= 1; } else { menu_open += 1; }
            if (menu_open < 1) { menu_open = 5; }
            if (menu_open > 5) { menu_open = 1; }
            menu_sel = 0;
            wm_need = 1;
        } else if (ev == "up arrow" || ev == "down arrow") {
            local step = 1;
            if (ev == "up arrow") { step = -1; }
            repeat (n) {
                menu_sel += step;
                if (menu_sel < 1) { menu_sel = n; }
                if (menu_sel > n) { menu_sel = 1; }
                if (wmi_lbl[menu_sel] != "-" && wmi_cmd[menu_sel] != "-") { break; }
            }
            wm_need = 1;
        } else if (ev == "enter" && menu_sel > 0) { wm_menu_pick(menu_sel); }
        return;
    }
    if (ev == "^ ") { menu_open = 1; menu_sel = 0; dk_hover = 0; wm_need = 1; return; }
    local w = wm_top();
    if (w > 0 && win_kind[w] == WK_CANVAS) { wm_event(w, "key", 0, 0, ev); }
}

// --- gui.* / gfx.* system calls ------------------------------------------------------------

// window id argument i, checked to belong to the calling process
proc nat_win(i, fname) {
    local w = nat_num(i, fname);
    if (vm_raised == 1) { return 0; }
    if (w < 1 || w > MAX_WIN || win_used[w] == 0 || win_kind[w] != WK_CANVAS || win_pid[w] != p_pid[vm_slot]) {
        vm_raise("bad argument #" .. i .. " to '" .. fname .. "' (not one of your windows)");
        return 0;
    }
    return w;
}

// append a primitive to window w's display list and draw it
proc dl_add(w, op, a1, a2, a3, a4, a5, a6) {
    local h = win_dl[w];
    local p = tb_an[h] + 1;
    table_append(h, op, TNUM);
    table_append(h, a1, TNUM);
    table_append(h, a2, TNUM);
    table_append(h, a3, TSTR);
    table_append(h, a4, TNUM);
    table_append(h, a5, TNUM);
    table_append(h, a6, TNUM);
    canvas_draw_new(w, p);
    if (tb_an[h] > DL_MAX) {
        // too much history: keep drawing but stop recording
        tb_an[h] = p - 1;
    }
}

proc nat_gui(id) {
    if (id >= N_IMAGE_NEW && id <= N_IMAGE_COLORS) {
        nat_image(id);
        return;
    }
    local s = vm_slot;
    if (id < N_GFX_CLEAR && id != N_GUI_TERMINAL && gui == 0 && id == N_GUI_WINDOW) {
        vm_raise("the desktop is not running (start it with 'startx')");
        return;
    }
    switch (id) {
        case N_GUI_WINDOW: {
            if (nat_cap("gui") == 1) {
                local title = nat_str(1, "gui.window");
                local pw = nat_optnum(2, 240, "gui.window");
                local ph = nat_optnum(3, 160, "gui.window");
                if (vm_raised == 0) {
                    local w = wm_new_window(title, WK_CANVAS, -1, -1, ceil(pw / 8), ceil(ph / 16) + 1, p_pid[s]);
                    if (w == 0) { nat_fail("too many windows"); }
                    else {
                        local dl = table_new(0);
                        tb_pin[dl] = 1;
                        win_dl[w] = dl;
                        win_bg[w] = 0;
                        local pn = p_name[s];
                        local sp = str_find(pn, " ", 1);
                        if (sp > 0) { pn = substr(pn, 1, sp - 1); }
                        local app = index(dk_cmd, pn);
                        if (app > 0) { win_app[w] = app; }
                        nat_retn(w);
                    }
                }
            }
        }
        case N_GUI_TERMINAL: {
            if (gui == 0) { vm_raise("the desktop is not running"); }
            else if (nat_cap("gui") == 1) {
                local cmd = "";
                if (nat_argc >= 1) { cmd = nat_str(1, "gui.terminal"); }
                local tw = wm_open_term(cmd, cmd, -1, -1, 100, 30);
                if (tw == 0) { nat_fail("too many windows"); } else { nat_retn(tw); }
            }
        }
        case N_GUI_COLOR: {
            // the number of a system UI colour, for gfx.* calls
            local nm = str_lower(nat_str(1, "gui.color"));
            local cv = -1;
            if (nm == "window" || nm == "background") { cv = U_EDBG; }
            else if (nm == "sidebar" || nm == "panel") { cv = U_PANEL; }
            else if (nm == "text") { cv = U_TEXT; }
            else if (nm == "dim" || nm == "secondary") { cv = U_DIM; }
            else if (nm == "accent") { cv = U_ACCENT; }
            else if (nm == "ontext") { cv = U_ONACC; }
            else if (nm == "selection") { cv = U_ACTIVE; }
            else if (nm == "hover") { cv = U_HOVER; }
            else if (nm == "border") { cv = U_BORDER; }
            else if (nm == "button") { cv = U_BUTTON; }
            else if (nm == "folder") { cv = U_FOLDER; }
            else if (nm == "red") { cv = U_TLRED; }
            else if (nm == "yellow") { cv = U_TLYEL; }
            else if (nm == "green") { cv = U_TLGRN; }
            else if (nm == "error") { cv = U_ERRFG; }
            else if (nm == "paper") { cv = U_ICWHITE; }
            else if (nm == "ink") { cv = U_ICDARK; }
            if (vm_raised == 0) {
                if (cv < 0) { vm_raise("gui.color: unknown colour '" .. nm .. "'"); } else { nat_retn(cv); }
            }
        }
        case N_GUI_IDE: {
            if (gui == 0 || IDE_HOSTED == 0) { vm_raise("the desktop is not running"); }
            else if (nat_cap("gui") == 1) {
                local ipath = "";
                if (nat_argc >= 1) {
                    local ino = fs_lookup(nat_str(1, "gui.ide"), p_cwd[s]);
                    if (ino > 0) { ipath = fs_path(ino); }
                }
                if (vm_raised == 0) { wm_open_ide(ipath); }
            }
        }
        case N_GUI_TRACK: {
            // gui.track(win [, on]): deliver "move" events while the pointer is over the window
            local tw2 = nat_win(1, "gui.track");
            if (tw2 > 0) {
                local on = 1;
                if (nat_argc >= 2 && vm_truthy(nat_v(2), nat_t(2)) == 0) { on = 0; }
                win_trk[tw2] = on;
            }
        }
        case N_GUI_LAUNCH: {
            // start a desktop program (with arguments), e.g. "preview a.simg"
            if (gui == 0 || IDE_HOSTED == 0) { vm_raise("the desktop is not running"); }
            else if (nat_cap("gui") == 1) {
                local lc = nat_str(1, "gui.launch");
                if (vm_raised == 0) { wm_launch(lc, lc); }
            }
        }
        case N_GFX_RGB: {
            local cr = floor(nat_num(1, "gfx.rgb"));
            local cg = floor(nat_num(2, "gfx.rgb"));
            local cb = floor(nat_num(3, "gfx.rgb"));
            if (vm_raised == 0) {
                cr = imax(0, imin(255, cr)); cg = imax(0, imin(255, cg)); cb = imax(0, imin(255, cb));
                nat_retn(256 + cr * 65536 + cg * 256 + cb);
            }
        }
        case N_GFX_HEX: {
            local hv = parse_hex(nat_str(1, "gfx.hex"));
            if (vm_raised == 0) {
                if (hv < 0) { nat_retnil(); } else { nat_retn(256 + hv); }
            }
        }
        case N_GFX_TORGB: {
            local tc = nat_num(1, "gfx.torgb");
            if (vm_raised == 0) {
                local rgb = img_rgb(wm_colarg(tc));
                nat_retn(floor(rgb / 65536));
                nat_retn(floor(rgb / 256) % 256);
                nat_retn(rgb % 256);
                nat_rets(hex6(rgb));
            }
        }
        case N_GFX_IMAGE: {
            local wi = nat_win(1, "gfx.image");
            local im = nat_img_arg(2, "gfx.image");
            local ix = floor(nat_optnum(3, 0, "gfx.image"));
            local iy = floor(nat_optnum(4, 0, "gfx.image"));
            local isc = nat_optnum(5, 1, "gfx.image");
            if (wi > 0 && vm_raised == 0) {
                if (isc <= 0) { isc = 1; }
                tb_pin[im] = 1;
                dl_add(wi, 10, ix, iy, "", isc, im, 0);
            }
        }
        case N_GUI_CLOSE: {
            local w2 = nat_win(1, "gui.close");
            if (w2 > 0) { wm_close(w2); }
        }
        case N_GUI_EVENT, N_GUI_WAITEVENT: {
            local w3 = nat_win(1, "gui.event");
            if (w3 > 0) {
                local k = index(ev_win, w3);
                if (k > 0) {
                    local e = table_new(p_pid[s]);
                    tset_s(e, "type", ev_type[k]);
                    tset_n(e, "x", ev_x[k]);
                    tset_n(e, "y", ev_y[k]);
                    if (len(ev_key[k]) > 0) { tset_s(e, "key", ev_key[k]); }
                    del(ev_win, k); del(ev_type, k); del(ev_x, k); del(ev_y, k); del(ev_key, k);
                    nat_rett(e);
                } else if (id == N_GUI_WAITEVENT) {
                    nat_block(BLK_IO);
                } else {
                    nat_retnil();
                }
            }
        }
        case N_GUI_SIZE: {
            local w4 = nat_win(1, "gui.size");
            if (w4 > 0) { nat_retn(win_w[w4] * 8); nat_retn((win_h[w4] - 1) * 16); }
        }
        case N_GUI_TITLE: {
            local w5 = nat_win(1, "gui.title");
            if (w5 > 0) { win_title[w5] = nat_str(2, "gui.title"); wm_need = 1; }
        }
        case N_GUI_ACTIVE: {
            local w6 = nat_win(1, "gui.active");
            if (w6 > 0) { nat_retb(w6 == wm_top() && dlg_kind == 0 && menu_open == 0); }
        }
        case N_GFX_CLEAR: {
            local w7 = nat_win(1, "gfx.clear");
            local c = wm_colarg(nat_optnum(2, 0, "gfx.clear"));
            if (w7 > 0 && vm_raised == 0) {
                dl_unpin_images(win_dl[w7]);
                tb_an[win_dl[w7]] = 0;
                win_bg[w7] = c;
                dl_add(w7, 1, c, 0, "", 0, 0, 0);
            }
        }
        case N_GFX_PIXEL: {
            local w8 = nat_win(1, "gfx.pixel");
            if (w8 > 0) {
                local x = floor(nat_num(2, "gfx.pixel"));
                local y = floor(nat_num(3, "gfx.pixel"));
                local c2 = wm_colarg(nat_optnum(4, 15, "gfx.pixel"));
                if (vm_raised == 0) { dl_add(w8, 2, x, y, c2, 0, 0, 0); }
            }
        }
        case N_GFX_LINE: {
            local w9 = nat_win(1, "gfx.line");
            if (w9 > 0) {
                local x1 = nat_num(2, "gfx.line");
                local y1 = nat_num(3, "gfx.line");
                local x2 = nat_num(4, "gfx.line");
                local y2 = nat_num(5, "gfx.line");
                local c3 = wm_colarg(nat_optnum(6, 15, "gfx.line"));
                local sz = nat_optnum(7, 1, "gfx.line");
                if (vm_raised == 0) { dl_add(w9, 3, x1, y1, x2, y2, c3, sz); }
            }
        }
        case N_GFX_RECT, N_GFX_FILL: {
            local w10 = nat_win(1, "gfx.rect");
            if (w10 > 0) {
                local rx = floor(nat_num(2, "gfx.rect"));
                local ry = floor(nat_num(3, "gfx.rect"));
                local rw = floor(nat_num(4, "gfx.rect"));
                local rh = floor(nat_num(5, "gfx.rect"));
                local c4 = wm_colarg(nat_optnum(6, 15, "gfx.rect"));
                if (vm_raised == 0 && rw > 0 && rh > 0) {
                    if (id == N_GFX_RECT) { dl_add(w10, 4, rx, ry, rw, rh, c4, 0); }
                    else { dl_add(w10, 5, rx, ry, rw, rh, c4, 0); }
                }
            }
        }
        case N_GFX_CIRCLE, N_GFX_DISC: {
            local w11 = nat_win(1, "gfx.circle");
            if (w11 > 0) {
                local cx = floor(nat_num(2, "gfx.circle"));
                local cy = floor(nat_num(3, "gfx.circle"));
                local r = floor(nat_num(4, "gfx.circle"));
                local c5 = wm_colarg(nat_optnum(5, 15, "gfx.circle"));
                if (vm_raised == 0 && r >= 0) {
                    if (id == N_GFX_CIRCLE) { dl_add(w11, 6, cx, cy, r, c5, 0, 0); }
                    else { dl_add(w11, 7, cx, cy, r, c5, 0, 0); }
                }
            }
        }
        case N_GFX_TEXT: {
            local w12 = nat_win(1, "gfx.text");
            if (w12 > 0) {
                local tx = floor(nat_num(2, "gfx.text"));
                local ty = floor(nat_num(3, "gfx.text"));
                local str = vm_tostr(nat_v(4), nat_t(4));
                local fg = wm_colarg(nat_optnum(5, 15, "gfx.text"));
                local bg = -1;
                if (nat_argc >= 6 && nat_t(6) != TNIL) { bg = wm_colarg(nat_num(6, "gfx.text")); }
                local tsc = 1;
                if (nat_argc >= 7 && nat_t(7) != TNIL && nat_num(7, "gfx.text") >= 2) { tsc = 2; }
                if (vm_raised == 0) { dl_add(w12, 8, tx, ty, str, fg, bg, tsc); }
            }
        }
        case N_GFX_BATCH: { batch_pid = p_pid[s]; }
        case N_GFX_FLUSH: { if (batch_pid == p_pid[s]) { batch_pid = 0; } }
        case N_GFX_POLY: {
            local w13 = nat_win(1, "gfx.poly");
            if (w13 > 0) {
                local pt = nat_table(2, "gfx.poly");
                local c6 = wm_colarg(nat_optnum(3, 15, "gfx.poly"));
                if (vm_raised == 0) {
                    local enc = "";
                    local np = floor(tb_an[pt] / 2);
                    for k = 1 to np {
                        enc = enc .. round(HV[tb_ab[pt] + k * 2 - 1]) .. "," .. round(HV[tb_ab[pt] + k * 2]) .. ";";
                    }
                    if (np >= 3) { dl_add(w13, 9, 0, 0, enc, c6, 0, 0); }
                }
            }
        }
        default: { vm_raise("native " .. nat_names[id] .. " not implemented"); }
    }
}

// show program error output (stderr of desktop programs) in a message box
proc msg_write(s) {
    local clean = "";
    local i = 1;
    local n = len(s);
    while (i <= n) {
        local c = s[i];
        if (c == "\e") {
            // skip ESC [ ... letter
            i += 2;
            while (i <= n && contains("0123456789;", s[i]) && len(s[i]) == 1) { i += 1; }
        } else if (c == "\n") {
            clean = clean .. " ";
        } else {
            clean = clean .. c;
        }
        i += 1;
    }
    clean = str_trim(clean);
    if (len(clean) == 0) { return; }
    if (gui == 0) {
        tty_write(con, s);
        return;
    }
    wm_message("Program message", substr(clean, 1, 46), substr(clean, 47, 92), substr(clean, 93, 138));
}
