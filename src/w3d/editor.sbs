// ===========================================================================
// editor.sbs - the Whisker 3D engine's user interface (included inside
// sprite Kernel, after the Whisker IDE, which provides the menu bar, the
// code editor, the output panel, prompts and dialogs; ide.sbs calls the
// w3e_* hooks below when W3D_ENGINE is 1)
//
// Modes (w3e_mode): 0 the start screen (projects), 1 the scene editor, 2
// code (the IDE itself), 3 playing (the game on the whole stage).
//
// Scene editor layout (cells):
//   row 0         menu bar, Scene / Code switch, Play
//   row 1         tool bar: tools, snap, the scene's name
//   left          the object list (Project, Scene, then the objects)
//   middle        the 3D viewport (cells marked -3; drawn by w3e_view)
//   right         the inspector for what is selected
//   bottom        the output panel (what scripts print), the status line
// ===========================================================================

const HI_W = 26;             // object list width
const IN_W = 40;             // inspector width
const T_SELECT = 0;          // tools
const T_MOVE = 1;
const T_ROTATE = 2;
const T_SCALE = 3;

var w3e_back = 1;            // mode to return to after playing
var w3e_ready = 0;
var sel = 0;                 // selected object (0 = none)
var sel_what = 1;            // 0 an object, 1 the scene, 2 the project
var tool = T_MOVE;
var snap = 1;                // snap moves to 0.25 / rotations to 15 degrees
var sc_dirty = 0;            // the scene has unsaved changes
var sc_stamp = "";           // the scene file as last loaded or saved (see w3e_scene_sync)
var ovl_was = 0;             // a menu / dialog was open last frame
var vp_c0 = HI_W;            // viewport in cells
var vp_c1 = 0;
var vp_r0 = 2;
var vp_r1 = 0;
var hi_top = 1;              // object list scroll
var in_top = 1;              // inspector scroll
var ec_tx = 0;               // editor camera: orbit target, distance, angles
var ec_ty = 0.5;
var ec_tz = 0;
var ec_dist = 14;
var ec_yaw = 35;
var ec_pitch = 28;
var dg = 0;                  // drag: 0 none, 1 orbit, 2 pan, 3 move, 4 rotate, 5 scale, 6 click
var dg_x = 0;                // pointer at the press
var dg_y = 0;
var dg_moved = 0;
var dg_a = 0;                // values at the press
var dg_b = 0;
var dg_c = 0;
var dg_d = 0;
var dg_e = 0;
var dg_f = 0;
var st_sel = 1;              // start screen: selected project
var np_name = "";            // new project being made
var np_res = 720;
var np_tpl = "starter";
var st_stage = 0;            // 0 project list, 1 new project form

list hi_ob;                  // object list rows: object id, -1 project, -2 scene
list in_key;                 // inspector rows: field key ("" = heading)
list in_lab;
list in_val;
list st_proj;                // projects on the start screen
list st_ex;                  // examples
list un_text;                // scene undo (scene text before each change)

const SCRIPT_TEMPLATE = "-- This script runs for every object that uses it.\n-- self is the object; store its own values in it (self.speed = 5).\n\nfunction start(self)\nend\n\nfunction update(self, dt)\nend\n";

// --- start up ------------------------------------------------------------------------

proc w3e_init() {
    w3e_mode = 0;
    out_h = OUT_SMALL;
    ide_layout();
    w3e_layout();
    w3e_ready = 1;
    st_scan();
    // a project saved inside this Scratch project (the export list, kept
    // when the .sb3 is saved) comes back
    if (len(w3d_export) > 0) {
        clear(bl_out);
        for i = 1 to len(w3d_export) { add(bl_out, w3d_export[i]); }
        local nm = bundle_name();
        if (len(nm) > 0 && fs_lookup("/projects/" .. safe_name(nm), 1) == 0) {
            bundle_import("/projects/" .. safe_name(nm));
            st_scan();
        }
    }
    tty_write(ide_con, "\e[97mWhisker 3D\e[0m - make 3D games in Whisker.  "
        .. "Open or make a project; \e[93mHelp\e[0m has the guide.\n");
}

proc w3e_layout() {
    vp_c0 = HI_W;
    vp_c1 = IC - IN_W - 1;
    vp_r0 = 2;
    vp_r1 = out_top - 1;
    w3e_vdirty = 1;
}

// a name usable as a folder name
proc safe_name(s) {
    local out = "";
    for i = 1 to len(s) {
        local ch = s[i];
        if (contains("abcdefghijklmnopqrstuvwxyz0123456789-_ ", str_lower(ch))) { out = out .. ch; }
    }
    if (len(out) == 0) { out = "Game"; }
    return out;
}

// projects in /projects and examples in /examples, for the start screen
proc st_scan() {
    clear(st_proj);
    clear(st_ex);
    local d = fs_lookup("/projects", 1);
    if (d == 0) { d = fs_mkdir_p("/projects"); }
    fs_list(d);
    for i = 1 to len(fs_tmp) {
        if (fs_type[fs_tmp[i]] == FT_DIR) { add(st_proj, fs_name[fs_tmp[i]]); }
    }
    local e = fs_lookup("/examples", 1);
    if (e > 0) {
        fs_list(e);
        for i = 1 to len(fs_tmp) {
            if (fs_type[fs_tmp[i]] == FT_DIR) { add(st_ex, fs_name[fs_tmp[i]]); }
        }
    }
}

// --- projects --------------------------------------------------------------------------

proc w3e_open(dir) {
    w3_proj = dir;
    if (pj_load_settings() == 0) { dialog(1, "Cannot open the project", pj_err, "", ""); return 0; }
    ide_root = w3_proj;
    ide_proj = w3_proj;
    p_cwd[host] = fs_lookup(w3_proj, 1);
    clear(tr_exp);
    add(tr_exp, w3_proj);
    add(tr_exp, w3_proj .. "/scripts");
    add(tr_exp, w3_proj .. "/scenes");
    // close the tabs of the last project
    while (len(tab_path) > 0) { close_tab(1); }
    tree_build();
    if (w3e_load_scene(pj_scene) == 0) { return 0; }
    w3e_mode = 1;
    w3e_reset_view();
    ide_status("Opened " .. pj_name);
    ide_full = 1;
    ide_dirty = 1;
    return 1;
}

proc w3e_load_scene(path) {
    if (scene_load(path) == 0) {
        dialog(1, "Cannot open the scene", sc_err, "", "");
        return 0;
    }
    if (len(sc_err) > 0) { tty_write(ide_con, "\e[93m" .. path .. ": " .. sc_err .. "\e[0m\n"); }
    sc_stamp = w3e_scene_file();
    clear(un_text);
    sel = 0;
    sel_what = 1;
    sc_dirty = 0;
    w3e_vdirty = 1;
    ide_dirty = 1;
    return 1;
}

proc w3e_save_scene() {
    if (len(sc_path) == 0) { return; }
    if (scene_save(sc_path) == 1) { sc_dirty = 0; sc_stamp = w3e_scene_file(); } else { ide_status(pj_err); }
    ide_dirty = 1;
}

// the scene file's text ("" if it is missing)
proc w3e_scene_file() {
    if (len(sc_path) == 0) { return ""; }
    return pj_read(sc_path);
}

// the scene file was edited as text in the code view: load it again, so
// that saving the scene does not overwrite those edits
proc w3e_scene_sync() {
    if (len(sc_path) == 0) { return; }
    local t = w3e_scene_file();
    if (w3_ino == 0 || streq(t, sc_stamp) == 1) { return; }
    w3e_load_scene(sc_path);
    ide_status("Reloaded " .. sc_path .. " (edited as text)");
}

// copy a folder of the file system (templates, examples) to dest
proc copy_tree(src, dest) {
    local s = fs_lookup(src, 1);
    if (s == 0) { return 0; }
    local d = fs_lookup(dest, 1);
    if (d > 0) { return 0; }
    local dp = fs_mkdir_p(dest);
    if (dp == 0) { return 0; }
    fs_remove(dp, 1);
    local parent = fs_lookup_parent(dest, 1);
    fs_copy(s, parent, fs_base);
    return 1;
}

// make a new project from the start screen's form
proc w3e_new_project() {
    local nm = safe_name(np_name);
    local dir = "/projects/" .. nm;
    if (fs_lookup(dir, 1) > 0) { dialog(1, "New project", "There is already a project called " .. nm .. ".", "", ""); return; }
    if (copy_tree("/templates/" .. np_tpl, dir) == 0) { fs_mkdir_p(dir); }
    w3_proj = dir;
    pj_load_settings();
    pj_name = np_name;
    pj_res = np_res;
    res_apply();
    pj_save_settings();
    st_scan();
    st_stage = 0;
    w3e_open(dir);
}

// --- scene changes and undo -----------------------------------------------------------

proc w3e_change() {
    add(un_text, scene_text());
    if (len(un_text) > 40) { del(un_text, 1); }
    sc_dirty = 1;
    w3e_vdirty = 1;
    ide_dirty = 1;
}

proc w3e_undo() {
    if (len(un_text) == 0) { ide_status("Nothing to undo"); return; }
    local keep = sel;
    local t = un_text[len(un_text)];
    del(un_text, len(un_text));
    scene_parse(t);
    if (keep > len(ob_name)) { keep = 0; }
    sel = keep;
    if (sel == 0 && sel_what == 0) { sel_what = 1; }
    sc_dirty = 1;
    w3e_vdirty = 1;
    ide_dirty = 1;
}

// add an object in front of the editor camera's target
proc w3e_add(kind, mesh, name) {
    w3e_change();
    local o = ob_new(ob_unique(name), kind);
    if (kind == K_MESH) { ob_setmesh(o, mesh); }
    ob_px[o] = snapv(ec_tx);
    ob_pz[o] = snapv(ec_tz);
    ob_py[o] = 0.5;
    if (mesh == "plane") { ob_py[o] = 0; ob_sx[o] = 10; ob_sz[o] = 10; }
    if (kind == K_LIGHT) { ob_py[o] = 3; ob_col[o] = 16767306; }
    if (kind == K_CAMERA) { ob_vis[o] = 0; ob_py[o] = 3; ob_pz[o] = ec_tz - 8; ob_rx[o] = 15; }
    if (kind == K_MESH && mesh != "plane") { ob_col[o] = 9425151; }
    sel = o;
    sel_what = 0;
    return o;
}

proc snapv(v) {
    if (snap == 0) { return round(v * 1000) / 1000; }
    return round(v * 4) / 4;
}

proc snapa(v) {
    if (snap == 0) { return round(v * 10) / 10; }
    return round(v / 15) * 15;
}

proc w3e_delete() {
    if (sel_what != 0 || sel == 0) { return; }
    w3e_change();
    ob_alive[sel] = 0;
    if (sel == cam_ob) { cam_ob = 0; }
    // keep the slots dense in the file: rebuild from the text
    scene_parse(scene_text());
    sel = 0;
    sel_what = 1;
}

proc w3e_duplicate() {
    if (sel_what != 0 || sel == 0) { return; }
    w3e_change();
    local o = ob_copy(sel, ob_unique(ob_name[sel]));
    ob_px[o] = ob_px[o] + 1;
    sel = o;
}

proc w3e_reset_view() {
    ec_tx = 0;
    ec_ty = 0.5;
    ec_tz = 0;
    ec_dist = 14;
    ec_yaw = 35;
    ec_pitch = 28;
    w3e_vdirty = 1;
}

proc w3e_focus() {
    if (sel_what != 0 || sel == 0) { return; }
    ec_tx = ob_px[sel];
    ec_ty = ob_py[sel];
    ec_tz = ob_pz[sel];
    local s = abs(ob_sx[sel]);
    if (abs(ob_sy[sel]) > s) { s = abs(ob_sy[sel]); }
    if (abs(ob_sz[sel]) > s) { s = abs(ob_sz[sel]); }
    ec_dist = 3 + s * 2.5;
    w3e_vdirty = 1;
}

