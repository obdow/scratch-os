// M1 test: console tty with line editing + echo
include "kbd.sbs";
sprite Kernel {
    costumes "glyphs";
    include "gfx.sbs";
    include "str.sbs";
    include "tty.sbs";
    var con = 0;
    var frames = 0;
    proc wm_owner_at(cx, cy) { return 0; }
    proc kbd_poll() {
        while (len(kb_queue) > 0) {
            local ev = kb_queue[1];
            del(kb_queue, 1);
            last_key_time = days2000() * 86400;
            if (ev == "caps lock") {
                kb_caps = 1 - kb_caps;
            } else if (ev == "^c") {
                tty_write(con, "^C\n");
                tty_line_begin(con);
            } else {
                tty_key(con, ev);
            }
        }
    }
    proc tick() {
        frames += 1;
        kbd_poll();
        if (tty_getline(con) == 1) {
            tty_write(con, "\e[93mYou typed:\e[0m [" .. tty_got .. "]\n");
            tty_write(con, "\e[92m$ \e[0m");
            tty_line_begin(con);
        }
        tty_render();
        tty_cursor_update();
    }
    on flag {
        gfx_init();
        tty_init();
        con = tty_alloc(60, 22, 0, 0, 0);
        tty_vis[con] = 1;
        cur_t = con;
        tty_write(con, "\e[97;44m ScratchOS tty test \e[0m\n");
        for i = 1 to 30 { tty_write(con, "line " .. i .. " \e[3" .. (i % 8) .. "mcolour\e[0m\n"); }
        tty_write(con, "\e[92m$ \e[0m");
        tty_line_begin(con);
        forever { tick(); }
    }
}
