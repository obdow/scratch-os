proc wm_owner_at(cx, cy) { return 0; }
proc wm_start(s) { sh_errmsg(s, "startx: no window manager yet"); return 1; }
proc wm_stop_all() { }
proc caps_init() { }
proc caps_command(ok, oi, ek, ei) { return 0; }
proc wm_focus_tty() { return con; }
proc wm_key(ev) { }
