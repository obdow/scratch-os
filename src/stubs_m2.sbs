proc vm_init() { }
proc vm_release(s) { }
proc vm_run(s, n) { }
proc vm_spawn(parent, ino) {
    sh_errmsg(parent, fs_name[ino] .. ": cannot execute (Whisker VM not installed yet)");
    return 0;
}
