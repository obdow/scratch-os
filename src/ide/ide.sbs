// ===========================================================================
// ide.sbs - the Whisker IDE user interface (included inside sprite Kernel)
//
// Screen (SCR_COLS x SCR_ROWS cells, 120 x 34 on the IDE's 960x544 stage):
//   row 0        menu bar
//   row 1        tabs + Run/Stop button
//   rows 2..     file tree (left, optional) | editor (gutter, text, scrollbar)
//   out_top      output panel header, then the output tty (program I/O)
//   row 21       status bar / prompt line
// Overlays: drop-down menus, dialogs, autocomplete, graphics preview.
//
// The screen is composed into sc_ch / sc_at every time something changes and
// diffed against the previous frame (so_ch / so_at); only changed cells are
// stamped.  Cells shown by the output tty are marked -1 (the tty draws
// them itself), cells of the graphics preview -2 (canvas display list).
// ===========================================================================

// size of the IDE in cells and its top-left cell on the screen: the whole
// stage in the stand-alone IDE, a window's content area inside ScratchOS
// (IDE_HOSTED = 1), where ide_resize / ide_move follow the window
var IC = SCR_COLS;
var IR = SCR_ROWS;
var ROW_STATUS = SCR_ROWS - 1;
var ide_ox = 0;
var ide_oy = 0;
const ROW_TABS = 1;
const TREE_W = 24;
const GUT_W = 5;
const OUT_WIN = 99;       // own[] value for output-panel cells
const OUT_SMALL = 4;      // output panel heights (rows)
const OUT_MEDIUM = 8;
const OUT_LARGE = 16;

list sc_ch;
list sc_at;
list so_ch;
list so_at;

// --- layout ------------------------------------------------------------------------
var show_tree = 1;
var out_h = OUT_MEDIUM;
var out_top = 25;
var ed_x0 = 0;
var ed_y0 = 2;
var ed_rows = 13;
var txt_x0 = 0;
var txt_w = 0;
var ide_dirty = 1;        // recompose needed
var ide_full = 1;         // redraw everything
var focus = 0;            // 0 editor, 1 output, 2 tree, 3 graphics

// theme colours: C_* in ui.sbs

// --- tabs / buffers ------------------------------------------------------------------
list tab_path;
list tab_text;
list tab_cx;
list tab_cy;
list tab_top;
list tab_left;
list tab_dirty;
list tab_ro;
var cur_tab = 0;

list ed;                  // lines of the active buffer
var ecx = 1;              // cursor column (1-based, may be len + 1)
var ecy = 1;              // cursor line
var etop = 1;
var eleft = 1;
var sel_on = 0;
var sax = 1;              // selection anchor
var say = 1;
var want_x = 0;           // preferred column for up/down

// undo / redo (snapshots of whole buffers)
list u_tab;
list u_text;
list u_cx;
list u_cy;
list r_tab;
list r_text;
list r_cx;
list r_cy;
var last_edit = "";
var last_edit_line = 0;

var clipboard = "";

// syntax highlighting
list hl_code;             // CP437 code per char of the line being highlighted
list hl_fg;               // colour per char
list ls_state;            // lexer state at the start of each line (0, 1 comment, 2 string)
var ls_valid = 0;
list lib_words;           // built-in function names (without module)
list mod_words;

// file tree
list tr_path;
list tr_name;
list tr_depth;
list tr_dir;
list tr_exp;              // expanded directories
var tr_top = 1;
var tr_sel = 0;

// menus
list mn_title = ["File", "Edit", "Run", "View", "Help"];
list mn_x;
list mi_menu;
list mi_label;
list mi_key;
list mi_cmd;
var imenu_open = 0;        // index into mn_title, 0 = closed
var imenu_sel = 0;         // selected item (index into mi_*)

// prompt line (status row)
var pr_kind = "";
var pr_label = "";
var pr_buf = "";
var find_text = "";
var repl_from = "";

// dialog
var idlg_kind = 0;         // 0 none, 1 message, 2 yes/no/cancel
var idlg_title = "";
list idlg_lines;
var idlg_cmd = "";         // command run when the user answers "yes"
var idlg_no = "";          // command run on "no"
var idlg_x = 0;
var idlg_y = 0;
var idlg_w = 0;
var idlg_h = 0;

// autocomplete
var ac_open = 0;
list ac_items;
var ac_sel = 1;
var ac_word = "";
var ac_x = 0;
var ac_y = 0;

// running programs
var host = 0;             // slot of the IDE host process (parent of programs)
var run_pid = 0;
var run_t0 = 0;
var err_line = 0;
var err_msg = "";
var err_path = "";
var status_msg = "";
var status_until = 0;

// graphics preview
var cv_win = 0;
var cv_x = 0;
var cv_y = 0;
var cv_w = 0;
var cv_h = 0;

// mouse / caret
var mx = 0;
var my = 0;
var mdown = 0;
var mwas = 0;
var mdrag = 0;            // 1 editor selection, 2 editor scrollbar, 3 graphics, 4 tree scrollbar
var last_click = 0;
var last_click_x = -1;
var last_click_y = -1;
var sb_grab = 0;          // scrollbar drag: pointer offset inside the thumb (pixels)
var ide_con = 0;          // the Output panel tty
var ide_ready = 0;        // ide_init has run
var ide_grab = 0;         // hosted: a mouse press that began inside the IDE is held

// folders (the stand-alone IDE has its own file system; inside ScratchOS the
// IDE works in the user's home folder)
var ide_root = "/";
var ide_proj = "/projects";
var ide_docs = "/docs";
var wheel = 0;            // mouse wheel notches (+ down), from the arrow-key hats
var caret_on = 0;
var caret_c = 0;
var caret_r = 0;

// ===========================================================================
// boot
// ===========================================================================

// stand-alone IDE: start the kernel services, then the IDE on the whole stage
proc ide_boot() {
    tty_init();
    fs_init();
    fs_load_rootfs();
    proc_init();
    shell_init();
    vm_init();
    caps_init();
    wm_init();
    gui = 1;
    ide_init();
    con = ide_con;              // kernel messages go to the Output panel
}

// IDE state (once); the stage or window geometry is set by the caller
proc ide_init() {
    if (IDE_HOSTED == 1) {
        ide_root = "/home/user";
        ide_proj = "/home/user/projects";
        ide_docs = "/usr/share/doc/whisker";
    }
    ide_con = tty_alloc(IC, 5, 0, 0, OUT_WIN);
    tty_vis[ide_con] = 1;
    // the host process owns the programs we start; it never runs itself
    host = proc_alloc("whisker-ide", 9, 0);
    p_state[host] = PS_BLOCKED;
    p_block[host] = BLK_PROMPT;
    p_tty[host] = ide_con;
    p_in_k[host] = FD_TTY; p_in_i[host] = ide_con;
    p_out_k[host] = FD_TTY; p_out_i[host] = ide_con;
    p_err_k[host] = FD_TTY; p_err_i[host] = ide_con;
    p_caps[host] = "|files|proc|gui|system|";
    p_cwd[host] = fs_lookup(ide_proj, 1);
    ide_alloc();
    ide_menus_init();
    ide_words_init();
    clear(tab_path); clear(tab_text); clear(tab_cx); clear(tab_cy); clear(tab_top); clear(tab_left);
    clear(tab_dirty); clear(tab_ro);
    clear(tab_kind); clear(tab_view); clear(tab_rtop);
    clear(u_tab); clear(u_text); clear(u_cx); clear(u_cy);
    clear(r_tab); clear(r_text); clear(r_cx); clear(r_cy);
    clear(tr_exp);
    clear(tr_path);
    add(tr_exp, ide_proj);
    if (IDE_HOSTED == 1) { add(tr_exp, "/home/user/examples"); } else { add(tr_exp, "/examples"); }
    if (IDE_HOSTED == 0) { ide_theme(0); }
    ide_layout();
    tree_build();
    open_file(ide_proj .. "/main.wsk");
    tty_write(ide_con, "\e[97mWhisker IDE\e[0m - " .. OS_NAME .. " " .. OS_VERSION .. " runtime.  "
        .. "\e[93mCtrl+Enter\e[0m runs, \e[93mEsc\e[0m opens the menu.\n");
    tty_write(ide_con, "New here?  Help > Quick start, or open a file in the examples folder.\n");
    ide_ready = 1;
    ide_full = 1;
    ide_dirty = 1;
}

// (re)build the screen buffers for the current IC x IR
proc ide_alloc() {
    clear(sc_ch); clear(sc_at); clear(so_ch); clear(so_at);
    repeat (IC * IR) { add(sc_ch, 32); add(sc_at, 0); add(so_ch, -9); add(so_at, -9); }
}

// hosted: the window's content area moved / changed size (cells)
proc ide_move(ox, oy) {
    ide_ox = ox;
    ide_oy = oy;
    if (ide_con > 0) {
        tty_ox[ide_con] = ide_ox * 8;
        tty_oy[ide_con] = (ide_oy + out_top + 1) * 16;
    }
}

proc ide_resize(cols, rows) {
    if (cols == IC && rows == IR) { return; }
    IC = cols;
    IR = rows;
    ROW_STATUS = IR - 1;
    // keep at least a few editor rows
    while (out_h > OUT_SMALL && IR - out_h - 4 < 4) { out_h -= 1; }
    ide_alloc();
    ide_layout();
}

// drawn before ide_boot (main.sbs yields one frame so it shows while booting)
proc ide_splash() {
    gfx_init();
    ide_theme(0);
    gfx_fill(0, 0, SCR_W, SCR_H, C_EDBG);
    local cx = SCR_W / 2;
    local cy = SCR_H / 2;
    gfx_fill(cx - 16, cy - 56, 32, 32, C_ACCENT);
    gfx_glyph(cx - 4, cy - 48, ord("W"), C_ONACC);
    local t = "Whisker IDE";
    for i = 1 to len(t) { gfx_glyph(cx - 44 + (i - 1) * 8, cy - 8, ord(t[i]), C_TEXT); }
    local u = "loading...";
    for i = 1 to len(u) { gfx_glyph(cx - 40 + (i - 1) * 8, cy + 16, ord(u[i]), C_DIM); }
}

// 0 dark, 1 light: UI colours, editor colours and the 16 terminal colours
proc ide_theme(n) {
    ui_theme(n);
    ls_valid = 0;
    rv_valid = 0;
    if (ide_con > 0) { tty_full[ide_con] = 1; }
    if (cv_win > 0) { canvas_repaint(cv_win); }
    ide_full = 1;
    ide_dirty = 1;
}

// built-in names for highlighting / autocomplete
proc ide_words_init() {
    clear(lib_words);
    clear(mod_words);
    for i = 1 to len(nat_names) {
        local n = nat_names[i];
        if (!(contains(n, "."))) { add(lib_words, n); }
    }
    for i = 1 to len(nat_mods) { add(mod_words, nat_mods[i]); }
    add(lib_words, "pairs");
    add(lib_words, "ipairs");
    add(lib_words, "self");
    add(lib_words, "arg");
}

proc mi(menu, label, key, cmd) {
    add(mi_menu, menu);
    add(mi_label, label);
    add(mi_key, key);
    add(mi_cmd, cmd);
}

proc ide_menus_init() {
    clear(mi_menu); clear(mi_label); clear(mi_key); clear(mi_cmd);
    mi(1, "New file...", "", "new");
    mi(1, "Save", "Ctrl+S", "save");
    mi(1, "Save as...", "", "saveas");
    mi(1, "Rename...", "", "rename");
    mi(1, "Delete file", "", "delete");
    mi(1, "Close tab", "", "close");
    mi(1, "-", "", "");
    mi(1, "Export (list)", "", "export");
    mi(1, "Import (list)", "", "import");
    mi(2, "Undo", "Ctrl+Z", "undo");
    mi(2, "Redo", "Ctrl+Y", "redo");
    mi(2, "-", "", "");
    mi(2, "Cut", "Ctrl+X", "cut");
    mi(2, "Copy", "Ctrl+C", "copy");
    mi(2, "Paste", "Ctrl+V", "paste");
    mi(2, "Select all", "Ctrl+A", "selall");
    mi(2, "-", "", "");
    mi(2, "Find...", "Ctrl+F", "find");
    mi(2, "Find next", "", "findnext");
    mi(2, "Replace...", "", "replace");
    mi(2, "Go to line...", "Ctrl+G", "goto");
    mi(2, "-", "", "");
    mi(2, "Toggle comment", "Ctrl+/", "comment");
    mi(2, "Duplicate line", "Ctrl+D", "dupline");
    mi(2, "Delete line", "", "delline");
    mi(2, "Indent", "", "indent");
    mi(2, "Unindent", "", "unindent");
    mi(3, "Run", "Ctrl+Enter", "run");
    mi(3, "Stop", "Esc", "stop");
    mi(3, "Check syntax", "", "check");
    mi(3, "Go to error", "", "goerr");
    mi(3, "Clear output", "", "clearout");
    mi(4, "File tree", "", "tree");
    mi(4, "Text preview / edit", "Ctrl+E", "preview");
    mi(4, "Output: small", "", "out3");
    mi(4, "Output: medium", "", "out5");
    mi(4, "Output: large", "", "out9");
    mi(4, "Output: hidden", "", "out0");
    mi(4, "Theme: dark", "", "theme0");
    mi(4, "Theme: light", "", "theme1");
    mi(5, "Quick start", "", "help");
    mi(5, "Language reference", "", "ref");
    mi(5, "Keyboard shortcuts", "", "keys");
    mi(5, "About", "", "about");
    clear(mn_x);
    local x = 5;
    for i = 1 to len(mn_title) {
        add(mn_x, x);
        x += len(mn_title[i]) + 2;
    }
}

// ===========================================================================
// layout
// ===========================================================================

proc ide_layout() {
    if (out_h > 0) { out_top = ROW_STATUS - out_h - 1; } else { out_top = ROW_STATUS; }
    ed_x0 = 0;
    if (show_tree == 1) { ed_x0 = TREE_W; }
    ed_rows = out_top - ed_y0;
    txt_x0 = ed_x0 + GUT_W;
    txt_w = IC - txt_x0 - 1;
    if (out_h > 0) {
        tty_resize(ide_con, IC, out_h);
        tty_ox[ide_con] = ide_ox * 8;
        tty_oy[ide_con] = (ide_oy + out_top + 1) * 16;
        tty_vis[ide_con] = 1;
    } else {
        tty_vis[ide_con] = 0;
    }
    if (cv_win > 0) { cv_place(); }
    ide_scroll_to_cursor();
    ide_full = 1;
    ide_dirty = 1;
}

// ===========================================================================
// buffers and tabs
// ===========================================================================

proc join_lines() {
    local out = "";
    local n = len(ed);
    for i = 1 to n {
        out = out .. ed[i];
        if (i < n) { out = out .. "\n"; }
    }
    return out;
}

proc split_into_ed(text) {
    clear(ed);
    local n = len(text);
    local start = 1;
    for i = 1 to n {
        if (text[i] == "\n") {
            add(ed, substr(text, start, i - 1));
            start = i + 1;
        }
    }
    add(ed, substr(text, start, n));
    ls_valid = 0;
    rv_valid = 0;
}

proc tab_store() {
    if (cur_tab == 0) { return; }
    tab_text[cur_tab] = join_lines();
    tab_cx[cur_tab] = ecx;
    tab_cy[cur_tab] = ecy;
    tab_top[cur_tab] = etop;
    tab_left[cur_tab] = eleft;
    tab_rtop[cur_tab] = rv_top;
}

proc tab_activate(i) {
    if (i == cur_tab) { return; }
    tab_store();
    cur_tab = i;
    if (i == 0) { clear(ed); add(ed, ""); ecx = 1; ecy = 1; etop = 1; eleft = 1; }
    else {
        split_into_ed(tab_text[i]);
        ecx = tab_cx[i];
        ecy = tab_cy[i];
        etop = tab_top[i];
        eleft = tab_left[i];
        rv_top = tab_rtop[i];
    }
    rv_valid = 0;
    sel_on = 0;
    ac_open = 0;
    last_edit = "";
    focus = 0;
    ide_dirty = 1;
}

proc open_file(path) {
    local i = index(tab_path, path);
    if (i > 0) { tab_activate(i); return 1; }
    local ino = fs_lookup(path, 1);
    if (ino == 0 || fs_type[ino] == FT_DIR) { ide_status("Cannot open " .. path); return 0; }
    tab_store();
    add(tab_path, fs_path(ino));
    add(tab_text, fs_data[ino]);
    add(tab_cx, 1); add(tab_cy, 1); add(tab_top, 1); add(tab_left, 1);
    add(tab_dirty, 0);
    local ro = 0;
    if (substr(fs_path(ino), 1, len(ide_docs) + 1) == ide_docs .. "/") { ro = 1; }
    add(tab_ro, ro);
    // text files open in the rendered preview, programs in the editor
    local kind = path_is_text(fs_path(ino));
    add(tab_kind, kind);
    // empty text files open in the editor (there is nothing to preview)
    if (kind == 1 && len(fs_data[ino]) > 0) { add(tab_view, 1); } else { add(tab_view, 0); }
    add(tab_rtop, 1);
    local n = len(tab_path);
    cur_tab = 0;
    tab_activate(n);
    // drop a trailing empty line left by a final newline
    if (len(ed) > 1 && len(ed[len(ed)]) == 0) { del(ed, len(ed)); }
    return 1;
}

proc close_tab(i) {
    if (i == 0) { return; }
    if (i == cur_tab) { cur_tab = 0; }
    del(tab_path, i); del(tab_text, i); del(tab_cx, i); del(tab_cy, i);
    del(tab_top, i); del(tab_left, i); del(tab_dirty, i); del(tab_ro, i);
    del(tab_kind, i); del(tab_view, i); del(tab_rtop, i);
    // forget its undo history and renumber the rest
    local k = 1;
    while (k <= len(u_tab)) {
        if (u_tab[k] == i) { del(u_tab, k); del(u_text, k); del(u_cx, k); del(u_cy, k); }
        else { if (u_tab[k] > i) { u_tab[k] = u_tab[k] - 1; } k += 1; }
    }
    clear(r_tab); clear(r_text); clear(r_cx); clear(r_cy);
    if (cur_tab > i) { cur_tab -= 1; }
    if (cur_tab == 0) {
        local nt = len(tab_path);
        if (i <= nt) { tab_activate(i); } else { tab_activate(nt); }
    }
    ide_dirty = 1;
}

proc save_tab() {
    if (cur_tab == 0) { return 0; }
    if (tab_ro[cur_tab] == 1) { ide_status("This file is read-only (use Save as)"); return 0; }
    local path = tab_path[cur_tab];
    local ino = fs_lookup(path, 1);
    if (ino == 0) { ino = fs_create(path, FT_FILE, 1); }
    if (ino == 0) { ide_status("Cannot save: " .. fs_err); return 0; }
    fs_data[ino] = join_lines() .. "\n";
    fs_mtime[ino] = fs_now();
    tab_dirty[cur_tab] = 0;
    ide_status("Saved " .. path);
    tree_build();
    return 1;
}

proc mark_dirty() {
    if (cur_tab > 0) { tab_dirty[cur_tab] = 1; }
    if (err_line > 0 && streq(err_path, tab_path[cur_tab]) == 1) { err_line = 0; }
}

// ===========================================================================
// undo
// ===========================================================================

// take a snapshot before an edit; typing on one line is merged into one step
proc undo_mark(kind) {
    if (cur_tab == 0) { return; }
    if (kind == last_edit && ecy == last_edit_line && kind != "other") { return; }
    last_edit = kind;
    last_edit_line = ecy;
    add(u_tab, cur_tab);
    add(u_text, join_lines());
    add(u_cx, ecx);
    add(u_cy, ecy);
    if (len(u_tab) > 80) { del(u_tab, 1); del(u_text, 1); del(u_cx, 1); del(u_cy, 1); }
    clear(r_tab); clear(r_text); clear(r_cx); clear(r_cy);
}

proc undo_step(redo) {
    local i = len(u_tab);
    if (redo == 1) { i = len(r_tab); }
    // newest entry of this tab
    while (i > 0) {
        if (redo == 0 && u_tab[i] == cur_tab) { break; }
        if (redo == 1 && r_tab[i] == cur_tab) { break; }
        i -= 1;
    }
    if (i == 0) {
        if (redo == 1) { ide_status("Nothing to redo"); } else { ide_status("Nothing to undo"); }
        return;
    }
    local txt = "";
    local cx = 1;
    local cy = 1;
    if (redo == 0) {
        txt = u_text[i]; cx = u_cx[i]; cy = u_cy[i];
        del(u_tab, i); del(u_text, i); del(u_cx, i); del(u_cy, i);
        add(r_tab, cur_tab); add(r_text, join_lines()); add(r_cx, ecx); add(r_cy, ecy);
    } else {
        txt = r_text[i]; cx = r_cx[i]; cy = r_cy[i];
        del(r_tab, i); del(r_text, i); del(r_cx, i); del(r_cy, i);
        add(u_tab, cur_tab); add(u_text, join_lines()); add(u_cx, ecx); add(u_cy, ecy);
    }
    split_into_ed(txt);
    ecy = cy;
    ecx = cx;
    clamp_cursor();
    sel_on = 0;
    last_edit = "";
    mark_dirty();
    ide_scroll_to_cursor();
    ide_dirty = 1;
}

// ===========================================================================
// editing primitives
// ===========================================================================

proc clamp_cursor() {
    if (ecy < 1) { ecy = 1; }
    if (ecy > len(ed)) { ecy = len(ed); }
    if (ecx < 1) { ecx = 1; }
    if (ecx > len(ed[ecy]) + 1) { ecx = len(ed[ecy]) + 1; }
}

proc lines_changed(from) {
    rv_valid = 0;
    if (ls_valid > from - 1) { ls_valid = from - 1; }
    if (ls_valid < 0) { ls_valid = 0; }
}

// is (y1, x1) before (y2, x2)?
proc pos_before(y1, x1, y2, x2) {
    if (y1 < y2) { return 1; }
    if (y1 == y2 && x1 < x2) { return 1; }
    return 0;
}

// normalized selection: s_y1/s_x1 .. s_y2/s_x2 (end exclusive)
var s_y1 = 0;
var s_x1 = 0;
var s_y2 = 0;
var s_x2 = 0;
proc sel_bounds() {
    if (pos_before(say, sax, ecy, ecx) == 1) {
        s_y1 = say; s_x1 = sax; s_y2 = ecy; s_x2 = ecx;
    } else {
        s_y1 = ecy; s_x1 = ecx; s_y2 = say; s_x2 = sax;
    }
}

proc sel_empty() {
    if (sel_on == 0) { return 1; }
    if (say == ecy && sax == ecx) { return 1; }
    return 0;
}

proc sel_text() {
    if (sel_empty() == 1) { return ""; }
    sel_bounds();
    if (s_y1 == s_y2) { return substr(ed[s_y1], s_x1, s_x2 - 1); }
    local out = substr(ed[s_y1], s_x1, len(ed[s_y1]));
    for y = s_y1 + 1 to s_y2 - 1 { out = out .. "\n" .. ed[y]; }
    out = out .. "\n" .. substr(ed[s_y2], 1, s_x2 - 1);
    return out;
}

proc del_sel() {
    if (sel_empty() == 1) { sel_on = 0; return; }
    sel_bounds();
    local head = substr(ed[s_y1], 1, s_x1 - 1);
    local tail = substr(ed[s_y2], s_x2, len(ed[s_y2]));
    ed[s_y1] = head .. tail;
    local k = s_y2 - s_y1;
    repeat (k) { del(ed, s_y1 + 1); }
    ecy = s_y1;
    ecx = s_x1;
    sel_on = 0;
    lines_changed(s_y1);
    mark_dirty();
}

// insert text (may contain newlines) at the cursor
proc ins_text(text) {
    local line = ed[ecy];
    local head = substr(line, 1, ecx - 1);
    local tail = substr(line, ecx, len(line));
    local first = 1;
    local start = 1;
    local n = len(text);
    local y = ecy;
    for i = 1 to n {
        if (text[i] == "\n") {
            local piece = substr(text, start, i - 1);
            if (first == 1) { ed[y] = head .. piece; first = 0; }
            else { insert(ed, y, piece); }
            y += 1;
            start = i + 1;
        }
    }
    local last = substr(text, start, n);
    if (first == 1) {
        ed[y] = head .. last .. tail;
        ecx = len(head) + len(last) + 1;
    } else {
        insert(ed, y, last .. tail);
        ecx = len(last) + 1;
    }
    lines_changed(ecy);
    ecy = y;
    mark_dirty();
}

proc indent_of(s) {
    local n = 0;
    while (n < len(s) && s[n + 1] == " ") { n += 1; }
    return n;
}

// does the line open a block (so the next line should be indented)?
proc opens_block(s) {
    local t = str_trim(s);
    if (len(t) == 0) { return 0; }
    // strip a trailing comment
    local c = str_find(t, "--", 1);
    if (c > 1) { t = str_trim(substr(t, 1, c - 1)); }
    local n = len(t);
    if (n >= 4 && streq(substr(t, n - 3, n), "then") == 1) { return 1; }
    if (n >= 2 && streq(substr(t, n - 1, n), "do") == 1) { return 1; }
    if (n >= 4 && streq(substr(t, n - 3, n), "else") == 1) { return 1; }
    if (n >= 6 && streq(substr(t, n - 5, n), "repeat") == 1) { return 1; }
    if (t[n] == "{" || t[n] == "(") { return 1; }
    if (str_find(t, "function", 1) > 0 && t[n] == ")" && str_find(t, "end", 1) == 0) { return 1; }
    return 0;
}

proc rep_space(n) {
    local s = "";
    repeat (n) { s = s .. " "; }
    return s;
}

// typing a closing keyword at the start of a line dedents it
proc auto_dedent() {
    local line = ed[ecy];
    local t = str_trim(line);
    if (!(t == "end" || t == "else" || t == "elseif" || t == "until" || t == "}")) { return; }
    if (streq(t, "end") == 0 && streq(t, "else") == 0 && streq(t, "elseif") == 0 && streq(t, "until") == 0 && t != "}") { return; }
    if (ecx != len(line) + 1) { return; }
    // find the previous non-blank line
    local y = ecy - 1;
    while (y >= 1 && len(str_trim(ed[y])) == 0) { y -= 1; }
    if (y < 1) { return; }
    local want = indent_of(ed[y]);
    if (opens_block(ed[y]) == 0) { want -= 2; }
    if (want < 0) { want = 0; }
    local have = indent_of(line);
    if (have > want) {
        ed[ecy] = rep_space(want) .. t;
        ecx = want + len(t) + 1;
        lines_changed(ecy);
    }
}

proc type_char(ch) {
    if (cur_tab == 0) { return; }
    if (tab_ro[cur_tab] == 1) { ide_status("Read-only file"); return; }
    if (sel_empty() == 0) { undo_mark("other"); del_sel(); }
    else { undo_mark("type"); sel_on = 0; }
    local line = ed[ecy];
    ed[ecy] = substr(line, 1, ecx - 1) .. ch .. substr(line, ecx, len(line));
    ecx += 1;
    lines_changed(ecy);
    mark_dirty();
    if (tab_kind[cur_tab] != 0) { return; }
    if (char_class[ord(ch) + 1] == 1) { auto_dedent(); }
    if (ch == ".") { ac_show(0); }
    else if (ac_open == 1) { ac_show(0); }
}

proc key_enter() {
    if (tab_ro[cur_tab] == 1) { return; }
    undo_mark("other");
    if (sel_empty() == 0) { del_sel(); }
    sel_on = 0;
    local line = ed[ecy];
    local before = substr(line, 1, ecx - 1);
    local ind = indent_of(line);
    if (ind > ecx - 1) { ind = ecx - 1; }
    if (tab_kind[cur_tab] == 0 && opens_block(before) == 1) { ind += 2; }
    if (tab_kind[cur_tab] == 2 && yarn_opens(before) == 1) { ind += 2; }
    local after = str_trim_left(substr(line, ecx, len(line)));
    ed[ecy] = before;
    insert(ed, ecy + 1, rep_space(ind) .. after);
    lines_changed(ecy);
    ecy += 1;
    ecx = ind + 1;
    mark_dirty();
}

proc str_trim_left(s) {
    local i = 1;
    while (i <= len(s) && s[i] == " ") { i += 1; }
    return substr(s, i, len(s));
}

proc key_backspace() {
    if (tab_ro[cur_tab] == 1) { return; }
    if (sel_empty() == 0) { undo_mark("other"); del_sel(); return; }
    sel_on = 0;
    undo_mark("del");
    local line = ed[ecy];
    if (ecx > 1) {
        // inside leading spaces: remove a whole indent step
        local n = 1;
        if (indent_of(line) >= ecx - 1 && ecx > 2 && (ecx - 1) % 2 == 0) { n = 2; }
        ed[ecy] = substr(line, 1, ecx - 1 - n) .. substr(line, ecx, len(line));
        ecx -= n;
        lines_changed(ecy);
    } else if (ecy > 1) {
        ecx = len(ed[ecy - 1]) + 1;
        ed[ecy - 1] = ed[ecy - 1] .. line;
        del(ed, ecy);
        ecy -= 1;
        lines_changed(ecy);
    }
    mark_dirty();
}

proc key_delete() {
    if (tab_ro[cur_tab] == 1) { return; }
    if (sel_empty() == 0) { undo_mark("other"); del_sel(); return; }
    sel_on = 0;
    undo_mark("del");
    local line = ed[ecy];
    if (ecx <= len(line)) {
        ed[ecy] = substr(line, 1, ecx - 1) .. substr(line, ecx + 1, len(line));
    } else if (ecy < len(ed)) {
        ed[ecy] = line .. ed[ecy + 1];
        del(ed, ecy + 1);
    }
    lines_changed(ecy);
    mark_dirty();
}

// cursor movement; extend = 1 keeps / grows the selection
proc move_begin(extend) {
    if (extend == 1) {
        if (sel_on == 0) { sel_on = 1; sax = ecx; say = ecy; }
    } else {
        sel_on = 0;
    }
}

proc is_word_char(ch) {
    local k = char_class[ord(ch) + 1];
    return k == 1 || k == 2;
}

proc word_left() {
    if (ecx == 1) {
        if (ecy > 1) { ecy -= 1; ecx = len(ed[ecy]) + 1; }
        return;
    }
    local line = ed[ecy];
    local x = ecx - 1;
    while (x > 1 && is_word_char(line[x]) == 0) { x -= 1; }
    while (x > 1 && is_word_char(line[x - 1]) == 1) { x -= 1; }
    ecx = x;
}

proc word_right() {
    local line = ed[ecy];
    if (ecx > len(line)) {
        if (ecy < len(ed)) { ecy += 1; ecx = 1; }
        return;
    }
    local x = ecx;
    while (x <= len(line) && is_word_char(line[x]) == 1) { x += 1; }
    while (x <= len(line) && is_word_char(line[x]) == 0) { x += 1; }
    ecx = x;
}

// select the word under (y, x)
proc select_word(y, x) {
    local line = ed[y];
    local a = x;
    local b = x;
    while (a > 1 && is_word_char(line[a - 1]) == 1) { a -= 1; }
    while (b <= len(line) && is_word_char(line[b]) == 1) { b += 1; }
    sel_on = 1;
    say = y;
    sax = a;
    ecy = y;
    ecx = b;
}

// toggle "-- " comments on the selected lines (or the current line)
proc toggle_comment() {
    if (tab_ro[cur_tab] == 1) { return; }
    undo_mark("other");
    local y1 = ecy;
    local y2 = ecy;
    if (sel_empty() == 0) {
        sel_bounds();
        y1 = s_y1;
        y2 = s_y2;
        if (s_x2 == 1 && y2 > y1) { y2 -= 1; }
    }
    // comment unless every non-blank line is already commented
    local all = 1;
    for y = y1 to y2 {
        local t = str_trim(ed[y]);
        if (len(t) > 0 && substr(t, 1, 2) != "--") { all = 0; }
    }
    for y = y1 to y2 {
        local line = ed[y];
        local ind = indent_of(line);
        local rest = substr(line, ind + 1, len(line));
        if (all == 1) {
            if (substr(rest, 1, 3) == "-- ") { rest = substr(rest, 4, len(rest)); }
            else if (substr(rest, 1, 2) == "--") { rest = substr(rest, 3, len(rest)); }
            ed[y] = rep_space(ind) .. rest;
        } else if (len(str_trim(line)) > 0) {
            ed[y] = rep_space(ind) .. "-- " .. rest;
        }
    }
    lines_changed(y1);
    clamp_cursor();
    mark_dirty();
}

proc indent_lines(dir) {
    if (tab_ro[cur_tab] == 1) { return; }
    undo_mark("other");
    local y1 = ecy;
    local y2 = ecy;
    if (sel_empty() == 0) {
        sel_bounds();
        y1 = s_y1;
        y2 = s_y2;
        if (s_x2 == 1 && y2 > y1) { y2 -= 1; }
    }
    for y = y1 to y2 {
        if (dir > 0) { ed[y] = "  " .. ed[y]; }
        else {
            local n = indent_of(ed[y]);
            if (n > 2) { n = 2; }
            ed[y] = substr(ed[y], n + 1, len(ed[y]));
        }
    }
    lines_changed(y1);
    clamp_cursor();
    mark_dirty();
}

// ===========================================================================
// syntax highlighting
// ===========================================================================

// highlight line s starting in lexer state st; fills hl_code / hl_fg and
// returns the state at the end of the line
proc hl_line(s, st) {
    clear(hl_code);
    clear(hl_fg);
    local n = len(s);
    for i = 1 to n {
        add(hl_code, ord(s[i]));
        add(hl_fg, C_FG);
    }
    local state = st;
    local i = 1;
    while (i <= n) {
        if (state == 1 || state == 2) {
            local col = C_COM;
            if (state == 2) { col = C_STR; }
            while (i <= n && !(hl_code[i] == 93 && i < n && hl_code[i + 1] == 93)) {
                hl_fg[i] = col;
                i += 1;
            }
            if (i <= n) {
                hl_fg[i] = col;
                hl_fg[i + 1] = col;
                i += 2;
                state = 0;
            }
        } else {
            local c = hl_code[i];
            local cls = char_class[c + 1];
            if (c == 45 && i < n && hl_code[i + 1] == 45) {
                // comment
                if (i + 3 <= n && hl_code[i + 2] == 91 && hl_code[i + 3] == 91) {
                    hl_fg[i] = C_COM; hl_fg[i + 1] = C_COM; hl_fg[i + 2] = C_COM; hl_fg[i + 3] = C_COM;
                    i += 4;
                    state = 1;
                } else {
                    while (i <= n) { hl_fg[i] = C_COM; i += 1; }
                }
            } else if (c == 91 && i < n && hl_code[i + 1] == 91) {
                hl_fg[i] = C_STR; hl_fg[i + 1] = C_STR;
                i += 2;
                state = 2;
            } else if (c == 34 || c == 39) {
                hl_fg[i] = C_STR;
                i += 1;
                while (i <= n && hl_code[i] != c) {
                    if (hl_code[i] == 92 && i < n) { hl_fg[i] = C_STR; i += 1; }
                    hl_fg[i] = C_STR;
                    i += 1;
                }
                if (i <= n) { hl_fg[i] = C_STR; i += 1; }
            } else if (cls == 1) {
                local j = i;
                local w = "";
                while (j <= n && (char_class[hl_code[j] + 1] == 1 || char_class[hl_code[j] + 1] == 2)) {
                    w = w .. s[j];
                    j += 1;
                }
                local col = C_FG;
                local kw = index(wkeywords, w);
                if (kw > 0 && streq(wkeywords[kw], w) == 1) { col = C_KW; }
                else {
                    local lb = index(lib_words, w);
                    if (lb > 0 && streq(lib_words[lb], w) == 1) { col = C_LIB; }
                    else {
                        local md = index(mod_words, w);
                        if (md > 0 && streq(mod_words[md], w) == 1) { col = C_LIB; }
                        else if (i > 1 && hl_code[i - 1] == 46 && i > 2 && char_class[hl_code[i - 2] + 1] == 1) {
                            // member of a library module: string.upper
                            local k = i - 2;
                            while (k > 1 && char_class[hl_code[k - 1] + 1] == 1) { k -= 1; }
                            local mw = substr(s, k, i - 2);
                            local mi2 = index(mod_words, mw);
                            if (mi2 > 0 && streq(mod_words[mi2], mw) == 1) { col = C_LIB; }
                        }
                    }
                }
                while (i < j) { hl_fg[i] = col; i += 1; }
            } else if (cls == 2) {
                while (i <= n && (char_class[hl_code[i] + 1] == 2 || hl_code[i] == 46 || hl_code[i] == 120 ||
                       (char_class[hl_code[i] + 1] == 1 && hl_code[i] < 103))) {
                    hl_fg[i] = C_NUM;
                    i += 1;
                }
            } else {
                if (cls == 0) { hl_fg[i] = C_OP; }
                i += 1;
            }
        }
    }
    return state;
}

// a text-file line: character codes, all in the text colour
proc plain_line(s) {
    clear(hl_code);
    clear(hl_fg);
    for i = 1 to len(s) {
        add(hl_code, ord(s[i]));
        add(hl_fg, C_FG);
    }
}

// make sure ls_state holds the lexer state for every line up to `upto`
proc ensure_states(upto) {
    local n = len(ed);
    local target = upto;
    if (target > n) { target = n; }
    if (ls_valid < 1) {
        clear(ls_state);
        add(ls_state, 0);
        ls_valid = 1;
    }
    while (len(ls_state) > ls_valid) { del(ls_state, len(ls_state)); }
    while (ls_valid < target) {
        local y = ls_valid;
        local st = 0;
        if (cur_tab > 0 && tab_kind[cur_tab] == 2) { st = yarn_hl_line(ed[y], ls_state[y]); }
        else { st = hl_line(ed[y], ls_state[y]); }
        add(ls_state, st);
        ls_valid += 1;
    }
}

// ===========================================================================
// file tree
// ===========================================================================

proc tree_build() {
    clear(tr_path); clear(tr_name); clear(tr_depth); clear(tr_dir);
    tree_add_dir(fs_lookup(ide_root, 1), 0);
    if (tr_sel > len(tr_path)) { tr_sel = len(tr_path); }
    ide_dirty = 1;
}

proc tree_add_dir(dir, depth) recursive {
    fs_list(dir);
    // fs_list fills fs_tmp; copy it because recursion reuses the list
    local kids = "";
    for k = 1 to len(fs_tmp) { kids = kids .. fs_tmp[k] .. ","; }
    // directories first, then files
    for pass = 1 to 2 {
        local num = "";
        for k = 1 to len(kids) {
            if (kids[k] == ",") {
                local ino = num;
                num = "";
                local isdir = 0;
                if (fs_type[ino] == FT_DIR) { isdir = 1; }
                if ((pass == 1 && isdir == 1) || (pass == 2 && isdir == 0)) {
                    local path = fs_path(ino);
                    if (!(path == "/tmp" || path == "/dev" || path == "/home")) {
                        add(tr_path, path);
                        add(tr_name, fs_name[ino]);
                        add(tr_depth, depth);
                        add(tr_dir, isdir);
                        if (isdir == 1 && index(tr_exp, path) > 0) { tree_add_dir(ino, depth + 1); }
                    }
                }
            } else {
                num = num .. kids[k];
            }
        }
    }
}

proc tree_click(i) {
    if (i < 1 || i > len(tr_path)) { return; }
    tr_sel = i;
    local p = tr_path[i];
    if (tr_dir[i] == 1) {
        local e = index(tr_exp, p);
        if (e > 0) { del(tr_exp, e); } else { add(tr_exp, p); }
        tree_build();
    } else {
        open_file(p);
    }
    ide_dirty = 1;
}

// directory for new files: the selected folder in the tree, else /projects
proc new_file_dir() {
    if (tr_sel > 0 && tr_sel <= len(tr_path)) {
        if (tr_dir[tr_sel] == 1) { return tr_path[tr_sel]; }
        local p = tr_path[tr_sel];
        local k = len(p);
        while (k > 1 && p[k] != "/") { k -= 1; }
        if (k > 1) { return substr(p, 1, k - 1); }
    }
    return ide_proj;
}

// ===========================================================================
// running programs
// ===========================================================================

proc ide_run(check_only) {
    if (cur_tab == 0) { ide_status("No file to run"); return; }
    if (tab_kind[cur_tab] == 1) { ide_status(fs_name_of(tab_path[cur_tab]) .. " is a text file - only .wsk programs run"); return; }
    if (run_pid > 0) { ide_stop(); }
    local path = tab_path[cur_tab];
    if (tab_ro[cur_tab] == 0) { save_tab(); }
    local ino = fs_lookup(path, 1);
    if (ino == 0) { ide_status("Cannot find " .. path); return; }
    clear(sh_argv);
    local chk = check_only;
    if (tab_kind[cur_tab] == 2) {
        // a Yarn page: run the browser on it (with --check to check it)
        ino = fs_lookup("/bin/browser.wsk", 1);
        if (ino == 0) { ide_status("Open .yarn pages in the ScratchOS Browser"); return; }
        add(sh_argv, "/bin/browser.wsk");
        if (chk == 1) { add(sh_argv, "--check"); }
        add(sh_argv, path);
        err_line = 0;
        err_msg = "";
        err_path = path;
        chk = 0;
    }
    if (tab_ro[cur_tab] == 1 && tab_kind[cur_tab] == 0) {
        // documents run from a temporary copy of the buffer
        ino = fs_create("/tmp/run.wsk", FT_FILE, 1);
        fs_data[ino] = join_lines();
        fs_mtime[ino] = fs_now();
    }
    err_line = 0;
    err_msg = "";
    err_path = path;
    if (chk == 1) {
        if (wcompile(fs_data[ino]) == 1) {
            ide_status("No syntax errors in " .. fs_name[ino] .. " (" .. len(cb) .. " instructions)");
        } else {
            ide_set_error(c_errmsg, 1);
        }
        return;
    }
    tty_attr[ide_con] = 7;
    tty_write(ide_con, "\n\e[90m► run " .. path .. "\e[0m\n");
    if (len(sh_argv) == 0) { add(sh_argv, path); }
    local c = vm_spawn(host, ino);
    if (c == 0) {
        ide_set_error(vm_err, 1);
        return;
    }
    p_name[c] = fs_name[ino];
    p_tty[c] = ide_con;
    p_in_k[c] = FD_TTY; p_in_i[c] = ide_con;
    p_out_k[c] = FD_TTY; p_out_i[c] = ide_con;
    p_err_k[c] = FD_TTY; p_err_i[c] = ide_con;
    p_caps[c] = "|files|proc|gui|system|";
    p_capq[c] = "";
    p_pgid[c] = p_pid[c];
    p_cwd[c] = fs_parent[ino];
    tty_fgpid[ide_con] = p_pid[c];
    tty_line_begin(ide_con);
    run_pid = p_pid[c];
    run_t0 = now_secs();
    vm_last_err_pid = 0;
    focus = 1;
    ide_dirty = 1;
}

// error text "line N: message" (compiler) or a runtime message
proc ide_set_error(msg, is_compile) {
    err_msg = msg;
    err_line = 0;
    if (is_compile == 1 && substr(msg, 1, 5) == "line ") {
        local num = "";
        local i = 6;
        while (i <= len(msg) && char_class[ord(msg[i]) + 1] == 2) { num = num .. msg[i]; i += 1; }
        if (len(num) > 0) { err_line = num * 1; }
        err_msg = substr(msg, i + 2, len(msg));
    }
    if (err_line > 0) { ide_goto_error(); }
    ide_status("Error: " .. err_msg);
    ide_dirty = 1;
}

proc ide_goto_error() {
    if (err_line == 0) { ide_status("No error"); return; }
    if (index(tab_path, err_path) > 0) { open_file(err_path); }
    if (cur_tab > 0 && streq(tab_path[cur_tab], err_path) == 1) {
        ecy = err_line;
        ecx = indent_of(ed[ecy]) + 1;
        clamp_cursor();
        sel_on = 0;
        focus = 0;
        ide_scroll_to_cursor();
    }
    ide_dirty = 1;
}

proc ide_stop() {
    if (run_pid == 0) { return; }
    local s = proc_slot(run_pid);
    if (s > 0) {
        local g = p_pgid[s];
        for k = 1 to MAX_PROC {
            if (p_state[k] != PS_FREE && p_pgid[k] == g && k != host) { proc_exit(k, 130); }
        }
    }
    tty_write(ide_con, "\n\e[93m■ stopped\e[0m\n");
    run_pid = 0;
    tty_mode[ide_con] = 0;
    tty_curvis[ide_con] = 1;
    focus = 0;
    ide_dirty = 1;
}

// called every frame: notice when the program has finished
proc ide_check_run() {
    if (run_pid == 0) { return; }
    if (proc_slot(run_pid) > 0) { return; }
    local code = proc_status(run_pid);
    if (len(code) == 0) { code = 0; }
    local secs = floor((now_secs() - run_t0) * 10) / 10;
    if (vm_last_err_pid == run_pid) {
        err_line = vm_last_err_line;
        err_msg = vm_last_err;
        if (err_line > 0) { ide_goto_error(); }
        tty_write(ide_con, "\e[90m■ error after " .. secs .. "s\e[0m\n");
    } else {
        tty_write(ide_con, "\e[90m■ exit code " .. code .. " (" .. secs .. "s)\e[0m\n");
    }
    run_pid = 0;
    tty_mode[ide_con] = 0;
    tty_curvis[ide_con] = 1;
    if (focus == 1 || focus == 3) { focus = 0; }
    ide_dirty = 1;
}

// ===========================================================================
// graphics preview (canvas windows opened by programs)
// ===========================================================================

proc cv_check() {
    if (IDE_HOSTED == 1) { return; }      // programs' windows are desktop windows
    // adopt the newest canvas window
    local w = 0;
    for k = 1 to MAX_WIN {
        if (win_used[k] == 1 && win_kind[k] == WK_CANVAS) { w = k; }
    }
    if (w != cv_win) {
        cv_win = w;
        if (w > 0) {
            cv_place();
            focus = 3;
        } else if (focus == 3) {
            focus = 0;
        }
        ide_full = 1;
        ide_dirty = 1;
    }
}

// fit the canvas window into the editor area and send a resize event if shrunk
proc cv_place() {
    local w = cv_win;
    local maxw = IC - 2;
    local maxh = out_top - 2;
    // the window manager's geometry is the content area plus a title row;
    // the preview adds a one-cell frame round the content
    local cw = win_w[w] + 2;
    local ch = win_h[w] + 1;
    local shrunk = 0;
    if (cw > maxw) { cw = maxw; shrunk = 1; }
    if (ch > maxh) { ch = maxh; shrunk = 1; }
    if (ch < 4) { ch = 4; }
    cv_w = cw;
    cv_h = ch;
    cv_x = floor((IC - cw) / 2);
    cv_y = 2 + floor((maxh - ch) / 2);
    if (shrunk == 1 || cw != win_w[w] + 2 || ch != win_h[w] + 1) {
        wm_event(w, "resize", (cw - 2) * 8, (ch - 2) * 16, "");
    }
    win_x[w] = cv_x + 1;
    win_y[w] = cv_y;
    win_w[w] = cw - 2;
    win_h[w] = ch - 1;
}

// visible rectangles of the canvas (overlays above it are cut out)
proc cv_vis() {
    clear(vrc_win); clear(vrc_x); clear(vrc_y); clear(vrc_w); clear(vrc_h);
    if (cv_win == 0) { return; }
    clear(vr_x); clear(vr_y); clear(vr_w); clear(vr_h);
    add(vr_x, (cv_x + 1) * 8);
    add(vr_y, (cv_y + 1) * 16);
    add(vr_w, (cv_w - 2) * 8);
    add(vr_h, (cv_h - 2) * 16);
    if (imenu_open > 0) { rects_subtract(menu_px0 * 8, 16, (menu_px1 - menu_px0) * 8, menu_rows * 16 + 16); }
    if (idlg_kind > 0) { rects_subtract(idlg_x * 8, idlg_y * 16, idlg_w * 8, idlg_h * 16); }
    if (ac_open == 1) { rects_subtract(ac_x * 8, ac_y * 16, 24 * 8, (len(ac_items) + 0) * 16); }
    for q = 1 to len(vr_x) {
        add(vrc_win, cv_win); add(vrc_x, vr_x[q]); add(vrc_y, vr_y[q]); add(vrc_w, vr_w[q]); add(vrc_h, vr_h[q]);
    }
}

// ===========================================================================
// composition
// ===========================================================================

// Cell attributes and decorations: see ui.sbs

const VIEW_SW = 15;       // width of the Preview / Edit switch in the tab bar

proc put(c, r, code, at) {
    if (c < 0 || r < 0 || c >= IC || r >= IR) { return; }
    local i = r * IC + c + 1;
    sc_ch[i] = code;
    sc_at[i] = at;
}

proc puts(c, r, s, at) {
    for k = 1 to len(s) { put(c + k - 1, r, ord(s[k]), at); }
}

proc fill_row(r, c0, c1, at) {
    for c = c0 to c1 { put(c, r, 32, at); }
}

// add a decoration to cells c0..c1 of row r (keeps their glyph and colours)
proc deco_row(r, c0, c1, d) {
    for c = c0 to c1 {
        if (c >= 0 && c < IC) {
            local i = r * IC + c + 1;
            if (sc_ch[i] >= 0) { sc_at[i] = sc_at[i] % AD + AD * d; }
        }
    }
}

// recolour the foreground of one cell
proc put_fg(c, r, fg) {
    if (c < 0 || r < 0 || c >= IC || r >= IR) { return; }
    local i = r * IC + c + 1;
    local a = sc_at[i];
    sc_at[i] = a - a % AB + fg;
}

// popup box: fill cells x0..x1 / y0..y1 and outline them with 1px borders
proc popup_box(x0, y0, x1, y1, at) {
    for r = y0 to y1 { fill_row(r, x0, x1, at); }
    for c = x0 to x1 {
        put_deco(c, y0, D_POP + D_TOP);
        put_deco(c, y1, D_POP + D_BOTTOM);
    }
    for r = y0 to y1 {
        put_deco(x0, r, D_POP + D_LEFTB + edge_bits(x0, r));
        put_deco(x1, r, D_POP + D_RIGHT + edge_bits(x1, r));
    }
}

proc edge_bits(c, r) {
    if (c < 0 || r < 0 || c >= IC || r >= IR) { return 0; }
    local d = floor(sc_at[r * IC + c + 1] / AD);
    if (d >= 32) { return 0; }
    return d % 4;
}

proc put_deco(c, r, d) {
    if (c < 0 || r < 0 || c >= IC || r >= IR) { return; }
    local i = r * IC + c + 1;
    if (sc_ch[i] >= 0) { sc_at[i] = sc_at[i] % AD + AD * d; }
}

var menu_px0 = 0;
var menu_px1 = 0;
var menu_rows = 0;

proc ide_compose() {
    // title bar: app badge, menus, file name, Run / Stop
    local bar = C_TEXT + AB * C_PANEL;
    fill_row(0, 0, IC - 1, bar);
    puts(0, 0, " W ", C_ONACC + AB * C_ACCENT);
    for i = 1 to len(mn_title) {
        local at = bar;
        if (imenu_open == i) { at = C_TEXT + AB * C_HOVER; }
        puts(mn_x[i] - 1, 0, " " .. mn_title[i] .. " ", at);
    }
    if (cur_tab > 0) {
        local nm = fs_name_of(tab_path[cur_tab]);
        local cx = IC - 10 - len(nm);
        if (cx > mn_x[len(mn_title)] + 6) { puts(cx, 0, nm, C_DIM + AB * C_PANEL); }
    }
    if (run_pid > 0) {
        puts(IC - 8, 0, "   Stop ", C_TEXT + AB * C_BUTTON);
        put(IC - 7, 0, G_STOP, C_STOP + AB * C_BUTTON);
    } else {
        puts(IC - 8, 0, "   Run  ", C_TEXT + AB * C_BUTTON);
        put(IC - 7, 0, G_RIGHT, C_RUN + AB * C_BUTTON);
    }
    deco_row(0, 0, IC - 1, D_BOTTOM);
    ide_compose_tabs();
    ide_compose_tree();
    ide_compose_editor();
    ide_compose_output();
    ide_compose_status();
    if (cv_win > 0) { ide_compose_canvas(); }
    if (ac_open == 1) { ide_compose_ac(); }
    if (imenu_open > 0) { ide_compose_menu(); }
    if (idlg_kind > 0) { ide_compose_dialog(); }
    if (IDE_HOSTED == 1) { return; }
    // tty visibility for the output panel
    for i = 1 to IC * IR {
        if (sc_ch[i] == -1) { own[i] = OUT_WIN; } else { own[i] = 0; }
    }
    cv_vis();
}

// tab i is drawn as " name ● " / " name × "
proc tab_label_w(i) {
    return len(fs_name_of(tab_path[i])) + 4;
}

proc ide_compose_tabs() {
    fill_row(ROW_TABS, 0, IC - 1, C_DIM + AB * C_PANEL);
    deco_row(ROW_TABS, 0, IC - 1, D_BOTTOM);
    local tabs_end = IC;
    if (text_tab() == 1) {
        // view switch: " Preview  Edit "
        tabs_end = IC - VIEW_SW;
        local pa = C_DIM + AB * C_PANEL;
        local ea = C_DIM + AB * C_PANEL;
        if (tab_view[cur_tab] == 1) { pa = C_TEXT + AB * C_ACTIVE; } else { ea = C_TEXT + AB * C_ACTIVE; }
        puts(IC - VIEW_SW, ROW_TABS, " Preview ", pa);
        puts(IC - VIEW_SW + 9, ROW_TABS, " Edit ", ea);
    }
    local x = 0;
    for i = 1 to len(tab_path) {
        local name = fs_name_of(tab_path[i]);
        local lw = tab_label_w(i);
        if (x + lw <= tabs_end) {
            local at = C_DIM + AB * C_PANEL;
            if (i == cur_tab) { at = C_TEXT + AB * C_EDBG; }
            puts(x, ROW_TABS, " " .. name .. "   ", at);
            if (tab_dirty[i] == 1) { put(x + lw - 2, ROW_TABS, G_DOT, at); }
            else { put(x + lw - 2, ROW_TABS, G_CLOSE, at); put_fg(x + lw - 2, ROW_TABS, C_DIM); }
            if (i == cur_tab) { deco_row(ROW_TABS, x, x + lw - 1, D_UNDER); }
            else { deco_row(ROW_TABS, x, x + lw - 1, D_BOTTOM); }
            x += lw;
        }
    }
}

proc ide_compose_tree() {
    if (show_tree == 0) { return; }
    local at = C_TEXT + AB * C_PANEL;
    local r0 = ed_y0;
    for r = r0 to out_top - 1 {
        fill_row(r, 0, TREE_W - 1, at);
    }
    local hat = C_HEADER + AB * C_PANEL;
    puts(1, r0, "Project", hat);
    puts(TREE_W - 3, r0, "+", C_DIM + AB * C_PANEL);
    if (focus == 2) { deco_row(r0, 1, 7, D_UNDER); }
    local rows = tree_rows();
    if (tr_top > len(tr_path) - rows + 1) { tr_top = len(tr_path) - rows + 1; }
    if (tr_top < 1) { tr_top = 1; }
    for k = 0 to rows - 1 {
        local i = tr_top + k;
        if (i <= len(tr_path)) {
            local r = r0 + 1 + k;
            local ind = tr_depth[i];
            local fg = C_TEXT;
            local icon = 32;
            local icol = C_DIM;
            local name = tr_name[i];
            if (tr_dir[i] == 1) {
                if (index(tr_exp, tr_path[i]) > 0) { icon = G_DOWN; } else { icon = G_RIGHT; }
            } else if (len(name) > 4 && substr(name, len(name) - 3, len(name)) == ".wsk") {
                icon = G_DOT;
                icol = C_WSK;
            } else {
                icon = G_DOT;
                icol = C_DIM;
            }
            local bg = C_PANEL;
            if (i == tr_sel) { bg = C_ACTIVE; }
            if (cur_tab > 0 && streq(tr_path[i], tab_path[cur_tab]) == 1) { fg = C_HEADER; if (i != tr_sel) { bg = C_HOVER; } }
            fill_row(r, 0, TREE_W - 1, fg + AB * bg);
            put(1 + ind, r, icon, icol + AB * bg);
            if (tr_dir[i] == 1) { fg = C_FOLDER; if (i == tr_sel) { fg = C_TEXT; } }
            puts(3 + ind, r, substr(name, 1, TREE_W - 6 - ind), fg + AB * bg);
            if (len(name) > TREE_W - 6 - ind) { put(TREE_W - 3, r, 175, C_DIM + AB * bg); }
        }
    }
    for r = r0 to out_top - 1 { deco_row(r, TREE_W - 1, TREE_W - 1, D_RIGHT); }
    compose_vscroll(TREE_W - 2, r0 + 1, rows, len(tr_path), tr_top);
}

// ---------------------------------------------------------------------------
// scrollbars: pixel-precise thumbs over a column of cells
// ---------------------------------------------------------------------------

var sb_ty = 0;            // thumb top, pixels from the track top
var sb_th = 0;            // thumb height in pixels

// thumb geometry for n lines, `rows` visible, first visible line `top`
proc sb_geom(n, rows, top) {
    local track = rows * 16;
    sb_th = floor(track * rows / n);
    if (sb_th < 12) { sb_th = 12; }
    if (sb_th > track) { sb_th = track; }
    sb_ty = round((top - 1) * (track - sb_th) / (n - rows));
    if (sb_ty > track - sb_th) { sb_ty = track - sb_th; }
    if (sb_ty < 0) { sb_ty = 0; }
}

// draw the thumb (as decos) into column `col`, rows row0 .. row0 + rows - 1
proc compose_vscroll(col, row0, rows, n, top) {
    if (n <= rows) { return; }
    sb_geom(n, rows, top);
    local y0 = sb_ty;
    local y1 = sb_ty + sb_th;
    for k = floor(y0 / 16) to floor((y1 - 1) / 16) {
        local a = y0 - k * 16;
        if (a < 0) { a = 0; }
        local b = y1 - k * 16;
        if (b > 16) { b = 16; }
        local ends = 0;
        if (y0 >= k * 16) { ends += 1; }
        if (y1 <= k * 16 + 16) { ends += 2; }
        put_deco(col, row0 + k, D_SB + (a * 17 + b) * 4 + ends);
    }
}

// first visible line for a pointer at pixel y (the thumb follows the
// pointer, keeping the grab offset)
proc sb_top_at(py, row0, rows, n) {
    local track = rows * 16;
    sb_geom(n, rows, 1);
    local span = track - sb_th;
    if (span < 1) { return 1; }
    local t = 1 + round((py - sb_grab - row0 * 16) * (n - rows) / span);
    if (t > n - rows + 1) { t = n - rows + 1; }
    if (t < 1) { t = 1; }
    return t;
}

// pointer pressed in a scrollbar column: grab the thumb where it was hit,
// or centre the thumb on the pointer when the track was clicked
proc sb_press(py, row0, rows, n, top) {
    sb_geom(n, rows, top);
    local rel = py - row0 * 16;
    if (rel >= sb_ty && rel < sb_ty + sb_th) { sb_grab = rel - sb_ty; }
    else { sb_grab = floor(sb_th / 2); }
}

proc tree_rows() {
    return out_top - ed_y0 - 1;
}

proc ide_compose_editor() {
    if (in_preview() == 1) { ide_compose_preview(); return; }
    local n = len(ed);
    ensure_states(etop + ed_rows);
    if (sel_on == 1) { sel_bounds(); }
    local selx = sel_empty() == 0;
    local on_err = 0;
    if (cur_tab > 0) { if (streq(tab_path[cur_tab], err_path) == 1) { on_err = 1; } }
    for r = 0 to ed_rows - 1 {
        local y = etop + r;
        local row = ed_y0 + r;
        local lbg = C_EDBG;
        if (y == ecy && cur_tab > 0 && selx == 0) { lbg = C_CURLINE; }
        if (y == err_line && on_err == 1) { lbg = C_ERRBG; }
        // gutter
        local gat = C_GUT + AB * C_EDBG;
        if (y == ecy) { gat = C_GUTCUR + AB * C_EDBG; }
        if (y == err_line && on_err == 1) { gat = C_ERRFG + AB * C_EDBG; }
        if (y <= n && cur_tab > 0) {
            puts(ed_x0, row, pad_left(y, GUT_W - 2) .. "  ", gat);
        } else {
            puts(ed_x0, row, rep_space(GUT_W), gat);
        }
        // text
        if (y <= n && cur_tab > 0) {
            if (tab_kind[cur_tab] == 1) { plain_line(ed[y]); }
            else if (tab_kind[cur_tab] == 2) { yarn_hl_line(ed[y], ls_state[y]); }
            else { hl_line(ed[y], ls_state[y]); }
            local len_y = len(ed[y]);
            for c = 0 to txt_w - 1 {
                local x = eleft + c;
                local code = 32;
                local fg = C_FG;
                if (x <= len_y) {
                    code = hl_code[x];
                    fg = hl_fg[x];
                }
                local bg = lbg;
                if (selx == 1) {
                    if (pos_before(y, x, s_y1, s_x1) == 0 && pos_before(y, x, s_y2, s_x2) == 1) {
                        if (x <= len_y || y < s_y2) { bg = C_SEL; }
                    }
                }
                if (code == 9) { code = 32; }
                put(txt_x0 + c, row, code, fg + AB * bg);
            }
        } else {
            fill_row(row, txt_x0, txt_x0 + txt_w - 1, C_FG + AB * C_EDBG);
        }
    }
    if (cur_tab == 0) {
        puts(txt_x0 + 2, ed_y0 + 2, "No file open", C_TEXT + AB * C_EDBG);
        puts(txt_x0 + 2, ed_y0 + 4, "File > New file, or pick a file", C_DIM + AB * C_EDBG);
        puts(txt_x0 + 2, ed_y0 + 5, "in the Project tree.", C_DIM + AB * C_EDBG);
        puts(txt_x0 + 2, ed_y0 + 7, "Ctrl+Enter  Run", C_DIM + AB * C_EDBG);
        puts(txt_x0 + 2, ed_y0 + 8, "Esc         Menu", C_DIM + AB * C_EDBG);
    }
    // scrollbar (only when the file is taller than the view)
    local sb = IC - 1;
    for r = 0 to ed_rows - 1 { put(sb, ed_y0 + r, 32, C_FG + AB * C_EDBG); }
    compose_vscroll(sb, ed_y0, ed_rows, n, etop);
}

proc ide_compose_output() {
    if (out_h == 0) { return; }
    local hr = out_top;
    local at = C_DIM + AB * C_PANEL;
    fill_row(hr, 0, IC - 1, at);
    puts(1, hr, "Output", C_HEADER + AB * C_PANEL);
    if (run_pid > 0) {
        put(9, hr, G_DOT, C_RUN + AB * C_PANEL);
        puts(11, hr, "running", C_TEXT + AB * C_PANEL);
    } else if (err_line > 0) {
        put(9, hr, G_DOT, C_ERRFG + AB * C_PANEL);
        puts(11, hr, substr("line " .. err_line .. ": " .. err_msg, 1, IC - 32), C_ERRFG + AB * C_PANEL);
    } else if (len(err_msg) > 0) {
        put(9, hr, G_DOT, C_ERRFG + AB * C_PANEL);
        puts(11, hr, substr(err_msg, 1, IC - 32), C_ERRFG + AB * C_PANEL);
    }
    // buttons: same columns as the hit test in ide_press
    puts(IC - 19, hr, " Clear ", at);
    puts(IC - 12, hr, " ", at); put(IC - 11, hr, 30, at); puts(IC - 10, hr, " ", at);
    puts(IC - 9, hr, " ", at); put(IC - 8, hr, 31, at); puts(IC - 7, hr, " ", at);
    puts(IC - 6, hr, " ", at); put(IC - 5, hr, G_CLOSE, at); puts(IC - 4, hr, " ", at);
    deco_row(hr, 0, IC - 1, D_TOP);
    if (focus == 1) { deco_row(hr, 1, 6, D_UNDER); }
    for r = hr + 1 to ROW_STATUS - 1 {
        for c = 0 to IC - 1 { put(c, r, -1, 0); }
    }
}

proc ide_compose_status() {
    local r = ROW_STATUS;
    if (len(pr_kind) > 0) {
        fill_row(r, 0, IC - 1, C_TEXT + AB * C_EDBG);
        puts(1, r, pr_label, C_DIM + AB * C_EDBG);
        local px = 1 + len(pr_label);
        local shown = pr_buf;
        local room = IC - 22 - px;
        if (len(shown) > room) { shown = substr(shown, len(shown) - room + 1, len(shown)); }
        puts(px, r, shown, C_TEXT + AB * C_EDBG);
        puts(IC - 21, r, "Enter ok  Esc cancel", C_DIM + AB * C_EDBG);
        deco_row(r, 0, IC - 1, D_TOP);
        deco_row(r, px + len(shown), px + len(shown), D_CARET);
        return;
    }
    local at = C_DIM + AB * C_PANEL;
    fill_row(r, 0, IC - 1, at);
    deco_row(r, 0, IC - 1, D_TOP);
    if (len(status_msg) > 0 && now_secs() < status_until) {
        puts(1, r, substr(status_msg, 1, IC - 2), C_TEXT + AB * C_PANEL);
        deco_row(r, 0, IC - 1, D_TOP);
        return;
    }
    local name = "no file";
    if (cur_tab > 0) {
        name = tab_path[cur_tab];
        if (tab_ro[cur_tab] == 1) { name = name .. "  (read-only)"; }
    }
    puts(1, r, substr(name, 1, IC - 40), at);
    if (cur_tab > 0 && tab_dirty[cur_tab] == 1) { put(2 + len(substr(name, 1, IC - 40)), r, G_DOT, C_WARN + AB * C_PANEL); }
    local pos = ecy .. ":" .. ecx .. "   Whisker ";
    if (text_tab() == 2) { pos = ecy .. ":" .. ecx .. "   Run shows it in the Browser   Yarn "; }
    if (text_tab() == 1) {
        if (in_preview() == 1) { pos = "Preview  Ctrl+E edit   Text "; }
        else { pos = ecy .. ":" .. ecx .. "   Ctrl+E preview   Text "; }
    }
    if (sel_empty() == 0) { pos = len(sel_text()) .. " chars   " .. pos; }
    puts(IC - len(pos), r, pos, at);
    deco_row(r, 0, IC - 1, D_TOP);
}

proc ide_compose_canvas() {
    local x = cv_x;
    local y = cv_y;
    local w = cv_w;
    local h = cv_h;
    local fa = C_DIM + AB * C_PANEL;
    popup_box(x, y, x + w - 1, y + h - 1, fa);
    for r = y + 1 to y + h - 2 {
        for c = x + 1 to x + w - 2 { put(c, r, -2, 1000 + (r - y) * 64 + (c - x)); }
    }
    put(x + 2, y, G_CLOSE, fa + AD * (D_POP + D_TOP));
    local t = win_title[cv_win];
    if (len(t) > w - 8) { t = substr(t, 1, w - 8); }
    local tx = x + floor((w - len(t)) / 2);
    puts(tx, y, t, C_TEXT + AB * C_PANEL + AD * (D_POP + D_TOP));
    if (focus == 3) { deco_row(y, tx, tx + len(t) - 1, D_UNDER); }
}

proc ide_compose_ac() {
    local n = len(ac_items);
    for k = 1 to n {
        local at = C_TEXT + AB * C_POPUP;
        if (k == ac_sel) { at = C_TEXT + AB * C_ACTIVE; }
        local item = ac_items[k];
        puts(ac_x, ac_y + k - 1, pad_right("  " .. item, 24), at);
        // module members show their module prefix dimmed
        local dot = 0;
        for j = 1 to len(item) { if (item[j] == ".") { dot = j; } }
        if (dot > 0) { for j = 1 to dot { put_fg(ac_x + 1 + j, ac_y + k - 1, C_DIM); } }
    }
    for k = 1 to n {
        put_deco(ac_x, ac_y + k - 1, D_POP + D_LEFTB);
        put_deco(ac_x + 23, ac_y + k - 1, D_POP + D_RIGHT);
    }
    for c = ac_x + 1 to ac_x + 22 {
        put_deco(c, ac_y, D_POP + D_TOP);
        put_deco(c, ac_y + n - 1, D_POP + D_BOTTOM + edge_bits(c, ac_y + n - 1));
    }
    put_deco(ac_x, ac_y, D_POP + D_LEFTB + D_TOP);
    put_deco(ac_x + 23, ac_y, D_POP + D_RIGHT + D_TOP);
    put_deco(ac_x, ac_y + n - 1, D_POP + D_LEFTB + D_BOTTOM + edge_bits(ac_x, ac_y + n - 1));
    put_deco(ac_x + 23, ac_y + n - 1, D_POP + D_RIGHT + D_BOTTOM + edge_bits(ac_x + 23, ac_y + n - 1));
}

proc ide_compose_menu() {
    local m = imenu_open;
    local w = 0;
    menu_rows = 0;
    for i = 1 to len(mi_menu) {
        if (mi_menu[i] == m) {
            menu_rows += 1;
            local lw = len(mi_label[i]) + len(mi_key[i]) + 5;
            if (lw > w) { w = lw; }
        }
    }
    if (w < 20) { w = 20; }
    local x0 = mn_x[m] - 1;
    if (x0 + w + 2 > IC) { x0 = IC - w - 2; }
    menu_px0 = x0;
    menu_px1 = x0 + w + 2;
    local at = C_TEXT + AB * C_POPUP;
    local r = 1;
    popup_box(x0, 1, x0 + w + 1, menu_rows + 2, at);
    for i = 1 to len(mi_menu) {
        if (mi_menu[i] == m) {
            r += 1;
            if (mi_label[i] == "-") {
                for c = x0 + 2 to x0 + w - 1 { put(c, r, 196, C_POPBD + AB * C_POPUP); }
            } else {
                local bg = C_POPUP;
                if (i == imenu_sel) { bg = C_ACTIVE; }
                fill_row(r, x0 + 1, x0 + w, C_TEXT + AB * bg);
                puts(x0 + 2, r, mi_label[i], C_TEXT + AB * bg);
                puts(x0 + w - len(mi_key[i]), r, mi_key[i], C_DIM + AB * bg);
            }
        }
    }
}

proc ide_compose_dialog() {
    local w = 40;
    for k = 1 to len(idlg_lines) {
        if (len(idlg_lines[k]) + 4 > w) { w = len(idlg_lines[k]) + 4; }
    }
    if (w > IC - 2) { w = IC - 2; }
    local h = len(idlg_lines) + 5;
    idlg_w = w;
    idlg_h = h;
    idlg_x = floor((IC - w) / 2);
    idlg_y = floor((IR - h) / 2);
    local at = C_TEXT + AB * C_POPUP;
    popup_box(idlg_x, idlg_y, idlg_x + w - 1, idlg_y + h - 1, at);
    puts(idlg_x + 2, idlg_y + 1, idlg_title, C_HEADER + AB * C_POPUP);
    for k = 1 to len(idlg_lines) {
        puts(idlg_x + 2, idlg_y + 1 + k, substr(idlg_lines[k], 1, w - 4), C_DIM + AB * C_POPUP);
    }
    local by = idlg_y + h - 2;
    local mid = idlg_x + floor(w / 2);
    if (idlg_kind == 2) {
        puts(mid - 14, by, "  Yes  ", C_ONACC + AB * C_ACCENT);
        puts(mid - 4, by, "  No   ", C_TEXT + AB * C_BUTTON);
        puts(mid + 6, by, " Cancel ", C_TEXT + AB * C_BUTTON);
    } else {
        puts(mid - 3, by, "  OK  ", C_ONACC + AB * C_ACCENT);
    }
}

// ===========================================================================
// drawing
// ===========================================================================

proc ide_draw_cell(i) {
    local col = (i - 1) % IC;
    local row = floor((i - 1) / IC);
    if (IDE_HOSTED == 1) {
        local sc = ide_ox + col;
        local sr = ide_oy + row;
        if (sc >= 0 && sr >= 0 && sc < SCR_COLS && sr < SCR_ROWS) { wm_draw_cell(sr * SCR_COLS + sc + 1); }
        return;
    }
    local c = sc_ch[i];
    if (c == -1) {
        if (out_h > 0) { tty_render_cell(ide_con, row - out_top - 1, col); }
        return;
    }
    if (c == -2) {
        if (cv_win > 0) { canvas_repaint_rect(cv_win, col * 8, row * 16, 8, 16); }
        return;
    }
    ui_cell(col * 8, row * 16, c, sc_at[i]);
}

proc ide_render() {
    if (ide_dirty == 0) { return; }
    ide_dirty = 0;
    if (IDE_HOSTED == 1) {
        // the window manager copies sc_* into the screen and draws it
        ide_compose();
        wm_need = 1;
        return;
    }
    // erase the caret bar first: its cell may not change and so not be redrawn
    if (caret_on == 1) { ide_draw_cell(caret_r * IC + caret_c + 1); caret_on = 0; }
    ide_compose();
    local n = IC * IR;
    local canvas_cells = 0;
    local tty_cells = 0;
    for i = 1 to n {
        local c = sc_ch[i];
        if (c != so_ch[i] || sc_at[i] != so_at[i] || ide_full == 1) {
            so_ch[i] = c;
            so_at[i] = sc_at[i];
            if (c == -1) { tty_cells += 1; }
            else if (c == -2) { canvas_cells += 1; }
            else { ide_draw_cell(i); }
        }
    }
    if (tty_cells > 0) { tty_full[ide_con] = 1; }
    if (canvas_cells > 0 && cv_win > 0) { canvas_repaint(cv_win); }
    if (ide_full == 1 && SCR_H > IR * 16) { gfx_fill(0, IR * 16, SCR_W, SCR_H - IR * 16, C_PANEL); }
    ide_full = 0;
    caret_on = 0;
}

// blinking caret (a 2-pixel bar) in the editor
proc ide_caret() {
    local want = 0;
    local c = txt_x0 + ecx - eleft;
    local r = ed_y0 + ecy - etop;
    if (focus == 0 && cur_tab > 0 && in_preview() == 0 && imenu_open == 0 && idlg_kind == 0 && len(pr_kind) == 0) {
        if (c >= txt_x0 && c < txt_x0 + txt_w && r >= ed_y0 && r < ed_y0 + ed_rows) {
            local t = now_secs();
            if (t - last_key_time < 0.6 || floor(t / 0.5) % 2 == 0) { want = 1; }
        }
    }
    if (caret_on == 1) {
        if (want == 1 && caret_c == c && caret_r == r) { return; }
        ide_draw_cell(caret_r * IC + caret_c + 1);
        caret_on = 0;
    }
    if (want == 1 && IDE_HOSTED == 1) {
        // only where the IDE window is not covered
        if (wm_owner_at(ide_ox + c, ide_oy + r) != ide_win) { want = 0; }
    }
    if (want == 1) {
        gfx_fill((ide_ox + c) * 8, (ide_oy + r) * 16 + 1, 2, 14, C_TEXT);
        caret_on = 1;
        caret_c = c;
        caret_r = r;
    }
}

// ===========================================================================
// scrolling
// ===========================================================================

proc ide_scroll_to_cursor() {
    if (ecy < etop) { etop = ecy; }
    if (ecy > etop + ed_rows - 1) { etop = ecy - ed_rows + 1; }
    if (etop < 1) { etop = 1; }
    if (ecx < eleft) { eleft = ecx; }
    if (ecx > eleft + txt_w - 1) { eleft = ecx - txt_w + 1; }
    if (eleft < 1) { eleft = 1; }
}

proc ide_status(msg) {
    status_msg = msg;
    status_until = now_secs() + 3;
    ide_dirty = 1;
}

// ===========================================================================
// autocomplete
// ===========================================================================

// word (with module prefix) before the cursor
proc word_before() {
    local line = ed[ecy];
    local x = ecx - 1;
    while (x >= 1 && (is_word_char(line[x]) == 1 || line[x] == ".")) { x -= 1; }
    return substr(line, x + 1, ecx - 1);
}

proc ac_show(forced) {
    ac_open = 0;
    if (text_tab() == 1) { return; }
    local w = word_before();
    if (len(w) == 0 && forced == 0) { return; }
    if (forced == 0 && !(contains(w, ".")) && len(w) < 2) { return; }
    clear(ac_items);
    for i = 1 to len(nat_names) {
        local n = nat_names[i];
        if (len(n) > len(w) && streq(substr(n, 1, len(w)), w) == 1 && len(ac_items) < 8) { add(ac_items, n); }
    }
    for i = 1 to len(wkeywords) {
        local k = wkeywords[i];
        if (len(k) > len(w) && streq(substr(k, 1, len(w)), w) == 1 && len(ac_items) < 8) { add(ac_items, k); }
    }
    for i = 1 to len(nat_mods) {
        local m = nat_mods[i];
        if (len(m) > len(w) && streq(substr(m, 1, len(w)), w) == 1 && len(ac_items) < 8) { add(ac_items, m .. "."); }
    }
    if (len(ac_items) == 0) {
        if (forced == 1) { ide_status("No completions for '" .. w .. "'"); }
        return;
    }
    ac_word = w;
    ac_sel = 1;
    ac_open = 1;
    ac_x = txt_x0 + ecx - eleft - len(w);
    if (ac_x < 0) { ac_x = 0; }
    if (ac_x + 24 > IC) { ac_x = IC - 24; }
    ac_y = ed_y0 + ecy - etop + 1;
    if (ac_y + len(ac_items) > ROW_STATUS) { ac_y = ed_y0 + ecy - etop - len(ac_items); }
    ide_dirty = 1;
}

proc ac_accept() {
    local item = ac_items[ac_sel];
    local rest = substr(item, len(ac_word) + 1, len(item));
    ac_open = 0;
    undo_mark("other");
    ins_text(rest);
    // functions get "()" with the cursor inside
    if (index(nat_names, item) > 0 && index(nat_mods, item) == 0) {
        if (!(substr(item, len(item), len(item)) == ".")) {
            ins_text("()");
            ecx -= 1;
        }
    }
    if (substr(item, len(item), len(item)) == ".") { ac_show(0); }
    ide_dirty = 1;
}

// ===========================================================================
// prompts and dialogs
// ===========================================================================

proc prompt(kind, label, initial) {
    pr_kind = kind;
    pr_label = label;
    pr_buf = initial;
    ide_dirty = 1;
}

proc dialog(kind, title, text, yes_cmd, no_cmd) {
    idlg_kind = kind;
    idlg_title = title;
    idlg_cmd = yes_cmd;
    idlg_no = no_cmd;
    clear(idlg_lines);
    local cur = "";
    for i = 1 to len(text) {
        if (text[i] == "\n") { add(idlg_lines, cur); cur = ""; } else { cur = cur .. text[i]; }
    }
    add(idlg_lines, cur);
    ide_dirty = 1;
}

proc dialog_answer(a) {
    local yes = idlg_cmd;
    local no = idlg_no;
    idlg_kind = 0;
    ide_full = 1;
    ide_dirty = 1;
    if (a == "y" && len(yes) > 0) { ide_cmd(yes); }
    if (a == "n" && len(no) > 0) { ide_cmd(no); }
}

proc prompt_done() {
    local kind = pr_kind;
    local v = pr_buf;
    pr_kind = "";
    ide_dirty = 1;
    if (kind == "new") {
        if (len(v) == 0) { return; }
        local path = v;
        if (path[1] != "/") { path = new_file_dir() .. "/" .. v; }
        if (!(contains(fs_name_of(path), "."))) { path = path .. ".wsk"; }
        if (fs_lookup(path, 1) > 0) { ide_status(path .. " already exists"); open_file(path); return; }
        local ino = fs_create(path, FT_FILE, 1);
        if (ino == 0) { ide_status("Cannot create " .. path .. ": " .. fs_err); return; }
        if (path_is_text(path) == 1) { fs_data[ino] = ""; }
        else if (path_is_text(path) == 2) { fs_data[ino] = yarn_template(fs_name[ino]); }
        else { fs_data[ino] = "-- " .. fs_name[ino] .. "\n\n"; }
        tree_build();
        open_file(path);
        if (tab_kind[cur_tab] == 1) { set_view(0); ecy = 1; ecx = 1; return; }
        if (tab_kind[cur_tab] == 2) { ecy = 4; ecx = 3; return; }
        ecy = 3;
        ecx = 1;
        if (len(ed) < 3) { add(ed, ""); }
        return;
    }
    if (kind == "saveas" || kind == "rename") {
        if (len(v) == 0 || cur_tab == 0) { return; }
        local path2 = v;
        if (path2[1] != "/") { path2 = ide_proj .. "/" .. v; }
        local old = tab_path[cur_tab];
        if (kind == "rename") {
            local src = fs_lookup(old, 1);
            local dir = fs_lookup_parent(path2, 1);
            if (src == 0 || dir == 0 || fs_rename(src, dir, fs_base) == 0) { ide_status("Cannot rename: " .. fs_err); return; }
            tab_path[cur_tab] = fs_path(src);
        } else {
            tab_path[cur_tab] = path2;
            tab_ro[cur_tab] = 0;
            save_tab();
        }
        tab_kind[cur_tab] = path_is_text(tab_path[cur_tab]);
        if (tab_kind[cur_tab] != 1) { tab_view[cur_tab] = 0; }
        ls_valid = 0;
        rv_valid = 0;
        tree_build();
        ide_status(old .. " -> " .. tab_path[cur_tab]);
        return;
    }
    if (kind == "find") {
        find_text = v;
        find_next();
        return;
    }
    if (kind == "replace") {
        if (len(v) == 0) { return; }
        repl_from = v;
        prompt("replace2", "Replace '" .. v .. "' with: ", "");
        return;
    }
    if (kind == "replace2") {
        replace_all(repl_from, v);
        return;
    }
    if (kind == "goto") {
        local n = v * 1;
        if (n >= 1) {
            ecy = n;
            ecx = 1;
            clamp_cursor();
            sel_on = 0;
            ide_scroll_to_cursor();
            rv_follow = 1;
        }
        return;
    }
    if (kind == "import") {
        if (len(v) == 0) { return; }
        local path3 = v;
        if (path3[1] != "/") { path3 = ide_proj .. "/" .. v; }
        local ino3 = fs_create(path3, FT_FILE, 1);
        if (ino3 == 0) { ide_status("Cannot create " .. path3); return; }
        local txt = "";
        for i = 1 to len(ide_export) { txt = txt .. ide_export[i] .. "\n"; }
        fs_data[ino3] = txt;
        hide_list(ide_export);
        tree_build();
        local ti = index(tab_path, fs_path(ino3));
        if (ti > 0) { close_tab(ti); }
        open_file(path3);
        ide_status("Imported " .. len(ide_export) .. " lines into " .. path3);
        return;
    }
}

proc fs_name_of(path) {
    local k = len(path);
    while (k > 0 && path[k] != "/") { k -= 1; }
    return substr(path, k + 1, len(path));
}

proc find_next() {
    if (len(find_text) == 0 || cur_tab == 0) { return; }
    local n = len(ed);
    for step = 0 to n {
        local y = (ecy - 1 + step) % n + 1;
        local from = 1;
        if (step == 0) { from = ecx; if (sel_empty() == 0) { from = ecx; } }
        local p = str_find(ed[y], find_text, from);
        if (p > 0 && !(step == 0 && p < from)) {
            sel_on = 1;
            say = y;
            sax = p;
            ecy = y;
            ecx = p + len(find_text);
            ide_scroll_to_cursor();
            rv_follow = 1;
            ide_status("Found '" .. find_text .. "' on line " .. y);
            return;
        }
    }
    ide_status("'" .. find_text .. "' not found");
}

proc replace_all(from, to) {
    if (cur_tab == 0 || tab_ro[cur_tab] == 1) { return; }
    undo_mark("other");
    local count = 0;
    for y = 1 to len(ed) {
        local line = ed[y];
        local out = "";
        local p = 1;
        forever {
            local f = str_find(line, from, p);
            if (f == 0) { break; }
            out = out .. substr(line, p, f - 1) .. to;
            p = f + len(from);
            count += 1;
        }
        ed[y] = out .. substr(line, p, len(line));
    }
    ls_valid = 0;
    clamp_cursor();
    if (count > 0) { mark_dirty(); }
    ide_status("Replaced " .. count .. " occurrence(s)");
}

// ===========================================================================
// commands (menus, keys and buttons all end up here)
// ===========================================================================

proc ide_cmd(cmd) {
    imenu_open = 0;
    ac_open = 0;
    ide_full = 1;
    ide_dirty = 1;
    if (cmd == "new") { prompt("new", "New file name: ", ""); return; }
    if (cmd == "save") { save_tab(); return; }
    if (cmd == "saveas") {
        if (cur_tab > 0) { prompt("saveas", "Save as: ", tab_path[cur_tab]); }
        return;
    }
    if (cmd == "rename") {
        if (cur_tab > 0 && tab_ro[cur_tab] == 0) { prompt("rename", "Rename to: ", tab_path[cur_tab]); }
        return;
    }
    if (cmd == "delete") {
        if (cur_tab == 0) { return; }
        dialog(2, "Delete file", "Delete " .. tab_path[cur_tab] .. "?\nThis cannot be undone.", "do_delete", "");
        return;
    }
    if (cmd == "do_delete") {
        local ino = fs_lookup(tab_path[cur_tab], 1);
        if (ino > 0 && tab_ro[cur_tab] == 0) { fs_remove(ino, 0); }
        close_tab(cur_tab);
        tree_build();
        return;
    }
    if (cmd == "close") {
        if (cur_tab == 0) { return; }
        if (tab_dirty[cur_tab] == 1) {
            dialog(2, "Unsaved changes", "Save changes to " .. tab_path[cur_tab] .. "?", "save_close", "force_close");
        } else { close_tab(cur_tab); }
        return;
    }
    if (cmd == "save_close") { if (save_tab() == 1) { close_tab(cur_tab); } return; }
    if (cmd == "force_close") { close_tab(cur_tab); return; }
    if (cmd == "export") {
        if (cur_tab == 0) { return; }
        clear(ide_export);
        for i = 1 to len(ed) { add(ide_export, ed[i]); }
        show_list(ide_export);
        dialog(1, "Export", "The file is now in the list 'ide_export' on the\nstage.  Right-click the list and choose 'export'\nto save it as a .txt file.  File > Import\nhides the list again.", "", "");
        return;
    }
    if (cmd == "import") {
        if (len(ide_export) == 0) {
            show_list(ide_export);
            dialog(1, "Import", "Right-click the list 'ide_export' on the stage,\nchoose 'import' and pick a text file.\nThen choose File > Import again.", "", "");
            return;
        }
        prompt("import", "Import as: ", ide_proj .. "/imported.wsk");
        return;
    }
    if (cmd == "undo") { undo_step(0); return; }
    if (cmd == "redo") { undo_step(1); return; }
    if (cmd == "copy") {
        if (sel_empty() == 0) { clipboard = sel_text(); ide_status("Copied " .. len(clipboard) .. " characters"); }
        else if (cur_tab > 0) { clipboard = ed[ecy] .. "\n"; ide_status("Copied line " .. ecy); }
        return;
    }
    if (cmd == "cut") {
        if (cur_tab == 0 || tab_ro[cur_tab] == 1) { return; }
        undo_mark("other");
        if (sel_empty() == 0) { clipboard = sel_text(); del_sel(); }
        else {
            clipboard = ed[ecy] .. "\n";
            if (len(ed) > 1) { del(ed, ecy); } else { ed[1] = ""; }
            clamp_cursor();
            lines_changed(ecy);
            mark_dirty();
        }
        return;
    }
    if (cmd == "paste") {
        if (cur_tab == 0 || tab_ro[cur_tab] == 1 || len(clipboard) == 0) { return; }
        undo_mark("other");
        del_sel();
        ins_text(clipboard);
        ide_scroll_to_cursor();
        return;
    }
    if (cmd == "selall") {
        if (cur_tab == 0) { return; }
        sel_on = 1; say = 1; sax = 1;
        ecy = len(ed); ecx = len(ed[ecy]) + 1;
        return;
    }
    if (cmd == "find") { prompt("find", "Find: ", find_text); return; }
    if (cmd == "findnext") { if (len(find_text) == 0) { prompt("find", "Find: ", ""); } else { find_next(); } return; }
    if (cmd == "replace") { prompt("replace", "Replace: ", find_text); return; }
    if (cmd == "goto") { prompt("goto", "Go to line: ", ""); return; }
    if (cmd == "comment") { if (cur_tab > 0 && text_tab() != 1) { toggle_comment(); } return; }
    if (cmd == "preview") { if (cur_tab > 0) { set_view(1 - tab_view[cur_tab]); } return; }
    if (cmd == "indent") { if (cur_tab > 0) { indent_lines(1); } return; }
    if (cmd == "unindent") { if (cur_tab > 0) { indent_lines(-1); } return; }
    if (cmd == "dupline") {
        if (cur_tab == 0 || tab_ro[cur_tab] == 1) { return; }
        undo_mark("other");
        insert(ed, ecy + 1, ed[ecy]);
        ecy += 1;
        lines_changed(ecy - 1);
        mark_dirty();
        return;
    }
    if (cmd == "delline") {
        if (cur_tab == 0 || tab_ro[cur_tab] == 1) { return; }
        undo_mark("other");
        if (len(ed) > 1) { del(ed, ecy); } else { ed[1] = ""; }
        clamp_cursor();
        lines_changed(ecy);
        mark_dirty();
        return;
    }
    if (cmd == "run") { ide_run(0); return; }
    if (cmd == "stop") { ide_stop(); return; }
    if (cmd == "check") { ide_run(1); return; }
    if (cmd == "goerr") { ide_goto_error(); return; }
    if (cmd == "clearout") { tty_attr[ide_con] = 7; tty_clear(ide_con); err_msg = ""; return; }
    if (cmd == "tree") { show_tree = 1 - show_tree; ide_layout(); return; }
    if (cmd == "out0") { out_h = 0; ide_layout(); return; }
    if (cmd == "out3") { out_h = OUT_SMALL; ide_layout(); return; }
    if (cmd == "out5") { out_h = OUT_MEDIUM; ide_layout(); return; }
    if (cmd == "out9") { out_h = OUT_LARGE; ide_layout(); return; }
    if (cmd == "theme0") { ide_theme(0); return; }
    if (cmd == "theme1") { ide_theme(1); return; }
    if (cmd == "help") { open_file(ide_docs .. "/quickstart.txt"); return; }
    if (cmd == "ref") { open_file(ide_docs .. "/reference.txt"); return; }
    if (cmd == "keys") {
        dialog(1, "Keyboard shortcuts", "Ctrl+Enter run         Esc  stop / menu bar\nCtrl+Space complete     Ctrl+/  comment\nCtrl+Z/Y undo/redo      Ctrl+D  duplicate line\nCtrl+X/C/V clipboard    Ctrl+A  select all\nShift+arrows select     Ctrl+arrows word jump\nCtrl+Home/End  start/end of file\nCtrl+E   text files: preview / edit", "", "");
        return;
    }
    if (cmd == "about") {
        dialog(1, "About", "Whisker IDE 1.0\n\nAn editor and runtime for the Whisker language,\nbuilt in Scratch: everything is drawn with the pen.\nUses the ScratchOS " .. OS_VERSION .. " compiler and virtual machine.\nText is set in JetBrains Mono (SIL Open Font License).", "", "");
        return;
    }
}

// ===========================================================================
// keyboard
// ===========================================================================

proc ide_key(event) {
    local ev = event;
    if (ev == "caps lock") { kb_caps = 1 - kb_caps; return; }
    ide_dirty = 1;
    // dialog
    if (idlg_kind > 0) {
        if (idlg_kind == 1) {
            if (ev == "enter" || ev == "escape" || ev == " ") { dialog_answer("ok"); }
        } else {
            if (ev == "y" || ev == "Y" || ev == "enter") { dialog_answer("y"); }
            else if (ev == "n" || ev == "N") { dialog_answer("n"); }
            else if (ev == "escape" || ev == "c") { dialog_answer("c"); }
        }
        return;
    }
    // prompt line
    if (len(pr_kind) > 0) {
        if (ev == "enter") { prompt_done(); }
        else if (ev == "escape") { pr_kind = ""; }
        else if (ev == "backspace") { pr_buf = substr(pr_buf, 1, len(pr_buf) - 1); }
        else if (len(ev) == 1) { pr_buf = pr_buf .. ev; }
        return;
    }
    // menus
    if (imenu_open > 0) {
        if (ev == "escape") { imenu_open = 0; ide_full = 1; return; }
        if (ev == "left arrow" || ev == "right arrow") {
            if (ev == "left arrow") { imenu_open -= 1; } else { imenu_open += 1; }
            if (imenu_open < 1) { imenu_open = len(mn_title); }
            if (imenu_open > len(mn_title)) { imenu_open = 1; }
            imenu_sel = menu_first(imenu_open);
            ide_full = 1;
            return;
        }
        if (ev == "up arrow" || ev == "down arrow") {
            imenu_sel = menu_move(imenu_sel, ev == "down arrow");
            return;
        }
        if (ev == "enter") { if (imenu_sel > 0) { ide_cmd(mi_cmd[imenu_sel]); } return; }
        // first letter of a menu title opens it
        for i = 1 to len(mn_title) {
            if (ev == letter(mn_title[i], 1)) { imenu_open = i; imenu_sel = menu_first(i); ide_full = 1; return; }
        }
        return;
    }
    // autocomplete popup
    if (ac_open == 1) {
        if (ev == "up arrow") { ac_sel -= 1; if (ac_sel < 1) { ac_sel = len(ac_items); } return; }
        if (ev == "down arrow") { ac_sel += 1; if (ac_sel > len(ac_items)) { ac_sel = 1; } return; }
        if (ev == "enter") { ac_accept(); return; }
        if (ev == "escape") { ac_open = 0; ide_full = 1; return; }
        if (len(ev) > 1 && ev != "backspace") { ac_open = 0; ide_full = 1; }
    }
    // global keys
    if (ev == "^enter") { ide_cmd("run"); return; }
    if (ev == "escape") {
        if (run_pid > 0) { ide_stop(); return; }
        if (cv_win > 0) { wm_close(cv_win); cv_check(); return; }
        if (sel_on == 1) { sel_on = 0; return; }
        imenu_open = 1;
        imenu_sel = menu_first(1);
        return;
    }
    // the running program gets the keys when the output panel / preview has focus
    if (focus == 1 && run_pid > 0) {
        if (ev == "^c") { ide_stop(); return; }
        local norm = ev;
        if (len(norm) > 2 && (norm[1] == "^" || norm[1] == "+")) { norm = substr(norm, 2, len(norm)); }
        if (tty_mode[ide_con] == 1) { add(kq_pid, run_pid); add(kq_ev, norm); }
        else { tty_key(ide_con, norm); }
        return;
    }
    if (focus == 3 && cv_win > 0) {
        local norm2 = ev;
        if (len(norm2) > 2 && (norm2[1] == "^" || norm2[1] == "+")) { norm2 = substr(norm2, 2, len(norm2)); }
        wm_event(cv_win, "key", 0, 0, norm2);
        return;
    }
    if (focus == 2) {
        if (ev == "up arrow" && tr_sel > 1) { tr_sel -= 1; return; }
        if (ev == "down arrow" && tr_sel < len(tr_path)) { tr_sel += 1; return; }
        if (ev == "enter") { tree_click(tr_sel); return; }
        if (ev == "right arrow" || ev == "left arrow") { focus = 0; return; }
    }
    focus = 0;
    ide_edit_key(ev);
}

proc menu_first(m) {
    for i = 1 to len(mi_menu) {
        if (mi_menu[i] == m && mi_label[i] != "-") { return i; }
    }
    return 0;
}

proc menu_move(cur, down) {
    local i = cur;
    repeat (len(mi_menu)) {
        if (down == 1) { i += 1; } else { i -= 1; }
        if (i > len(mi_menu)) { i = 1; }
        if (i < 1) { i = len(mi_menu); }
        if (mi_menu[i] == imenu_open && mi_label[i] != "-") { return i; }
    }
    return cur;
}

proc ide_edit_key(ev) {
    if (cur_tab == 0) {
        if (ev == "^n") { ide_cmd("new"); }
        return;
    }
    if (in_preview() == 1) { preview_key(ev); return; }
    if (ev == "^e") { set_view(1); return; }
    if (len(ev) == 1) { type_char(ev); ide_scroll_to_cursor(); return; }
    // ctrl shortcuts
    if (ev == "^ ") { ac_show(1); return; }
    if (ev == "^z") { ide_cmd("undo"); return; }
    if (ev == "^y") { ide_cmd("redo"); return; }
    if (ev == "^c") { ide_cmd("copy"); return; }
    if (ev == "^x") { ide_cmd("cut"); return; }
    if (ev == "^v") { ide_cmd("paste"); return; }
    if (ev == "^a") { ide_cmd("selall"); return; }
    if (ev == "^d") { ide_cmd("dupline"); return; }
    if (ev == "^/") { ide_cmd("comment"); return; }
    if (ev == "^f") { ide_cmd("find"); return; }
    if (ev == "^g") { ide_cmd("goto"); return; }
    if (ev == "^s") { ide_cmd("save"); return; }
    if (ev == "^]") { ide_cmd("indent"); return; }
    if (ev == "^[") { ide_cmd("unindent"); return; }
    if (ev == "enter") { key_enter(); ide_scroll_to_cursor(); return; }
    if (ev == "backspace") { key_backspace(); ide_scroll_to_cursor(); return; }
    if (ev == "delete") { key_delete(); return; }
    // movement: "+" = shift (extend selection), "^" = ctrl
    local extend = 0;
    local k = ev;
    if (k[1] == "+" && len(k) > 2) { extend = 1; k = substr(k, 2, len(k)); }
    local ctrl = 0;
    if (k[1] == "^" && len(k) > 2) { ctrl = 1; k = substr(k, 2, len(k)); }
    move_begin(extend);
    last_edit = "";
    local n = len(ed);
    if (k == "left arrow") {
        if (ctrl == 1) { word_left(); }
        else if (ecx > 1) { ecx -= 1; } else if (ecy > 1) { ecy -= 1; ecx = len(ed[ecy]) + 1; }
        want_x = ecx;
    } else if (k == "right arrow") {
        if (ctrl == 1) { word_right(); }
        else if (ecx <= len(ed[ecy])) { ecx += 1; } else if (ecy < n) { ecy += 1; ecx = 1; }
        want_x = ecx;
    } else if (k == "up arrow") {
        if (want_x < ecx) { want_x = ecx; }
        if (ecy > 1) { ecy -= 1; ecx = want_x; clamp_cursor(); }
    } else if (k == "down arrow") {
        if (want_x < ecx) { want_x = ecx; }
        if (ecy < n) { ecy += 1; ecx = want_x; clamp_cursor(); }
    } else if (k == "home") {
        if (ctrl == 1) { ecy = 1; ecx = 1; }
        else {
            // smart home: first non-blank, then column 1
            local ind = indent_of(ed[ecy]) + 1;
            if (ecx == ind) { ecx = 1; } else { ecx = ind; }
        }
        want_x = ecx;
    } else if (k == "end") {
        if (ctrl == 1) { ecy = n; }
        ecx = len(ed[ecy]) + 1;
        want_x = ecx;
    } else if (k == "page up") {
        ecy -= ed_rows - 1;
        etop -= ed_rows - 1;
        if (etop < 1) { etop = 1; }
        clamp_cursor();
    } else if (k == "page down") {
        ecy += ed_rows - 1;
        etop += ed_rows - 1;
        if (etop > n - ed_rows + 1) { etop = n - ed_rows + 1; }
        if (etop < 1) { etop = 1; }
        clamp_cursor();
    }
    if (k == "left arrow" || k == "right arrow" || k == "home" || k == "end") { want_x = 0; }
    ide_scroll_to_cursor();
}

// ===========================================================================
// mouse
// ===========================================================================

proc ide_mouse() {
    local px = round(mouse_x() + SCR_W / 2) - ide_ox * 8;
    local py = round(SCR_H / 2 - mouse_y()) - ide_oy * 16;
    if (px < 0) { px = 0; }
    if (py < 0) { py = 0; }
    if (px > IC * 8 - 1) { px = IC * 8 - 1; }
    if (py > IR * 16 - 1) { py = IR * 16 - 1; }
    local moved = 0;
    if (px != mx || py != my) { moved = 1; }
    mx = px;
    my = py;
    mwas = mdown;
    if (mouse_down() && (IDE_HOSTED == 0 || ide_grab == 1)) { mdown = 1; } else { mdown = 0; }
    local c = floor(mx / 8);
    local r = floor(my / 16);
    if (mdown == 1 && mwas == 0) { ide_press(c, r); }
    else if (mdown == 1 && moved == 1) { ide_drag(c, r); }
    else if (mdown == 0 && mwas == 1) {
        if (mdrag == 3 && cv_win > 0) {
            wm_event(cv_win, "mouseup", mx - (cv_x + 1) * 8, my - (cv_y + 1) * 16, "");
        }
        mdrag = 0;
    }
    // hover in an open menu
    if (imenu_open > 0 && moved == 1) {
        local item = menu_item_at(c, r);
        if (item > 0 && item != imenu_sel) { imenu_sel = item; ide_dirty = 1; }
    }
}

proc menu_item_at(c, r) {
    if (c <= menu_px0 || c >= menu_px1 - 1) { return 0; }
    local row = 1;
    for i = 1 to len(mi_menu) {
        if (mi_menu[i] == imenu_open) {
            row += 1;
            if (row == r && mi_label[i] != "-") { return i; }
        }
    }
    return 0;
}

proc ide_press(c, r) {
    ide_dirty = 1;
    // modal dialog
    if (idlg_kind > 0) {
        local by = idlg_y + idlg_h - 2;
        if (r == by) {
            local mid = idlg_x + floor(idlg_w / 2);
            if (idlg_kind == 1) { dialog_answer("ok"); }
            else if (c >= mid - 14 && c < mid - 7) { dialog_answer("y"); }
            else if (c >= mid - 4 && c < mid + 3) { dialog_answer("n"); }
            else if (c >= mid + 6 && c < mid + 14) { dialog_answer("c"); }
        }
        return;
    }
    if (len(pr_kind) > 0 && r != ROW_STATUS) { pr_kind = ""; }
    // menus
    if (imenu_open > 0) {
        local item = menu_item_at(c, r);
        if (item > 0) { ide_cmd(mi_cmd[item]); return; }
        imenu_open = 0;
        ide_full = 1;
        if (r != 0) { return; }
    }
    if (r == 0) {
        if (c >= IC - 8) {
            if (run_pid > 0) { ide_cmd("stop"); } else { ide_cmd("run"); }
            return;
        }
        for i = 1 to len(mn_title) {
            if (c >= mn_x[i] - 1 && c <= mn_x[i] + len(mn_title[i])) {
                imenu_open = i;
                imenu_sel = menu_first(i);
                return;
            }
        }
        return;
    }
    if (ac_open == 1) {
        if (c >= ac_x && c < ac_x + 24 && r >= ac_y && r < ac_y + len(ac_items)) {
            ac_sel = r - ac_y + 1;
            ac_accept();
            return;
        }
        ac_open = 0;
        ide_full = 1;
    }
    // graphics preview
    if (cv_win > 0 && c >= cv_x && c < cv_x + cv_w && r >= cv_y && r < cv_y + cv_h) {
        focus = 3;
        if (r == cv_y && c >= cv_x + 1 && c <= cv_x + 3) {
            if (proc_slot(win_pid[cv_win]) > 0) { wm_event(cv_win, "close", 0, 0, ""); }
            else { wm_close(cv_win); cv_check(); }
            return;
        }
        if (r > cv_y && r < cv_y + cv_h - 1 && c > cv_x && c < cv_x + cv_w - 1) {
            mdrag = 3;
            wm_event(cv_win, "mousedown", mx - (cv_x + 1) * 8, my - (cv_y + 1) * 16, "");
        }
        return;
    }
    // tabs row: click a tab to switch, its x / dot to close it
    if (r == ROW_TABS) {
        if (text_tab() == 1 && c >= IC - VIEW_SW) {
            if (c < IC - VIEW_SW + 9) { set_view(1); } else { set_view(0); }
            return;
        }
        local x = 0;
        for i = 1 to len(tab_path) {
            local lw = tab_label_w(i);
            if (c >= x && c < x + lw) {
                if (i != cur_tab) { tab_activate(i); }
                if (c == x + lw - 2) { ide_cmd("close"); }
                return;
            }
            x += lw;
        }
        return;
    }
    // output panel
    if (out_h > 0 && r == out_top) {
        if (c >= IC - 19 && c < IC - 12) { ide_cmd("clearout"); return; }
        if (c >= IC - 12 && c < IC - 9) {
            if (out_h < OUT_LARGE) { out_h += 3; if (out_h > OUT_LARGE) { out_h = OUT_LARGE; } ide_layout(); }
            return;
        }
        if (c >= IC - 9 && c < IC - 6) {
            if (out_h > OUT_SMALL) { out_h -= 3; if (out_h < OUT_SMALL) { out_h = OUT_SMALL; } ide_layout(); }
            return;
        }
        if (c >= IC - 6 && c < IC - 3) { out_h = 0; ide_layout(); return; }
        if (err_line > 0 && c >= 9) { ide_goto_error(); return; }
        focus = 1;
        return;
    }
    if (out_h > 0 && r > out_top && r < ROW_STATUS) {
        focus = 1;
        return;
    }
    if (r == ROW_STATUS && out_h == 0) { out_h = OUT_MEDIUM; ide_layout(); return; }
    // file tree
    if (show_tree == 1 && c < TREE_W && r >= ed_y0 && r < out_top) {
        focus = 2;
        if (r == ed_y0) {
            if (c >= TREE_W - 5) { ide_cmd("new"); }
            return;
        }
        if (c == TREE_W - 2 && len(tr_path) > tree_rows()) {
            mdrag = 4;
            sb_press(my, ed_y0 + 1, tree_rows(), len(tr_path), tr_top);
            ide_drag(c, r);
            return;
        }
        tree_click(tr_top + r - ed_y0 - 1);
        return;
    }
    // scrollbar
    if (c == IC - 1 && r >= ed_y0 && r < out_top && in_preview() == 0) {
        if (len(ed) > ed_rows) {
            mdrag = 2;
            sb_press(my, ed_y0, ed_rows, len(ed), etop);
            ide_drag(c, r);
        }
        return;
    }
    // text preview: scrollbar only (double-click opens the editor there)
    if (r >= ed_y0 && r < out_top && in_preview() == 1) {
        focus = 0;
        if (c == IC - 1 && len(rl_text) > ed_rows) {
            mdrag = 5;
            sb_press(my, ed_y0, ed_rows, len(rl_text), rv_top);
            ide_drag(c, r);
            return;
        }
        local t = now_secs();
        local k = rv_top + r - ed_y0;
        if (t - last_click < 0.4 && last_click_y == k && k <= len(rl_src)) {
            last_click = 0;
            ecy = rl_src[k];
            ecx = 1;
            etop = ecy;
            set_view(0);
            ecy = rl_src[k];
            ecx = 1;
            clamp_cursor();
            ide_scroll_to_cursor();
            return;
        }
        last_click = t;
        last_click_y = k;
        return;
    }
    // editor
    if (r >= ed_y0 && r < out_top && cur_tab > 0) {
        focus = 0;
        local y = etop + r - ed_y0;
        if (y > len(ed)) { y = len(ed); }
        local x = eleft + c - txt_x0;
        if (c < txt_x0) {
            // gutter: select the whole line
            sel_on = 1; say = y; sax = 1;
            ecy = y; ecx = len(ed[y]) + 1;
            if (y < len(ed)) { ecy = y + 1; ecx = 1; }
            return;
        }
        if (x < 1) { x = 1; }
        if (x > len(ed[y]) + 1) { x = len(ed[y]) + 1; }
        local t = now_secs();
        if (t - last_click < 0.4 && last_click_x == x && last_click_y == y) {
            select_word(y, x);
            last_click = 0;
            return;
        }
        last_click = t;
        last_click_x = x;
        last_click_y = y;
        sel_on = 1;
        say = y;
        sax = x;
        ecy = y;
        ecx = x;
        want_x = 0;
        last_edit = "";
        mdrag = 1;
    }
}

// scroll a pane by `lines` (mouse wheel)
proc ide_wheel(lines) {
    local c = floor(mx / 8);
    local r = floor(my / 16);
    if (show_tree == 1 && c < TREE_W && r > ed_y0 && r < out_top) {
        tr_top += lines;
        if (tr_top > len(tr_path) - tree_rows() + 1) { tr_top = len(tr_path) - tree_rows() + 1; }
        if (tr_top < 1) { tr_top = 1; }
    } else if (r >= ed_y0 && r < out_top && in_preview() == 1) {
        rv_scroll(lines);
    } else if (r >= ed_y0 && r < out_top && cur_tab > 0) {
        etop += lines;
        if (etop > len(ed) - ed_rows + 1) { etop = len(ed) - ed_rows + 1; }
        if (etop < 1) { etop = 1; }
    }
    ide_dirty = 1;
}

proc ide_drag(c, r) {
    if (mdrag == 1 && cur_tab > 0) {
        local y = etop + r - ed_y0;
        if (r < ed_y0) { y = etop - 1; }
        if (r >= out_top) { y = etop + ed_rows; }
        if (y < 1) { y = 1; }
        if (y > len(ed)) { y = len(ed); }
        local x = eleft + c - txt_x0;
        if (x < 1) { x = 1; }
        if (x > len(ed[y]) + 1) { x = len(ed[y]) + 1; }
        if (x != ecx || y != ecy) {
            ecy = y;
            ecx = x;
            ide_scroll_to_cursor();
            ide_dirty = 1;
        }
    } else if (mdrag == 2) {
        local t = sb_top_at(my, ed_y0, ed_rows, len(ed));
        if (t != etop) { etop = t; ide_dirty = 1; }
    } else if (mdrag == 5) {
        local t3 = sb_top_at(my, ed_y0, ed_rows, len(rl_text));
        if (t3 != rv_top) { rv_top = t3; ide_dirty = 1; }
    } else if (mdrag == 4) {
        local t2 = sb_top_at(my, ed_y0 + 1, tree_rows(), len(tr_path));
        if (t2 != tr_top) { tr_top = t2; ide_dirty = 1; }
    } else if (mdrag == 3 && cv_win > 0) {
        wm_event(cv_win, "drag", mx - (cv_x + 1) * 8, my - (cv_y + 1) * 16, "");
    }
}

// ===========================================================================
// main loop
// ===========================================================================

// hosted: called by the ScratchOS kernel every frame while the IDE window
// is open (keys arrive through ide_key, the scheduler runs in the kernel)
proc ide_tick_hosted() {
    ide_mouse();
    if (wheel != 0 && ide_win > 0 && wm_owner_at(floor(m_x / 8), floor(m_y / 16)) == ide_win) {
        local w = wheel;
        wheel = 0;
        if (imenu_open == 0 && idlg_kind == 0) { ide_wheel(w * 3); }
    }
    ide_check_run();
    if (len(status_msg) > 0 && now_secs() >= status_until) { status_msg = ""; ide_dirty = 1; }
    ide_render();
    if (focus == 1 && wm_top() == ide_win) { cur_t = ide_con; }
    ide_caret();
}

proc ide_tick() {
    frames += 1;
    if (len(tr_path) == 0) { tree_build(); }
    local n = 0;
    while (len(kb_queue) > 0 && n < 48) {
        local ev = kb_queue[1];
        del(kb_queue, 1);
        last_key_time = days2000() * 86400;
        ide_key(ev);
        n += 1;
    }
    ide_mouse();
    if (wheel != 0) {
        local w = wheel;
        wheel = 0;
        if (imenu_open == 0 && idlg_kind == 0) { ide_wheel(w * 3); }
    }
    sched_run(9);
    power_req = -1;
    ide_check_run();
    cv_check();
    if (len(status_msg) > 0 && now_secs() >= status_until) { status_msg = ""; ide_dirty = 1; }
    ide_render();
    tty_render();
    if (focus == 1) { cur_t = ide_con; } else { cur_t = 0; }
    tty_cursor_update();
    ide_caret();
}
