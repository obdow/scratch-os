// ===========================================================================
// ide/gfx.sbs - pen graphics primitives for the Whisker IDE
//
// Same interface as ../gfx.sbs (ScratchOS), but with the IDE's palette:
// 112 entries of arbitrary RGB, each drawn from one of several base costume
// sets (JetBrains Mono glyphs + rects) with the colour and brightness
// effects.  See tools/ide_assets.py for the derivation and the index map.
// ===========================================================================

const SCREEN_W = 480;
const SCREEN_H = 360;
const CELL_W = 8;
const CELL_H = 16;
const COLS = 60;
const ROWS = 22;

list pal_gb = data("ide_pal_gb");     // costume number of glyph 0 in the entry's base set
list pal_rb = data("ide_pal_rb");     // costume number of the 1x1 rect in the entry's base set
list pal_hue = data("ide_pal_hue");
list pal_bri = data("ide_pal_bri");
list pal_rgb = data("ide_pal_rgb");   // RGB integer (pen lines)
list gmap = data("ide_gmap");         // code+1 -> glyph slot in a set ('?' if not included)

var gfx_col = -1;        // colour currently applied via effects
var gfx_gbase = 1;       // costume number of glyph 0 in the current base set
var gfx_rbase = 513;     // costume number of rect 1x1 in the current base set
var gfx_pen_col = -1;
var gfx_pen_size = -1;
var gfx_stamps = 0;      // drawing activity counter (mouse pointer repair)

// clip rectangle for line drawing (screen coords, inclusive-exclusive)
var clip_x0 = 0;
var clip_y0 = 0;
var clip_x1 = 480;
var clip_y1 = 360;

proc gfx_init() {
    pen_clear();
    pen_up();
    clear_effects();
    gfx_col = -1;
    gfx_pen_col = -1;
    gfx_pen_size = -1;
    size(100);
    hide();
}

// Apply palette colour c to this sprite's effects (cached).
proc gfx_color(c) {
    if (c == gfx_col) { return; }
    gfx_col = c;
    gfx_gbase = pal_gb[c + 1];
    gfx_rbase = pal_rb[c + 1];
    effect("color", pal_hue[c + 1]);
    effect("brightness", pal_bri[c + 1]);
}

// switch the 16 terminal / graphics colours to a theme's set (0 dark, 1 light)
proc gfx_ansi_theme(n) {
    local src = 80 + n * 16;
    for i = 1 to 16 {
        pal_gb[i] = pal_gb[src + i];
        pal_rb[i] = pal_rb[src + i];
        pal_hue[i] = pal_hue[src + i];
        pal_bri[i] = pal_bri[src + i];
        pal_rgb[i] = pal_rgb[src + i];
    }
    gfx_col = -1;
    gfx_pen_col = -1;
}

// Stamp glyph `code` (0..255; codes without a glyph show '?') with its top-left at screen pixel (x, y).
proc gfx_glyph(x, y, code, c) {
    gfx_color(c);
    goto(x - 240, 180 - y);
    costume(gfx_gbase + gmap[code + 1]);
    stamp();
    gfx_stamps += 1;
}

// Fill rectangle with palette colour c.  Uses power-of-two rect costumes,
// so any rectangle up to 256x256 takes at most 4 stamps.
proc gfx_fill(x, y, w, h, c) {
    if (w < 1 || h < 1) { return; }
    gfx_color(c);
    local sw = 1;
    local i = 0;
    while (sw * 2 <= w && i < 8) { sw = sw * 2; i += 1; }
    local sh = 1;
    local j = 0;
    while (sh * 2 <= h && j < 8) { sh = sh * 2; j += 1; }
    costume(gfx_rbase + i * 9 + j);
    gfx_stamps += 1;
    local ty = y;
    forever {
        if (ty + sh > y + h) { ty = y + h - sh; }
        local tx = x;
        forever {
            if (tx + sw > x + w) { tx = x + w - sw; }
            goto(tx - 240, 180 - ty);
            stamp();
            if (tx + sw >= x + w) { break; }
            tx += sw;
        }
        if (ty + sh >= y + h) { break; }
        ty += sh;
    }
}

// Draw a text cell: background + glyph.  col,row in character cells.
proc gfx_cell(col, row, code, fg, bg) {
    gfx_fill(col * 8, row * 16, 8, 16, bg);
    if (code != 32 && code != 0 && fg != bg) {
        gfx_glyph(col * 8, row * 16, code, fg);
    }
}

// Pen line in screen coordinates with palette colour and size.
proc gfx_line(x1, y1, x2, y2, c, sz) {
    if (c != gfx_pen_col) {
        gfx_pen_col = c;
        pen_color(pal_rgb[c + 1]);
    }
    if (sz != gfx_pen_size) {
        gfx_pen_size = sz;
        pen_size(sz);
    }
    goto(x1 - 239.5, 179.5 - y1);
    pen_down();
    goto(x2 - 239.5, 179.5 - y2);
    pen_up();
    gfx_stamps += 1;
}
