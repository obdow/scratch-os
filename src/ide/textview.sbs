// ===========================================================================
// textview.sbs - native rendering of text files in the Whisker IDE
// (included inside sprite Kernel, after ide.sbs)
//
// Tabs whose file is not a .wsk program are text tabs (tab_kind 1).  They
// open in the Preview view: the text is laid out to the editor width with
// word wrap and light Markdown-style formatting.  Ctrl+E (or the
// Preview / Edit switch in the tab bar) flips to the plain-text editor.
//
//   # Heading / ## Heading / ### Heading     headings (level 1 underlined)
//   * item / - item / + item / 1. item      lists with hanging indents
//   > quote                                 quotes with a bar on the left
//   ---                                     horizontal rule
//   ```  ...  ```                           code block, Whisker highlighting
//   `code`  **bold**  *emphasis*            inline styles (markers hidden)
//
// Every other line is a paragraph: its indentation is kept and long lines
// wrap at word boundaries with the same indent.
//
// The layout is a list of display lines (rl_*): text, a style letter per
// character, a line background, a decoration and the source line it came
// from.  It is rebuilt when the text, the tab, the width or the theme
// changes (rv_valid = 0).
// ===========================================================================

list tab_kind;            // 0 Whisker program, 1 text file
list tab_view;            // 0 editor, 1 preview
list tab_rtop;            // preview scroll position per tab

list rl_text;             // display lines
list rl_sty;              // one style letter per character (see sty_col)
list rl_bg;               // 0 normal, 1 code block
list rl_dec;              // 0 none, 1 heading underline, 2 quote bar
list rl_src;              // source line number
var rv_valid = 0;
var rv_tab = 0;
var rv_w = 0;
var rv_top = 1;
var rv_follow = 0;        // 1: scroll the preview to the cursor line (find / go to)

// 1 when the path is a text file rather than a Whisker program
proc path_is_text(p) {
    local n = len(p);
    if (n > 4 && substr(p, n - 3, n) == ".wsk") { return 0; }
    return 1;
}

proc text_tab() {
    if (cur_tab == 0) { return 0; }
    return tab_kind[cur_tab];
}

proc in_preview() {
    if (cur_tab == 0) { return 0; }
    return tab_view[cur_tab];
}

// style letter -> palette colour.  Scratch's = ignores case, so the
// letters are all distinct lower-case ones.
proc sty_col(ch) {
    if (ch == "n") { return C_FG; }
    if (ch == "h") { return C_HEADER; }
    if (ch == "t") { return C_ACCENT; }
    if (ch == "u") { return C_HEADER; }
    if (ch == "c") { return C_STR; }
    if (ch == "b") { return C_HEADER; }
    if (ch == "d") { return C_DIM; }
    if (ch == "q") { return C_COM; }
    if (ch == "k") { return C_KW; }
    if (ch == "s") { return C_STR; }
    if (ch == "m") { return C_NUM; }
    if (ch == "o") { return C_COM; }
    if (ch == "l") { return C_LIB; }
    if (ch == "r") { return C_BORDER; }
    return C_FG;
}

proc rep_char(ch, n) {
    local s = "";
    repeat (n) { s = s .. ch; }
    return s;
}

proc rv_add(text, sty, bg, dec, src) {
    add(rl_text, text);
    add(rl_sty, sty);
    add(rl_bg, bg);
    add(rl_dec, dec);
    add(rl_src, src);
}

// inline styles: `code` and **bold**; the markers are dropped.
// Results in rv_p (text) and rv_s (styles); `base` is the block's style.
var rv_p = "";
var rv_s = "";

proc rv_inline(s, base) {
    rv_p = "";
    rv_s = "";
    emph_open = 0;
    local code = 0;
    local bold = 0;
    local emph = 0;
    local n = len(s);
    local i = 1;
    while (i <= n) {
        local ch = s[i];
        if (ch == "`") {
            code = 1 - code;
            i += 1;
        } else if (code == 0 && ch == "*" && i < n && s[i + 1] == "*") {
            bold = 1 - bold;
            i += 2;
        } else if (code == 0 && (ch == "*" || ch == "_") && emph_marker(s, i) == 1) {
            emph = 1 - emph;
            i += 1;
        } else {
            rv_p = rv_p .. ch;
            if (code == 1) { rv_s = rv_s .. "c"; }
            else if (bold == 1 || emph == 1) { rv_s = rv_s .. "b"; }
            else { rv_s = rv_s .. base; }
            i += 1;
        }
    }
}

// 1 when the * or _ at s[i] opens or closes an *emphasis*: an opener is
// followed by a non-space and closed later on the line; a closer follows a
// non-space and is not followed by a letter or digit (so snake_case and
// 2*3 stay as they are)
var emph_open = 0;

proc emph_marker(s, i) {
    local ch = s[i];
    local n = len(s);
    if (emph_open == 1) {
        if (i > 1 && s[i - 1] != " " && (i == n || char_class[ord(s[i + 1]) + 1] == 0 || s[i + 1] == " ")) {
            emph_open = 0;
            return 1;
        }
        return 0;
    }
    if (i == n || s[i + 1] == " ") { return 0; }
    if (i > 1 && char_class[ord(s[i - 1]) + 1] != 0 && s[i - 1] != " ") { return 0; }
    for k = i + 2 to n {
        if (s[k] == ch && s[k - 1] != " ") {
            if (k == n || char_class[ord(s[k + 1]) + 1] == 0 || s[k + 1] == " ") {
                emph_open = 1;
                return 1;
            }
        }
    }
    return 0;
}

// word-wrap text p (styles s) into display lines of width w.  The first
// line starts with `lead` (styles lead_s); later lines are indented by hang.
proc rv_wrap(p, s, lead, lead_s, hang, w, bg, dec, src) {
    local rp = p;
    local rs = s;
    local first = 1;
    forever {
        local pre = lead;
        local pre_s = lead_s;
        if (first == 0) { pre = rep_space(hang); pre_s = rep_char("n", hang); }
        local room = w - len(pre);
        if (room < 8) { room = 8; }
        if (len(rp) <= room) {
            rv_add(pre .. rp, pre_s .. rs, bg, dec, src);
            return;
        }
        // break at the last space that fits, else cut the word
        local cut = 0;
        local k = room + 1;
        while (k > 1 && cut == 0) {
            if (rp[k] == " ") { cut = k; }
            k -= 1;
        }
        if (cut == 0) {
            rv_add(pre .. substr(rp, 1, room), pre_s .. substr(rs, 1, room), bg, dec, src);
            rp = substr(rp, room + 1, len(rp));
            rs = substr(rs, room + 1, len(rs));
        } else {
            rv_add(pre .. substr(rp, 1, cut - 1), pre_s .. substr(rs, 1, cut - 1), bg, dec, src);
            rp = substr(rp, cut + 1, len(rp));
            rs = substr(rs, cut + 1, len(rs));
        }
        first = 0;
        if (len(rp) == 0) { return; }
    }
}

// number of leading `ch` characters in s
proc count_lead(s, ch) {
    local k = 0;
    while (k < len(s) && s[k + 1] == ch) { k += 1; }
    return k;
}

// 1 when s is "---", "***" or "___" (three or more, nothing else)
proc is_rule(s) {
    if (len(s) < 3) { return 0; }
    local ch = s[1];
    if (!(ch == "-" || ch == "*" || ch == "_")) { return 0; }
    for i = 2 to len(s) { if (s[i] != ch) { return 0; } }
    return 1;
}

// length of a "12. " list marker at the start of s (0 if none)
proc num_marker(s) {
    local k = 0;
    while (k < len(s) && char_class[ord(s[k + 1]) + 1] == 2) { k += 1; }
    if (k == 0 || k + 2 > len(s)) { return 0; }
    if (s[k + 1] == "." && s[k + 2] == " ") { return k + 2; }
    return 0;
}

proc rv_width() {
    local w = IC - 1 - ed_x0 - 4;
    if (w > 100) { w = 100; }
    return w;
}

proc rv_layout() {
    clear(rl_text); clear(rl_sty); clear(rl_bg); clear(rl_dec); clear(rl_src);
    local w = rv_width();
    rv_w = w;
    rv_tab = cur_tab;
    rv_valid = 1;
    local incode = 0;
    for y = 1 to len(ed) {
        local line = ed[y];
        local ind = indent_of(line);
        local t = substr(line, ind + 1, len(line));
        if (count_lead(t, "`") >= 3) {
            incode = 1 - incode;
            // the fence lines become the block's top and bottom padding
            rv_add("", "", 1, 0, y);
        } else if (incode == 1) {
            // code block: Whisker highlighting, no wrapping (cut at the width)
            hl_line(line, 0);
            local cs = "";
            for i = 1 to len(line) {
                local f = hl_fg[i];
                if (f == C_KW) { cs = cs .. "k"; }
                else if (f == C_STR) { cs = cs .. "s"; }
                else if (f == C_NUM) { cs = cs .. "m"; }
                else if (f == C_COM) { cs = cs .. "o"; }
                else if (f == C_LIB) { cs = cs .. "l"; }
                else { cs = cs .. "n"; }
            }
            rv_add(" " .. substr(line, 1, w - 2), "n" .. substr(cs, 1, w - 2), 1, 0, y);
        } else if (len(t) == 0) {
            rv_add("", "", 0, 0, y);
        } else if (is_rule(t) == 1) {
            rv_add(rep_char("─", w), rep_char("r", w), 0, 0, y);
        } else {
            local hn = count_lead(t, "#");
            local nm = num_marker(t);
            if (hn >= 1 && hn < len(t) && t[hn + 1] == " ") {
                // heading
                local hs = "h";
                local dec = 1;
                if (hn == 2) { hs = "t"; dec = 0; }
                if (hn >= 3) { hs = "u"; dec = 0; }
                rv_inline(substr(t, hn + 2, len(t)), hs);
                rv_wrap(rv_p, rv_s, "", "", 0, w, 0, dec, y);
            } else if (len(t) > 1 && (t[1] == "*" || t[1] == "-" || t[1] == "+") && t[2] == " ") {
                // bullet item
                rv_inline(substr(t, 3, len(t)), "n");
                rv_wrap(rv_p, rv_s, rep_space(ind) .. "• ", rep_char("n", ind) .. "dn", ind + 2, w, 0, 0, y);
            } else if (nm > 0) {
                // numbered item
                rv_inline(substr(t, nm + 1, len(t)), "n");
                rv_wrap(rv_p, rv_s, rep_space(ind) .. substr(t, 1, nm), rep_char("n", ind) .. rep_char("d", nm), ind + nm, w, 0, 0, y);
            } else if (t[1] == ">") {
                // quote
                local qt = substr(t, 2, len(t));
                if (len(qt) > 0 && qt[1] == " ") { qt = substr(qt, 2, len(qt)); }
                rv_inline(qt, "q");
                rv_wrap(rv_p, rv_s, "  ", "nn", 2, w, 0, 2, y);
            } else {
                // paragraph: keep its indentation
                rv_inline(t, "n");
                rv_wrap(rv_p, rv_s, rep_space(ind), rep_char("n", ind), ind, w, 0, 0, y);
            }
        }
    }
    if (len(rl_text) == 0) { rv_add("", "", 0, 0, 1); }
}

// first display line that shows source line y
proc rv_line_of(y) {
    for k = 1 to len(rl_src) {
        if (rl_src[k] >= y) { return k; }
    }
    return len(rl_src);
}

proc rv_clamp() {
    local mx = len(rl_text) - ed_rows + 1;
    if (rv_top > mx) { rv_top = mx; }
    if (rv_top < 1) { rv_top = 1; }
}

proc rv_check() {
    if (rv_valid == 0 || rv_tab != cur_tab || rv_w != rv_width()) { rv_layout(); }
    if (rv_follow == 1) {
        rv_follow = 0;
        rv_top = rv_line_of(ecy) - 2;
    }
    rv_clamp();
}

proc ide_compose_preview() {
    rv_check();
    local n = len(rl_text);
    local x0 = ed_x0;
    for r = 0 to ed_rows - 1 {
        local row = ed_y0 + r;
        local k = rv_top + r;
        fill_row(row, x0, IC - 1, C_FG + AB * C_EDBG);
        if (k <= n) {
            local bg = C_EDBG;
            if (rl_bg[k] == 1) {
                bg = C_CURLINE;
                fill_row(row, x0 + 1, x0 + 2 + rv_w, C_FG + AB * bg);
            }
            local s = rl_text[k];
            local st = rl_sty[k];
            for j = 1 to len(s) {
                put(x0 + 1 + j, row, ord(s[j]), sty_col(st[j]) + AB * bg);
            }
            if (rl_dec[k] == 1) { deco_row(row, x0 + 2, x0 + 1 + len(s), D_UNDER); }
            if (rl_dec[k] == 2) { put_deco(x0 + 2, row, D_LEFT); }
        }
    }
    compose_vscroll(IC - 1, ed_y0, ed_rows, n, rv_top);
}

// scroll the preview by `lines`
proc rv_scroll(lines) {
    rv_top += lines;
    rv_clamp();
    ide_dirty = 1;
}

// keys while a tab shows its preview
proc preview_key(ev) {
    if (ev == "^e") { set_view(0); return; }
    if (ev == "^f") { ide_cmd("find"); return; }
    if (ev == "^g") { ide_cmd("goto"); return; }
    if (ev == "^c" || ev == "^a") { ide_status("Switch to Edit (Ctrl+E) to select text"); return; }
    if (ev == "up arrow") { rv_scroll(-1); return; }
    if (ev == "down arrow") { rv_scroll(1); return; }
    if (ev == "page up") { rv_scroll(0 - (ed_rows - 1)); return; }
    if (ev == "page down" || ev == " ") { rv_scroll(ed_rows - 1); return; }
    if (ev == "home" || ev == "^home") { rv_top = 1; rv_clamp(); return; }
    if (ev == "end" || ev == "^end") { rv_top = len(rl_text); rv_clamp(); return; }
    if (len(ev) == 1 || ev == "enter" || ev == "backspace" || ev == "delete") {
        ide_status("Preview - press Ctrl+E to edit this file");
    }
}

// 0 editor, 1 preview, for the current text tab
proc set_view(v) {
    if (cur_tab == 0) { return; }
    if (tab_kind[cur_tab] == 0) {
        if (v == 1) { ide_status("Preview is for text files; .wsk files open in the editor"); }
        return;
    }
    if (v == tab_view[cur_tab]) { return; }
    rv_check();
    if (v == 0) {
        // keep the same place in the file
        etop = rl_src[rv_top];
        if (ecy < etop || ecy > etop + ed_rows - 1) { ecy = etop; ecx = 1; }
        clamp_cursor();
        ide_scroll_to_cursor();
    } else {
        rv_valid = 0;
        rv_layout();
        rv_top = rv_line_of(etop);
        rv_clamp();
        sel_on = 0;
        ac_open = 0;
    }
    tab_view[cur_tab] = v;
    ide_full = 1;
    ide_dirty = 1;
}
