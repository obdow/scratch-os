// ===========================================================================
// Whisker IDE - entry point
//
// A stand-alone development environment for the Whisker language.  It
// reuses the ScratchOS kernel modules unchanged (pen text engine, keyboard
// clones, file system, Whisker compiler + VM, natives, canvas drawing) and
// replaces the shell/desktop with the IDE user interface in ide.sbs.
// Graphics use the IDE's own costumes and palette (ide/gfx.sbs and
// tools/ide_assets.py): JetBrains Mono text and modern dark/light themes.
// ===========================================================================

include "../kbd.sbs";

global list ide_export;      // File > Export / Import go through this list monitor

include "../cloud.sbs";

sprite Kernel {
    costumes "ide_glyphs";
    include "../gfx.sbs";
    include "../ui.sbs";
    include "../str.sbs";
    include "../tty.sbs";
    include "../fs.sbs";
    include "../proc.sbs";
    include "../shell.sbs";
    include "../boot.sbs";
    include "../heap.sbs";
    include "../wcomp.sbs";
    include "../vm.sbs";
    include "../natives.sbs";
    include "../natives_sys.sbs";
    include "../caps.sbs";
    include "../image.sbs";
    include "../net.sbs";
    include "../wm.sbs";
    include "ide.sbs";
    include "textview.sbs";        // native rendering of text files
    include "yarnhl.sbs";          // Yarn pages: highlighting, indent

    var con = 0;            // the Output panel tty (kernel messages go here too)
    var frames = 0;
    var gui = 0;

    proc kernel_boot() { }

    // Scratch turns the mouse wheel into "up/down arrow key pressed" hat
    // events without setting the key state, which tells it apart from a
    // real arrow key.
    on key "up arrow" {
        if (!(key("up arrow"))) { wheel -= 1; }
    }
    on key "down arrow" {
        if (!(key("down arrow"))) { wheel += 1; }
    }

    on flag {
        ide_splash();
        wait(0);                // show the splash while booting
        ide_boot();
        forever {
            ide_tick();
        }
    }
}
