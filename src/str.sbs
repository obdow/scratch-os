// ===========================================================================
// str.sbs - string helpers (included inside sprite Kernel)
//
// Scratch's `=` and list search are case-insensitive, and Scratch has no
// character-code block.  ord() uses the costume trick: glyph costumes are
// named by their character and costume lookup by name is case-sensitive, so
// `switch costume to (ch)` then `costume #` yields the CP437 code.
// ===========================================================================

list cp437 = data("cp437");          // code+1 -> character
list up_map = data("upper");         // code+1 -> uppercase code
list lo_map = data("lower");         // code+1 -> lowercase code
list char_class = data("char_class");

// CP437 code of a single character (63 '?' if it has no CP437 glyph).
// The costume lookup runs first: comparisons of "0" with whitespace are
// unreliable in Scratch, so whitespace is only tested when the lookup fails.
proc ord(ch) {
    costume(64);
    costume(ch);
    local c = costume_num();
    if (c != 64) { return c - 1; }
    if (len(ch) == 0) { return 0; }
    if (ch == " ") { return 32; }
    if (ch == "\n") { return 10; }
    if (ch == "\t") { return 9; }
    if (ch == "\r") { return 13; }
    if (ch == "\e") { return 27; }
    if (ch == "\x08") { return 8; }
    return 63;
}

proc chr(code) {
    return cp437[floor(code) + 1];
}

// case-sensitive string equality
proc streq(a, b) {
    if (a != b) { return 0; }
    local n = len(a);
    if (n != len(b)) { return 0; }
    local i = 1;
    while (i <= n) {
        if (a[i] != b[i]) { return 0; }
        costume(64);
        costume(a[i]);
        local ca = costume_num();
        costume(64);
        costume(b[i]);
        if (costume_num() != ca) { return 0; }
        i += 1;
    }
    return 1;
}

proc str_upper(s) {
    local out = "";
    for i = 1 to len(s) {
        out = out .. cp437[up_map[ord(s[i]) + 1] + 1];
    }
    return out;
}

proc str_lower(s) {
    local out = "";
    for i = 1 to len(s) {
        out = out .. cp437[lo_map[ord(s[i]) + 1] + 1];
    }
    return out;
}

// substring, 1-based inclusive (like Lua string.sub with positive indices)
proc substr(s, a, b) {
    local n = len(s);
    local i = a;
    local j = b;
    if (i < 0) { i = n + i + 1; }
    if (j < 0) { j = n + j + 1; }
    if (i < 1) { i = 1; }
    if (j > n) { j = n; }
    local out = "";
    while (i <= j) {
        out = out .. s[i];
        i += 1;
    }
    return out;
}

// position of plain substring `pat` in `s` starting at `init`, or 0
proc str_find(s, pat, init) {
    local n = len(s);
    local m = len(pat);
    if (m == 0) { return init; }
    local first = pat[1];
    local i = init;
    while (i <= n - m + 1) {
        if (s[i] == first) {
            local k = 2;
            while (k <= m && s[i + k - 1] == pat[k]) { k += 1; }
            if (k > m) {
                if (streq(substr(s, i, i + m - 1), pat) == 1) { return i; }
            }
        }
        i += 1;
    }
    return 0;
}

proc str_rep(s, n) {
    local out = "";
    repeat (n) { out = out .. s; }
    return out;
}

proc str_trim(s) {
    local n = len(s);
    local i = 1;
    while (i <= n && (s[i] == " " || s[i] == "\t" || s[i] == "\n" || s[i] == "\r")) { i += 1; }
    local j = n;
    while (j >= i && (s[j] == " " || s[j] == "\t" || s[j] == "\n" || s[j] == "\r")) { j -= 1; }
    return substr(s, i, j);
}

// left-pad / right-pad to width
proc pad_left(s, w) {
    local out = s;
    while (len(out) < w) { out = " " .. out; }
    return out;
}

proc pad_right(s, w) {
    local out = s;
    while (len(out) < w) { out = out .. " "; }
    return out;
}

// is the value numeric (as Scratch/JS would parse it)?
proc is_number(v) {
    if (v == "") { return 0; }
    if (str_trim(v) != v) { return 0; }
    if ((v * 1) == v) {
        // reject things like "0x10" / "Infinity" style values: require digit/sign/dot chars
        for i = 1 to len(v) {
            local c = v[i];
            if (!(contains("0123456789.-+eE", c))) { return 0; }
        }
        return 1;
    }
    return 0;
}

// format number: integers without decimal point, others rounded to 10 digits
proc fmt_num(v) {
    if (v == round(v)) { return round(v); }
    return v;
}
