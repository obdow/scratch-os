// ===========================================================================
// boot.sbs - the boot screen, kernel start-up, init (pid 1) and power
// management (included inside sprite Kernel)
// ===========================================================================

const OS_NAME = "ScratchOS";
const OS_VERSION = "1.0";
const KERNEL_NAME = "scratch-kernel";

var boot_t0 = 0;
var skip_boot = 0;
var power_req = -1;      // -1 none, 0 shutdown, 1 reboot
var halted = 0;

proc boot_time() {
    local t = floor((now_secs() - boot_t0) * 1000000) / 1000000;
    local s = "" .. floor(t);
    local frac = "" .. floor((t - floor(t)) * 1000000);
    while (len(frac) < 6) { frac = "0" .. frac; }
    return pad_left(s, 5) .. "." .. frac;
}

proc klog(msg) {
    tty_write(con, "\e[32m[" .. boot_time() .. "]\e[0m " .. msg .. "\n");
}

proc kok(msg) {
    tty_write(con, "\e[97m[\e[92m  OK  \e[97m]\e[0m " .. msg .. "\n");
}

// drain keyboard during boot: Esc boots into the text console
proc boot_keys() {
    while (len(kb_queue) > 0) {
        if (kb_queue[1] == "escape") { skip_boot = 1; }
        del(kb_queue, 1);
    }
}

// --- the boot screen: logo + progress bar --------------------------------------------

const BOOT_BAR_W = 240;

// filled triangle (screen px), one 1-pixel span per row
proc boot_tri(x1, y1, x2, y2, x3, y3, c) {
    local y0 = floor(min3(y1, y2, y3));
    local yb = ceil(max3(y1, y2, y3));
    for y = y0 to yb {
        local sy = y + 0.5;
        tri_edge(x1, y1, x2, y2, sy);
        tri_edge(x2, y2, x3, y3, sy);
        tri_edge(x3, y3, x1, y1, sy);
        if (te_max >= te_min) { gfx_fill(round(te_min), y, round(te_max) - round(te_min) + 1, 1, c); }
        te_min = 99999;
        te_max = -99999;
    }
}

var te_min = 99999;
var te_max = -99999;

proc tri_edge(xa, ya, xb, yb, sy) {
    if ((ya <= sy && yb > sy) || (yb <= sy && ya > sy)) {
        local x = xa + (sy - ya) * (xb - xa) / (yb - ya);
        if (x < te_min) { te_min = x; }
        if (x > te_max) { te_max = x; }
    }
}

proc min3(a, b, c) {
    local m = a;
    if (b < m) { m = b; }
    if (c < m) { m = c; }
    return m;
}

proc max3(a, b, c) {
    local m = a;
    if (b > m) { m = b; }
    if (c > m) { m = c; }
    return m;
}

// the ScratchOS logo, a cat's head, centred at (cx, cy) with radius r
proc boot_logo(cx, cy, r, c, eye) {
    gfx_line(cx, cy, cx, cy, c, r * 2);
    boot_tri(cx - r * 0.92, cy - r * 0.38, cx - r * 0.78, cy - r * 1.55, cx - r * 0.12, cy - r * 0.9, c);
    boot_tri(cx + r * 0.92, cy - r * 0.38, cx + r * 0.78, cy - r * 1.55, cx + r * 0.12, cy - r * 0.9, c);
    gfx_line(cx - r * 0.38, cy - r * 0.08, cx - r * 0.38, cy - r * 0.08, eye, r * 0.26);
    gfx_line(cx + r * 0.38, cy - r * 0.08, cx + r * 0.38, cy - r * 0.08, eye, r * 0.26);
}

var boot_frac = 0;

// advance the progress bar to `f` (0..1)
proc boot_progress(f) nowarp {
    boot_keys();
    if (skip_boot == 1) { return; }
    local x0 = SCR_W / 2 - BOOT_BAR_W / 2;
    local y = SCR_H / 2 + 110;
    local from = boot_frac;
    // a short animated fill
    repeat (6) {
        boot_frac += (f - from) / 6;
        gfx_line(x0, y, x0 + BOOT_BAR_W * boot_frac, y, U_ICWHITE, 6);
        wait(0.016);
    }
    boot_frac = f;
}

proc boot_screen() {
    gfx_fill(0, 0, SCR_W, SCR_H, U_PTROUT);
    boot_logo(SCR_W / 2, SCR_H / 2 - 20, 58, U_ICWHITE, U_PTROUT);
    local x0 = SCR_W / 2 - BOOT_BAR_W / 2;
    local y = SCR_H / 2 + 110;
    gfx_line(x0, y, x0 + BOOT_BAR_W, y, U_TLOFF, 6);
    boot_frac = 0;
}

proc boot_seq() nowarp {
    skip_boot = 0;
    boot_t0 = now_secs();
    boot_screen();
    wait_until(kb_ready == 1);
    boot_progress(0.08);
    // ---- kernel start-up (logged to the console) ---------------------------------
    tty_write(con, "\e[2J\e[H");
    klog(OS_NAME .. " " .. OS_VERSION .. " (" .. KERNEL_NAME .. ") #1 PREEMPT");
    klog("cmdline: root=/dev/sb3 console=tty1");
    klog("pen fb: " .. SCR_W .. "x" .. SCR_H .. " px, " .. SCR_COLS .. "x" .. SCR_ROWS .. " cells, JetBrains Mono");
    klog("memory: 200000 cells per list, heap ready");
    fs_init();
    fs_load_rootfs();
    boot_progress(0.3);
    kok("Mounted root file system (" .. fs_count .. " inodes, " .. floor(fs_total_bytes() / 1024) .. " KiB)");
    kok("Started keyboard service (" .. len(kb_names) .. " clone listeners)");
    proc_init();
    shell_init();
    vm_init();
    boot_progress(0.5);
    kok("Started process scheduler (preemptive, " .. MAX_PROC .. " slots)");
    kok("Started Whisker virtual machine");
    caps_init();
    kok("Loaded capability policy (/etc/caps)");
    wm_init();
    boot_progress(0.75);
    kok("Started window manager");
    kok("Reached target Multi-User System");
    uptime0 = now_secs();
    // ---- init ----------------------------------------------------------------------
    local s = proc_alloc("init", PK_INIT, 0);
    p_tty[s] = con;
    p_in_k[s] = FD_TTY; p_in_i[s] = con;
    p_out_k[s] = FD_TTY; p_out_i[s] = con;
    p_err_k[s] = FD_TTY; p_err_i[s] = con;
    p_caps[s] = "|files|proc|gui|system|";
    init_state = 0;
    boot_progress(1);
    boot_keys();
    if (skip_boot == 1) {
        // Esc during boot: the text console
        tty_write(con, "\n\e[97mText console\e[0m - type \e[93mstartx\e[0m to start the desktop.\n\n");
        tty_vis[con] = 1;
        tty_full[con] = 1;
        gfx_fill(0, 0, SCR_W, SCR_H, 0);
        return;
    }
    wait(0.25);
    wm_start(0);
}

list kb_names = data("kb_keys");

var init_state = 0;
var init_child = 0;

// pid 1: run /etc/rc, then keep an interactive shell alive on the console
proc init_step(s) {
    if (init_state == 0) {
        local rc = fs_lookup("/etc/rc", 1);
        if (rc > 0) {
            local c = shell_spawn(s, fs_data[rc] .. "\n", "/etc/rc");
            sh_inter[c] = 0;
            p_pgid[c] = p_pid[c];
            init_child = p_pid[c];
            tty_fgpid[con] = p_pid[c];
            init_state = 1;
        } else {
            init_state = 2;
        }
        return;
    }
    if (init_state == 1) {
        if (proc_slot(init_child) > 0) { proc_block(s, BLK_IO); return; }
        init_state = 2;
    }
    if (init_state == 2) {
        local c = shell_spawn(s, "", "-sh");
        p_pgid[c] = p_pid[c];
        init_child = p_pid[c];
        tty_fgpid[con] = p_pid[c];
        p_cwd[c] = fs_lookup("/home/user", 1);
        if (p_cwd[c] == 0) { p_cwd[c] = 1; }
        init_state = 3;
        return;
    }
    if (init_state == 3) {
        if (proc_slot(init_child) > 0) { proc_block(s, BLK_IO); return; }
        tty_write(con, "\n\e[93m" .. OS_NAME .. " " .. OS_VERSION .. " tty1\e[0m - shell exited, respawning\n\n");
        init_state = 2;
    }
}

// --- power management ---------------------------------------------------------------

proc sys_power(mode) {
    power_req = mode;
}

proc power_off() nowarp {
    local reboot = power_req;
    power_req = -1;
    wm_stop_all();
    tty_write(con, "\n");
    for s = 1 to MAX_PROC {
        if (p_state[s] != PS_FREE && p_kind[s] != PK_INIT) {
            klog("Stopping " .. p_name[s] .. " (pid " .. p_pid[s] .. ")");
            proc_exit(s, 143);
            tty_render();
            wait(0.02);
        }
    }
    kok("Unmounted root file system");
    kok("Reached target Shutdown");
    tty_render();
    wait(0.4);
    for s = 1 to MAX_PROC { if (p_state[s] != PS_FREE) { proc_exit(s, 0); } }
    if (reboot == 1) {
        klog("Rebooting.");
        tty_render();
        wait(0.6);
        kernel_boot();
        return;
    }
    tty_vis[con] = 0;
    gfx_fill(0, 0, SCR_W, SCR_H, U_PTROUT);
    local msg = "It is now safe to close this browser tab.";
    for i = 1 to len(msg) { gfx_glyph(SCR_W / 2 - len(msg) * 4 + (i - 1) * 8, SCR_H / 2 - 8, ord(msg[i]), U_TLOFF); }
    local msg2 = "Click the green flag to start " .. OS_NAME .. " again.";
    for i = 1 to len(msg2) { gfx_glyph(SCR_W / 2 - len(msg2) * 4 + (i - 1) * 8, SCR_H / 2 + 16, ord(msg2[i]), U_TLOFF); }
    halted = 1;
}
