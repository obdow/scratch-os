// ===========================================================================
// gfx.sbs - pen graphics primitives (included inside sprite Kernel)
//
// Shared by ScratchOS and the Whisker IDE.  Colours are palette indices
// (arbitrary RGB, see tools/ui_assets.py for the index map), each drawn from
// one of several base costume sets (JetBrains Mono glyphs + solid rects)
// with the colour and brightness effects.  0..15 are the terminal colours.
// ===========================================================================

// the stage size is set by build.py (SCR_W x SCR_H pixels, SCR_COLS x SCR_ROWS cells)
const SCREEN_W = SCR_W;
const SCREEN_H = SCR_H;
const HALF_W = SCR_W / 2;
const HALF_H = SCR_H / 2;
const CELL_W = 8;
const CELL_H = 16;
const COLS = SCR_COLS;
const ROWS = SCR_ROWS;

list pal_gb = data("ui_pal_gb");     // costume number of glyph 0 in the entry's base set
list pal_rb = data("ui_pal_rb");     // costume number of the 1x1 rect in the entry's base set
list pal_hue = data("ui_pal_hue");
list pal_bri = data("ui_pal_bri");
list pal_rgb = data("ui_pal_rgb");   // RGB integer (pen lines)
list gmap = data("ui_gmap");         // code+1 -> glyph slot in a set ('?' if not included)

var gfx_col = -1;        // colour currently applied via effects
var gfx_gbase = 1;       // costume number of glyph 0 in the current base set
var gfx_rbase = 513;     // costume number of rect 1x1 in the current base set
var gfx_pen_col = -1;
var gfx_pen_size = -1;
var gfx_stamps = 0;      // drawing activity counter (mouse pointer repair)

// clip rectangle for line drawing (screen coords, inclusive-exclusive)
var clip_x0 = 0;
var clip_y0 = 0;
var clip_x1 = SCR_W;
var clip_y1 = SCR_H;

proc gfx_init() {
    pen_clear();
    pen_up();
    clear_effects();
    gfx_col = -1;
    gfx_pen_col = -1;
    gfx_pen_size = -1;
    size(100);
    // a hair off 90 degrees: at exactly 100% and 90 degrees Scratch samples
    // raster costumes with nearest-neighbour filtering, which would decimate
    // the 2x anti-aliased glyphs when the pen renders at 1x; with linear
    // filtering a 1x stamp averages each 2x2 block exactly
    point(90.001);
    hide();
}

// Apply palette colour c to this sprite's effects (cached).
proc gfx_color(c) {
    if (c == gfx_col) { return; }
    gfx_col = c;
    gfx_gbase = pal_gb[c + 1];
    gfx_rbase = pal_rb[c + 1];
    effect("color", pal_hue[c + 1]);
    effect("brightness", pal_bri[c + 1]);
}

// switch the 16 terminal / graphics colours to a theme's set (0 dark, 1 light)
proc gfx_ansi_theme(n) {
    local src = ANSI_SRC + n * 16;
    for i = 1 to 16 {
        pal_gb[i] = pal_gb[src + i];
        pal_rb[i] = pal_rb[src + i];
        pal_hue[i] = pal_hue[src + i];
        pal_bri[i] = pal_bri[src + i];
        pal_rgb[i] = pal_rgb[src + i];
    }
    gfx_col = -1;
    gfx_pen_col = -1;
}

// Stamp glyph `code` (0..255; codes without a glyph show '?') with its top-left at screen pixel (x, y).
proc gfx_glyph(x, y, code, c) {
    gfx_color(c);
    goto(x - HALF_W, HALF_H - y);
    costume(gfx_gbase + gmap[code + 1]);
    stamp();
    gfx_stamps += 1;
}

// Stamp glyph `code` at twice the size (16x32 px, the costume's native
// resolution) with its top-left at screen pixel (x, y).
proc gfx_glyph2(x, y, code, c) {
    gfx_color(c);
    goto(x - HALF_W, HALF_H - y);
    costume(gfx_gbase + gmap[code + 1]);
    size(200);
    stamp();
    size(100);
    gfx_stamps += 1;
}

// Fill rectangle with palette colour c.  Uses power-of-two rect costumes,
// so any rectangle up to 256x256 takes at most 4 stamps.
proc gfx_fill(x, y, w, h, c) {
    if (w < 1 || h < 1) { return; }
    gfx_color(c);
    local sw = 1;
    local i = 0;
    while (sw * 2 <= w && i < 8) { sw = sw * 2; i += 1; }
    local sh = 1;
    local j = 0;
    while (sh * 2 <= h && j < 8) { sh = sh * 2; j += 1; }
    costume(gfx_rbase + i * 9 + j);
    gfx_stamps += 1;
    local ty = y;
    forever {
        if (ty + sh > y + h) { ty = y + h - sh; }
        local tx = x;
        forever {
            if (tx + sw > x + w) { tx = x + w - sw; }
            goto(tx - HALF_W, HALF_H - ty);
            stamp();
            if (tx + sw >= x + w) { break; }
            tx += sw;
        }
        if (ty + sh >= y + h) { break; }
        ty += sh;
    }
}

// Draw a text cell: background + glyph.  col,row in character cells.
proc gfx_cell(col, row, code, fg, bg) {
    gfx_fill(col * 8, row * 16, 8, 16, bg);
    if (code != 32 && code != 0 && fg != bg) {
        gfx_glyph(col * 8, row * 16, code, fg);
    }
}

// Fill a rectangle with an exact RGB colour (0..16777215) using pen strokes:
// one 1-pixel stroke per row (or column, whichever is fewer).  Pen strokes
// take any colour, which costume stamps (palette + effects) cannot.
proc gfx_rgb_fill(x, y, w, h, rgb) {
    if (w < 1 || h < 1) { return; }
    pen_color(rgb);
    gfx_pen_col = -2;
    if (gfx_pen_size != 1) { gfx_pen_size = 1; pen_size(1); }
    if (w >= h) {
        local xa = x - HALF_W;
        local xb = x + w - 1 - HALF_W;
        for r = 0 to h - 1 {
            local py = HALF_H - (y + r);
            goto(xa, py);
            pen_down();
            goto(xb, py);
            pen_up();
        }
    } else {
        local ya = HALF_H - y;
        local yb = HALF_H - (y + h - 1);
        for c = 0 to w - 1 {
            local px = x + c - HALF_W;
            goto(px, ya);
            pen_down();
            goto(px, yb);
            pen_up();
        }
    }
    gfx_stamps += 1;
}

// palette index whose colour is nearest to an RGB value (for text, which is
// stamped from costumes)
proc gfx_nearest(rgb) {
    local r = floor(rgb / 65536);
    local g = floor(rgb / 256) % 256;
    local b = rgb % 256;
    local best = 0;
    local bd = 999999;
    for i = 1 to len(pal_rgb) {
        local p = pal_rgb[i];
        local dr = floor(p / 65536) - r;
        local dg = floor(p / 256) % 256 - g;
        local db = p % 256 - b;
        local d = dr * dr * 3 + dg * dg * 4 + db * db * 2;
        if (d < bd) { bd = d; best = i - 1; }
    }
    return best;
}

// Pen line in screen coordinates with a palette colour, or a true colour
// (256 + RGB), and a size.
proc gfx_line(x1, y1, x2, y2, c, sz) {
    if (c != gfx_pen_col) {
        gfx_pen_col = c;
        if (c >= 256) { pen_color(c - 256); } else { pen_color(pal_rgb[c + 1]); }
    }
    if (sz != gfx_pen_size) {
        gfx_pen_size = sz;
        pen_size(sz);
    }
    goto(x1 - HALF_W + 0.5, HALF_H - 0.5 - y1);
    pen_down();
    goto(x2 - HALF_W + 0.5, HALF_H - 0.5 - y2);
    pen_up();
    gfx_stamps += 1;
}
