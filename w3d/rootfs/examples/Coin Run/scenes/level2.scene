-- Level 2: the same, higher up.  Fall off and you start again.
scene "Level 2"
sky #2c3e7a #e9a46b
ambient 0.4
sun 0.6 -0.6 0.5 0.7
fog 25 60 #e9a46b
gravity -24

object "Start" mesh
  mesh cube
  pos 0 -0.5 0
  scale 6 1 6
  color #8d6e63
  body static
  collider box

object "Player" mesh
  mesh capsule
  pos 0 1 0
  scale 1 1.6 1
  color #ff8a3d
  tag player
  script scripts/player.wsk
  body dynamic
  collider box

object "Stone 1" mesh
  mesh cylinder
  pos 0 -0.5 6
  scale 3 1 3
  color #9e9e9e
  body static
  collider box

object "Stone 2" mesh
  mesh cylinder
  pos 3 0 10
  scale 3 1 3
  color #9e9e9e
  body static
  collider box

object "Stone 3" mesh
  mesh cylinder
  pos 0 0.5 14
  scale 3 1 3
  color #9e9e9e
  body static
  collider box

object "Coin" mesh
  mesh cylinder
  pos 3 1.4 10
  rot 90 0 0
  scale 0.7 0.12 0.7
  color #ffd54f
  unlit
  tag coin
  script scripts/coin.wsk
  collider box
  trigger

object "Goal" mesh
  mesh cylinder
  pos 0 1.1 14
  scale 2 0.2 2
  color #66bb6a
  unlit
  tag goal
  script scripts/goal.wsk
  collider box
  trigger

object "Game" empty
  script scripts/hud.wsk

object "Camera" camera
  pos 0 5 -9
  rot 20 0 0
  fov 60
  script scripts/camera.wsk
