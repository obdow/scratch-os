-- Level 1: collect the coins, then reach the green goal.
scene "Level 1"
sky #4f7fe0 #cfe5ff
ambient 0.35
sun -0.5 -1 0.4 0.8
fog 30 70 #cfe5ff
gravity -24

object "Ground" mesh
  mesh plane
  scale 16 1 40
  pos 0 0 14
  color #5aa864
  body static
  collider box

object "Player" mesh
  mesh capsule
  pos 0 1 0
  scale 1 1.6 1
  color #ff8a3d
  tag player
  script scripts/player.wsk
  body dynamic
  collider box

object "Step 1" mesh
  mesh cube
  pos 3 0.5 8
  scale 3 1 3
  color #a1887f
  body static
  collider box

object "Step 2" mesh
  mesh cube
  pos 0 1.5 12
  scale 3 1 3
  color #a1887f
  body static
  collider box

object "Lift" mesh
  mesh cube
  pos -4 1 17
  scale 3 0.5 3
  color #4fc3f7
  tag lift
  script scripts/lift.wsk
  body kinematic
  collider box

object "High ledge" mesh
  mesh cube
  pos -4 4 23
  scale 4 1 5
  color #a1887f
  body static
  collider box

object "Coin" mesh
  mesh cylinder
  pos 3 1.8 8
  rot 90 0 0
  scale 0.7 0.12 0.7
  color #ffd54f
  unlit
  tag coin
  script scripts/coin.wsk
  collider box
  trigger

object "Coin 2" mesh
  mesh cylinder
  pos 0 2.8 12
  rot 90 0 0
  scale 0.7 0.12 0.7
  color #ffd54f
  unlit
  tag coin
  script scripts/coin.wsk
  collider box
  trigger

object "Coin 3" mesh
  mesh cylinder
  pos -4 5.3 23
  rot 90 0 0
  scale 0.7 0.12 0.7
  color #ffd54f
  unlit
  tag coin
  script scripts/coin.wsk
  collider box
  trigger

object "Goal" mesh
  mesh cylinder
  pos 4 0.1 28
  scale 2 0.2 2
  color #66bb6a
  unlit
  tag goal
  script scripts/goal.wsk
  collider box
  trigger

object "Game" empty
  script scripts/hud.wsk

object "Camera" camera
  pos 0 5 -9
  rot 20 0 0
  fov 60
  script scripts/camera.wsk
